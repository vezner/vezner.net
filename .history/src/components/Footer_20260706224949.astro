---
import Logo from "./Logo.astro";
const añoActual = new Date().getFullYear();

const redes = [
  {
    icon: "fa-brands fa-x-twitter",
    nombre: "X",
    url: "https://twitter.com/veznerarg",
    color: "#FFFFFF",
  },
  {
    icon: "fa-brands fa-github",
    nombre: "GitHub",
    url: "https://github.com/vezner",
    color: "#00c851",
  },
  {
    icon: "fa-brands fa-youtube",
    nombre: "YouTube",
    url: "https://youtube.com/@veznerarg",
    color: "#ff3c00",
  },
];
---

<footer id="mega-footer" class="relative bg-negro text-blanco overflow-hidden">
  <div class="w-full h-px bg-blanco/8"></div>

  <div class="px-8 md:px-16 pt-16 pb-10">
    <div
      class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-[1.5fr_1fr_1fr_1fr_2.5fr] gap-12 pb-12 border-b border-blanco/8"
    >
      <div
        class="flex flex-col items-center md:items-start text-center md:text-left space-y-4"
      >
        <a
          href="/"
          class="flex items-center group invert opacity-90 hover:opacity-100 transition-all duration-500"
        >
          <Logo />
        </a>
        <p class="font-mono text-xs text-blanco/35 leading-relaxed max-w-xs">
          Ingeniería digital de alta gama.<br />
          Córdoba, Argentina — desde 2024.
        </p>
        <a
          href="mailto:hola@vezner.net"
          class="footer-link font-mono text-xs text-blanco/50 hover:text-blanco transition-colors duration-300"
        >
          hola@vezner.net →
        </a>

        <div class="flex flex-wrap justify-center md:justify-start gap-3 mt-6">
          {
            redes.map((r) => (
              <a
                href={r.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={r.nombre}
                class="social-icon-btn group w-9 h-9 border border-blanco/15 flex items-center justify-center transition-all duration-300 hover:scale-110"
                style={`--hover-color: ${r.color}`}
                title={r.nombre}
              >
                <i
                  class={`${r.icon} text-sm text-blanco/40 group-hover:text-blanco transition-colors duration-300`}
                />
              </a>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col text-center md:text-left">
        <p
          class="font-mono text-xs text-blanco/30 uppercase tracking-widest mb-4"
        >
          Sitio
        </p>
        <div class="flex flex-col gap-3">
          <a
            href="/"
            class="font-mono text-xs text-blanco/60 hover:text-blanco transition-colors"
            >Inicio</a
          >
          <a
            href="/#servicios"
            class="font-mono text-xs text-blanco/60 hover:text-blanco transition-colors"
            >Servicios</a
          >
          <a
            href="/contacto"
            class="font-mono text-xs text-blanco/60 hover:text-blanco transition-colors"
            >Contacto</a
          >
        </div>
      </div>

      <div class="flex flex-col text-center md:text-left">
        <p
          class="font-mono text-xs text-blanco/30 uppercase tracking-widest mb-4"
        >
          Servicios
        </p>
        <div class="flex flex-col gap-3">
          <a
            href="/servicios/diseno-web"
            class="font-mono text-xs text-blanco/60 hover:text-blanco transition-colors"
            >Diseño Web</a
          >
          <a
            href="/servicios/software-python"
            class="font-mono text-xs text-blanco/60 hover:text-blanco transition-colors"
            >Software</a
          >
          <a
            href="/servicios/community-management"
            class="font-mono text-xs text-blanco/60 hover:text-blanco transition-colors"
            >CM</a
          >
          <a
            href="/servicios/diseno-identidad"
            class="font-mono text-xs text-blanco/60 hover:text-blanco transition-colors"
            >Branding</a
          >
        </div>
      </div>

      <div class="flex flex-col text-center md:text-left">
        <p
          class="font-mono text-xs text-blanco/30 uppercase tracking-widest mb-4"
        >
          Legal
        </p>
        <div class="flex flex-col gap-3">
          <a
            href="/legal/politica-de-privacidad"
            class="font-mono text-xs text-blanco/60 hover:text-blanco transition-colors"
            >Privacidad</a
          >
          <a
            href="/legal/terminos-y-condiciones"
            class="font-mono text-xs text-blanco/60 hover:text-blanco transition-colors"
            >Términos</a
          >
          <a
            href="/legal/politica-de-cookies"
            class="font-mono text-xs text-blanco/60 hover:text-blanco transition-colors"
            >Cookies</a
          >
        </div>
      </div>
    </div>

    <div
      class="pt-8 flex flex-col md:flex-row items-center justify-between gap-3"
    >
      <p class="font-mono text-xs text-blanco/20">
        © 2024–{añoActual} VEZNER · Todos los derechos reservados
      </p>
      <p class="font-mono text-xs text-blanco/15">vezner.net</p>
    </div>
  </div>
</footer>

<style>
  .footer-col {
    opacity: 0;
    transform: translateY(24px);
  }

  .footer-link {
    text-decoration: none;
    position: relative;
    display: inline-block;
    transition: color 0.25s ease;
  }

  .footer-link::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width 0.3s ease;
  }

  .footer-link:hover::after {
    width: 100%;
  }

  .social-icon-btn {
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      background 0.3s ease;
  }

  .social-icon-btn:hover {
    border-color: var(--hover-color);
    background: color-mix(in srgb, var(--hover-color) 10%, transparent);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { DotLottie } from "@lottiefiles/dotlottie-web";

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray<HTMLElement>(".footer-col").forEach((col, i) => {
    gsap.fromTo(
      col,
      { opacity: 0, y: 24 },
      {
        opacity: 1,
        y: 0,
        duration: 0.7,
        delay: i * 0.1,
        ease: "power3.out",
        scrollTrigger: { trigger: col, start: "top 95%", once: true },
      },
    );
  });

  const footerCanvas = document.getElementById(
    "footer-logo-canvas",
  ) as HTMLCanvasElement;
  if (footerCanvas) {
    const footerLottie = new DotLottie({
      canvas: footerCanvas,
      src: "/assets/logo.lottie",
      loop: true,
      autoplay: false,
      speed: 0.8,
    });

    footerLottie.addEventListener("ready", () => {
      footerLottie.setFrame(0);
      footerLottie.pause();
    });

    const footerLogo = footerCanvas.parentElement;
    let stop = false;

    footerLottie.addEventListener("loop", () => {
      if (stop) {
        stop = false;
        footerLottie.setFrame(0);
        footerLottie.pause();
      }
    });

    footerLogo?.addEventListener("mouseenter", () => {
      stop = false;
      footerLottie.play();
    });
    footerLogo?.addEventListener("mouseleave", () => {
      stop = true;
    });
  }
</script>
