---
import { getCollection } from "astro:content";
import Logo from "./Logo.astro";

// Evitar romper si la colección no existe aún
let latestPosts: any[] = [];
try {
  const allPosts = await getCollection("blog");
  if (allPosts) {
    latestPosts = allPosts
      .sort(
        (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
      )
      .slice(0, 3);
  }
} catch (e) {
  // Colección vacía o no creada
}

export interface Props {
  theme?: "light" | "dark";
}

const { theme = "light" } = Astro.props;
---

<header
  id="header"
  class={`fixed top-0 left-0 right-0 z-50 ${theme === "dark" ? "theme-dark" : "theme-light"}`}
>
  <nav class="flex items-center justify-between px-6 md:px-12 h-20 py-0">
    <a
      href="/"
      class="group flex items-center h-full logo-container transition-colors duration-300"
      aria-label="Ir a inicio"
    >
      <Logo />
    </a>

    <ul
      class="hidden lg:flex items-stretch gap-8 list-none m-0 p-0 h-full relative"
      id="desktop-nav-list"
    >
      <li class="h-full desktop-nav-item" data-dropdown="inicio">
        <a
          href="/"
          class="flex items-center h-full px-2 group/navlink font-mono text-xs tracking-widest uppercase"
        >
          <span class="nav-link block">
            <span class="nav-link-text">Inicio</span>
            <span class="nav-link-clone" aria-hidden="true">Inicio</span>
          </span>
        </a>
      </li>

      <li class="h-full desktop-nav-item" data-dropdown="servicios">
        <a
          href="/#servicios"
          class="flex items-center h-full px-2 group/navlink font-mono text-xs tracking-widest uppercase"
        >
          <span class="nav-link block">
            <span class="nav-link-text">Servicios</span>
            <span class="nav-link-clone" aria-hidden="true">Servicios</span>
          </span>
        </a>
      </li>

      <li class="h-full desktop-nav-item" data-dropdown="nosotros">
        <a
          href="/nosotros"
          class="flex items-center h-full px-2 group/navlink font-mono text-xs tracking-widest uppercase"
        >
          <span class="nav-link block">
            <span class="nav-link-text">Nosotros</span>
            <span class="nav-link-clone" aria-hidden="true">Nosotros</span>
          </span>
        </a>
      </li>

      <li class="h-full desktop-nav-item" data-dropdown="blog">
        <a
          href="/blog"
          class="flex items-center h-full px-2 group/navlink font-mono text-xs tracking-widest uppercase"
        >
          <span class="nav-link block">
            <span class="nav-link-text">Blog</span>
            <span class="nav-link-clone" aria-hidden="true">Blog</span>
          </span>
        </a>
      </li>

      <li class="h-full desktop-nav-item" data-dropdown="contacto">
        <a
          href="/contacto"
          class="flex items-center h-full px-2 group/navlink font-mono text-xs tracking-widest uppercase"
        >
          <span class="nav-link block">
            <span class="nav-link-text">Contacto</span>
            <span class="nav-link-clone" aria-hidden="true">Contacto</span>
          </span>
        </a>
      </li>

      <!-- Morphing Background -->
      <div
        id="morphing-dropdown"
        class="dropdown-theme-sync absolute top-[calc(100%-10px)] left-0 opacity-0 pointer-events-none transition-colors duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] shadow-2xl rounded-2xl border backdrop-blur-2xl overflow-hidden z-50 origin-top-left"
        style="will-change: width, height, transform, opacity;"
      >
        <div id="morphing-content" class="relative w-full h-full">
          <!-- Panel Inicio -->
          <div
            class="morph-panel absolute top-0 left-0 opacity-0 pointer-events-none"
            data-panel="inicio"
          >
            <div class="p-8 w-[350px]">
              <p
                class="font-mono text-[10px] tracking-widest uppercase opacity-40 mb-4"
              >
                Secciones
              </p>
              <div class="flex flex-col gap-1">
                <a
                  href="/#manifiesto"
                  class="mega-link flex items-center gap-4 hover:opacity-70 hover:translate-x-1.5 transition-colors duration-300 py-2"
                >
                  <span class="font-mono text-xs opacity-50">01</span>
                  <span class="font-display text-xl">Manifiesto</span>
                </a>
                <a
                  href="/#servicios"
                  class="mega-link flex items-center gap-4 hover:opacity-70 hover:translate-x-1.5 transition-colors duration-300 py-2"
                >
                  <span class="font-mono text-xs opacity-50">02</span>
                  <span class="font-display text-xl">Servicios</span>
                </a>
                <a
                  href="/#proceso"
                  class="mega-link flex items-center gap-4 hover:opacity-70 hover:translate-x-1.5 transition-colors duration-300 py-2"
                >
                  <span class="font-mono text-xs opacity-50">03</span>
                  <span class="font-display text-xl">Proceso</span>
                </a>
                <a
                  href="/#noticias"
                  class="mega-link flex items-center gap-4 hover:opacity-70 hover:translate-x-1.5 transition-colors duration-300 py-2"
                >
                  <span class="font-mono text-xs opacity-50">04</span>
                  <span class="font-display text-xl">Noticias</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Panel Servicios -->
          <div
            class="morph-panel absolute top-0 left-0 opacity-0 pointer-events-none"
            data-panel="servicios"
          >
            <div class="p-10 w-[650px]">
              <div class="grid grid-cols-3 gap-8">
                <div>
                  <a
                    href="/servicios/diseno-web"
                    class="font-display text-2xl mb-4 block hover:opacity-70 hover:translate-x-1.5 transition-colors duration-300"
                    >Diseño Web</a
                  >
                  <div class="flex flex-col font-mono text-xs opacity-70">
                    <a
                      href="/servicios/diseno-web#hero"
                      class="py-2 hover:text-current hover:opacity-100 hover:translate-x-1.5 transition-colors duration-300 block"
                      >Landing Pages</a
                    >
                    <a
                      href="/servicios/diseno-web#estandar"
                      class="py-2 hover:text-current hover:opacity-100 hover:translate-x-1.5 transition-colors duration-300 block"
                      >Estándar VEZNER</a
                    >
                    <a
                      href="/servicios/diseno-web#enfoque"
                      class="py-2 hover:text-current hover:opacity-100 hover:translate-x-1.5 transition-colors duration-300 block"
                      >Nuestro Enfoque</a
                    >
                    <a
                      href="/servicios/diseno-web#cta"
                      class="py-2 hover:text-current hover:opacity-100 hover:translate-x-1.5 transition-colors duration-300 block"
                      >Agendar Llamada</a
                    >
                  </div>
                </div>
                <div>
                  <a
                    href="/servicios/software-python"
                    class="font-display text-2xl mb-4 block hover:opacity-70 hover:translate-x-1.5 transition-colors duration-300"
                    >Software</a
                  >
                  <div class="flex flex-col font-mono text-xs opacity-70">
                    <a
                      href="/servicios/software-python#soluciones"
                      class="py-2 hover:text-current hover:opacity-100 hover:translate-x-1.5 transition-colors duration-300 block"
                      >Casos de Uso</a
                    >
                    <a
                      href="/servicios/software-python#calidad"
                      class="py-2 hover:text-current hover:opacity-100 hover:translate-x-1.5 transition-colors duration-300 block"
                      >Código de Calidad</a
                    >
                    <a
                      href="/servicios/software-python#stack"
                      class="py-2 hover:text-current hover:opacity-100 hover:translate-x-1.5 transition-colors duration-300 block"
                      >Nuestro Stack</a
                    >
                    <a
                      href="/servicios/software-python#cta"
                      class="py-2 hover:text-current hover:opacity-100 hover:translate-x-1.5 transition-colors duration-300 block"
                      >Consultar Proyecto</a
                    >
                  </div>
                </div>
                <div>
                  <a
                    href="/servicios/diseno-identidad"
                    class="font-display text-2xl mb-4 block hover:opacity-70 hover:translate-x-1.5 transition-colors duration-300"
                    >Branding</a
                  >
                  <div class="flex flex-col font-mono text-xs opacity-70">
                    <a
                      href="/servicios/diseno-identidad#hero"
                      class="py-2 hover:text-current hover:opacity-100 hover:translate-x-1.5 transition-colors duration-300 block"
                      >Logotipos</a
                    >
                    <a
                      href="/servicios/diseno-identidad#galeria"
                      class="py-2 hover:text-current hover:opacity-100 hover:translate-x-1.5 transition-colors duration-300 block"
                      >Identidad Visual</a
                    >
                    <a
                      href="/servicios/diseno-identidad#entregables"
                      class="py-2 hover:text-current hover:opacity-100 hover:translate-x-1.5 transition-colors duration-300 block"
                      >Entregables</a
                    >
                    <a
                      href="/servicios/diseno-identidad#cta"
                      class="py-2 hover:text-current hover:opacity-100 hover:translate-x-1.5 transition-colors duration-300 block"
                      >Cotizar Marca</a
                    >
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Panel Nosotros -->
          <div
            class="morph-panel absolute top-0 left-0 opacity-0 pointer-events-none"
            data-panel="nosotros"
          >
            <div class="p-8 w-[250px]">
              <div class="flex flex-col gap-1">
                <a
                  href="/nosotros#agencia"
                  class="mega-link block hover:opacity-70 hover:translate-x-1.5 transition-colors duration-300 py-2"
                >
                  <span class="font-display text-2xl block mb-1"
                    >La Agencia</span
                  >
                  <span
                    class="font-mono text-[10px] opacity-50 block uppercase tracking-wider"
                    >Nuestra Esencia</span
                  >
                </a>
                <a
                  href="/nosotros#manifiesto"
                  class="mega-link block hover:opacity-70 hover:translate-x-1.5 transition-colors duration-300 py-2"
                >
                  <span class="font-display text-2xl block mb-1"
                    >Manifiesto</span
                  >
                  <span
                    class="font-mono text-[10px] opacity-50 block uppercase tracking-wider"
                    >Nuestra Verdad</span
                  >
                </a>
                <a
                  href="/nosotros#pilares"
                  class="mega-link block hover:opacity-70 hover:translate-x-1.5 transition-colors duration-300 py-2"
                >
                  <span class="font-display text-2xl block mb-1"
                    >Los 3 Pilares</span
                  >
                  <span
                    class="font-mono text-[10px] opacity-50 block uppercase tracking-wider"
                    >Nuestro Enfoque</span
                  >
                </a>
              </div>
            </div>
          </div>

          <!-- Panel Blog -->
          <div
            class="morph-panel absolute top-0 left-0 opacity-0 pointer-events-none"
            data-panel="blog"
          >
            <div class="p-8 w-[400px]">
              <p
                class="font-mono text-[10px] tracking-widest uppercase opacity-40 mb-4"
              >
                Últimos Artículos
              </p>
              <div class="flex flex-col gap-1">
                {
                  latestPosts.length > 0 ? (
                    latestPosts.map((post: any) => (
                      <a
                        href={`/blog/${post.id}`}
                        class="mega-link block hover:opacity-70 hover:translate-x-1.5 transition-colors duration-300 py-2 border-b border-current/10 last:border-0"
                      >
                        <span
                          class="font-display text-xl block mb-1 truncate"
                          title={post.data.title}
                        >
                          {post.data.title}
                        </span>
                        <span class="font-mono text-[10px] opacity-50 block tracking-wider">
                          {post.data.pubDate.toLocaleDateString("es-AR", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                          })}
                        </span>
                      </a>
                    ))
                  ) : (
                    <p class="font-mono text-xs opacity-50 italic py-2">
                      Próximamente...
                    </p>
                  )
                }

                <a
                  href="/blog"
                  class="mt-4 pt-4 border-t border-current/20 font-mono text-[10px] uppercase tracking-widest hover:opacity-70 hover:translate-x-1 transition-colors flex items-center gap-2"
                >
                  Ver Todos los Artículos <span class="text-xs">→</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Panel Contacto -->
          <div
            class="morph-panel absolute top-0 left-0 opacity-0 pointer-events-none"
            data-panel="contacto"
          >
            <div class="p-8 w-[350px]">
              <p
                class="font-mono text-[10px] tracking-widest uppercase opacity-40 mb-4"
              >
                Contactar
              </p>
              <div class="flex flex-col gap-1">
                <a
                  href="/contacto"
                  class="mega-link flex items-center gap-4 hover:opacity-70 hover:translate-x-1.5 transition-colors duration-300 py-3"
                >
                  <span class="font-display text-xl flex-1"
                    >Formulario Directo</span
                  >
                  <span
                    class="font-mono text-[10px] opacity-50 uppercase tracking-wider border border-current/20 px-2 py-1 rounded-sm"
                    >24hs</span
                  >
                </a>
                <a
                  href="mailto:hola@vezner.net"
                  class="mega-link flex items-center gap-4 hover:opacity-70 hover:translate-x-1.5 transition-colors duration-300 py-3"
                >
                  <span class="font-display text-xl flex-1">Email Directo</span>
                  <span
                    class="font-mono text-[10px] opacity-50 uppercase tracking-wider border border-current/20 px-2 py-1 rounded-sm"
                    >Mail</span
                  >
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </ul>

    <a
      href="/contacto"
      id="header-cta"
      class="hidden lg:flex items-center gap-2 border border-negro px-5 py-2.5 font-mono text-xs tracking-widest uppercase overflow-hidden relative group transition-colors duration-300 !rounded-2xl hover:!rounded-none"
    >
      <span
        class="relative z-10 group-hover:text-blanco transition-colors duration-300 ease-out cta-text"
      >
        Trabajemos juntos
      </span>
      <div
        class="absolute inset-0 bg-negro scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-out cta-bg"
      >
      </div>
    </a>

    <button
      id="menu-toggle"
      class="lg:hidden flex flex-col gap-1.5 p-2"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <span
        class="menu-bar block w-6 h-0.5 bg-negro transition-colors duration-400"
      ></span>
      <span
        class="menu-bar block w-6 h-0.5 bg-negro transition-colors duration-400"
      ></span>
      <span
        class="menu-bar block w-4 h-0.5 bg-negro transition-colors duration-400"
      ></span>
    </button>
  </nav>

  <div
    id="mobile-menu-overlay"
    class="fixed inset-0 bg-negro/60 z-40 opacity-0 pointer-events-none transition-opacity duration-500 backdrop-blur-sm"
    aria-hidden="true"
  >
  </div>

  <div
    id="mobile-menu"
    class="fixed top-0 right-0 h-screen w-full md:w-[320px] bg-[#0a0a0a] border-l border-blanco/10 z-50 flex flex-col translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] shadow-2xl"
    aria-hidden="true"
  >
    <div
      class="flex items-center justify-between px-6 h-20 border-b border-blanco/10"
    >
      <a href="/" class="invert opacity-90 w-20">
        <Logo />
      </a>
      <button
        id="menu-close"
        class="text-blanco/50 hover:text-blanco p-2 -mr-2 transition-colors"
        aria-label="Cerrar menú"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"><path d="M18 6L6 18M6 6l12 12"></path></svg
        >
      </button>
    </div>

    <ul class="flex flex-col flex-1 px-8 justify-center list-none m-0 gap-8">
      <li class="mobile-item overflow-hidden">
        <a
          href="/"
          class="text-blanco font-display text-5xl mobile-menu-link block translate-y-full hover:text-blanco/70 transition-colors"
          >Inicio</a
        >
      </li>
      <li class="mobile-item overflow-hidden">
        <a
          href="/#servicios"
          class="text-blanco font-display text-5xl mobile-menu-link block translate-y-full hover:text-blanco/70 transition-colors"
          >Servicios</a
        >
      </li>
      <li class="mobile-item overflow-hidden">
        <a
          href="/nosotros"
          class="text-blanco font-display text-5xl mobile-menu-link block translate-y-full hover:text-blanco/70 transition-colors"
          >Nosotros</a
        >
      </li>
      <li class="mobile-item overflow-hidden">
        <a
          href="/blog"
          class="text-blanco font-display text-5xl mobile-menu-link block translate-y-full hover:text-blanco/70 transition-colors"
          >Blog</a
        >
      </li>
      <li class="mobile-item overflow-hidden">
        <a
          href="/contacto"
          class="text-blanco font-display text-5xl mobile-menu-link block translate-y-full hover:text-blanco/70 transition-colors"
          >Contacto</a
        >
      </li>
    </ul>

    <div class="p-6 border-t border-blanco/10 bg-negro">
      <a
        href="/contacto"
        class="flex items-center justify-center gap-2 border border-blanco/20 bg-blanco/5 text-blanco px-5 py-4 font-mono text-xs tracking-widest uppercase hover:bg-blanco hover:text-negro transition-colors duration-300 w-full rounded-md hover:rounded-none"
      >
        Trabajemos juntos
      </a>
      <div
        class="mt-6 font-mono text-[10px] text-blanco/20 tracking-[0.2em] uppercase text-center"
      >
        VEZNER © vezner.net
      </div>
    </div>
  </div>
</header>

<style>
  #header {
    background: transparent;
    transition:
      background 0.5s ease,
      backdrop-filter 0.5s ease,
      border-color 0.5s ease;
    border-bottom: 1px solid transparent;
  }

  #header.scrolled {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: rgba(10, 10, 10, 0.06);
  }

  :global(#header.theme-dark.scrolled) {
    background: rgba(10, 10, 10, 0.92);
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  :global(#header.theme-dark .logo-container img) {
    filter: invert(1);
  }
  :global(#header.theme-dark .logo-container .logo-canvas) {
    filter: invert(1);
  }

  :global(#header.theme-dark .nav-link),
  :global(#header.theme-dark .cta-text) {
    color: #ffffff;
  }
  :global(#header.theme-dark #header-cta) {
    border-color: rgba(255, 255, 255, 0.5);
  }
  :global(#header.theme-dark .cta-bg) {
    background-color: #ffffff;
  }
  :global(#header.theme-dark #header-cta:hover .cta-text) {
    color: #000000;
  }
  :global(#header.theme-dark .menu-bar) {
    background-color: #ffffff;
  }

  .dropdown-theme-sync {
    background-color: rgba(255, 255, 255, 0.95);
    border-color: rgba(0, 0, 0, 0.05);
    color: #000000;
  }

  :global(#header.theme-dark) .dropdown-theme-sync {
    background-color: rgba(10, 10, 10, 0.95);
    border-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  /* When the header is scrolled but theme is not dark, ensure mega menu links match */
  :global(#header.theme-dark) .mega-link {
    border-color: rgba(255, 255, 255, 0.1);
  }

  /* --- Animación fluida para los enlaces del menú desplegable --- */
  .mega-link {
    text-decoration: none;
    color: inherit;
    transition: color 0.5s ease;
  }

  .mega-arrow {
    display: inline-block;
    width: 0;
    opacity: 0;
    transform: translateX(-12px);
    transition:
      width 0.5s cubic-bezier(0.25, 1, 0.5, 1),
      opacity 0.5s cubic-bezier(0.25, 1, 0.5, 1),
      transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    font-size: 12px;
    overflow: hidden;
  }

  .mega-text {
    display: inline-block;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Efecto Hover: la flecha aparece y desplaza el texto suavemente */
  .mega-link:hover {
    opacity: 1 !important; /* Evita conflictos con opacidades previas */
  }

  .mega-link:hover .mega-arrow {
    width: 16px;
    opacity: 1;
    transform: translateX(0);
  }

  .mega-link:hover .mega-text {
    transform: translateX(4px);
  }

  /* Asegurar consistencia de color si el encabezado cambia a tema oscuro */
  :global(#header.theme-dark) .mega-link {
    color: #ffffff;
  }
  :global(#header.theme-dark) .mega-arrow {
    color: #ffffff;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    line-height: 1.4;
    height: 1.4em;
  }

  .nav-link-text,
  .nav-link-clone {
    display: block;
    transition: transform 0.35s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .nav-link-clone {
    position: absolute;
    top: 100%;
    left: 0;
  }

  .group\/navlink:hover .nav-link-text,
  .desktop-nav-item:hover .nav-link-text {
    transform: translateY(-100%);
  }

  .group\/navlink:hover .nav-link-clone,
  .desktop-nav-item:hover .nav-link-clone {
    transform: translateY(-100%);
  }

  .mobile-menu-link {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #mobile-menu.open .mobile-menu-link {
    transform: translateY(0);
  }

  #mobile-menu.open .mobile-item:nth-child(1) .mobile-menu-link {
    transition-delay: 0.2s;
  }
  #mobile-menu.open .mobile-item:nth-child(2) .mobile-menu-link {
    transition-delay: 0.3s;
  }
  #mobile-menu.open .mobile-item:nth-child(3) .mobile-menu-link {
    transition-delay: 0.4s;
  }
  #mobile-menu.open .mobile-item:nth-child(4) .mobile-menu-link {
    transition-delay: 0.5s;
  }

  .menu-toggle-open .menu-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .menu-toggle-open .menu-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .menu-toggle-open .menu-bar:nth-child(3) {
    width: 24px;
    transform: translateY(-8px) rotate(-45deg);
  }

  #mobile-menu-overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  #mobile-menu.open {
    transform: translateX(0);
    pointer-events: all;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const header = document.getElementById("header");

    const onScroll = () => {
      if (window.scrollY > 40) {
        header?.classList.add("scrolled");
      } else {
        header?.classList.remove("scrolled");
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    const toggle = document.getElementById("menu-toggle");
    const closeBtn = document.getElementById("menu-close");
    const mobileMenu = document.getElementById("mobile-menu");
    const overlay = document.getElementById("mobile-menu-overlay");
    let menuOpen = false;

    const openMenu = () => {
      menuOpen = true;
      toggle?.classList.add("menu-toggle-open");
      toggle?.setAttribute("aria-expanded", "true");
      mobileMenu?.classList.add("open");
      overlay?.classList.add("open");
      mobileMenu?.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    const closeMenu = () => {
      menuOpen = false;
      toggle?.classList.remove("menu-toggle-open");
      toggle?.setAttribute("aria-expanded", "false");
      mobileMenu?.classList.remove("open");
      overlay?.classList.remove("open");
      mobileMenu?.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    toggle?.addEventListener("click", () =>
      menuOpen ? closeMenu() : openMenu(),
    );
    closeBtn?.addEventListener("click", closeMenu);
    document.querySelectorAll(".mobile-menu-link").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menuOpen) closeMenu();
    });

    // --- Lógica del Morphing Dropdown ---
    const desktopNavList = document.getElementById("desktop-nav-list");
    const morphingDropdown = document.getElementById("morphing-dropdown");
    const navItems = document.querySelectorAll(".desktop-nav-item");
    const panels = document.querySelectorAll(".morph-panel");

    let hideTimeout: ReturnType<typeof setTimeout> | undefined;
    let isDropdownOpen = false;
    let currentPanelIndex = -1;
    const panelOrder = ["inicio", "servicios", "nosotros", "blog", "contacto"];

    const hideDropdown = () => {
      isDropdownOpen = false;
      currentPanelIndex = -1;
      if (morphingDropdown instanceof HTMLElement) {
        morphingDropdown.style.opacity = "0";
        morphingDropdown.style.pointerEvents = "none";
      }
      panels.forEach((p) => {
        if (p instanceof HTMLElement) {
          p.style.transition = "opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1)";
          p.style.opacity = "0";
          p.style.pointerEvents = "none";
        }
      });
    };

    navItems.forEach((item) => {
      item.addEventListener("mouseenter", () => {
        clearTimeout(hideTimeout);
        const dropdownName = item.getAttribute("data-dropdown");
        if (!dropdownName || !morphingDropdown) return;

        const targetPanel = document.querySelector(
          `.morph-panel[data-panel="${dropdownName}"]`,
        );
        if (!(targetPanel instanceof HTMLElement)) return;

        const newIndex = panelOrder.indexOf(dropdownName);
        const isMovingRight =
          currentPanelIndex !== -1 ? newIndex > currentPanelIndex : null;

        panels.forEach((p, idx) => {
          if (idx !== newIndex && p instanceof HTMLElement) {
            p.style.transition = "opacity 0.2s ease";
            p.style.opacity = "0";
            p.style.pointerEvents = "none";
            p.style.transform = "none";
          }
        });

        if (currentPanelIndex !== newIndex) {
          targetPanel.style.transition = "none";
          if (!isDropdownOpen) {
            targetPanel.style.transform = "translateY(10px)";
          } else {
            targetPanel.style.transform = "none";
          }

          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              targetPanel.style.transition =
                "opacity 0.4s ease, transform 0.4s ease";
              targetPanel.style.opacity = "1";
              targetPanel.style.transform = "translate(0, 0)";
              targetPanel.style.pointerEvents = "auto";
            });
          });
        }

        currentPanelIndex = newIndex;

        const panelContent = targetPanel.firstElementChild;
        if (panelContent) {
          const contentWidth = panelContent.getBoundingClientRect().width;
          const contentHeight = panelContent.getBoundingClientRect().height;

          const itemRect = item.getBoundingClientRect();
          const navRect = desktopNavList?.getBoundingClientRect();

          if (navRect && morphingDropdown instanceof HTMLElement) {
            const left =
              itemRect.left -
              navRect.left +
              itemRect.width / 2 -
              contentWidth / 2;
            morphingDropdown.style.width = `${contentWidth}px`;
            morphingDropdown.style.height = `${contentHeight}px`;
            morphingDropdown.style.transform = `translateX(${left}px)`;

            if (!isDropdownOpen) {
              morphingDropdown.style.opacity = "1";
              morphingDropdown.style.pointerEvents = "auto";
              isDropdownOpen = true;
            }
          }
        }
      });

      item.addEventListener("mouseleave", () => {
        hideTimeout = setTimeout(hideDropdown, 150);
      });
    });

    if (morphingDropdown) {
      morphingDropdown.addEventListener("mouseenter", () =>
        clearTimeout(hideTimeout),
      );
      morphingDropdown.addEventListener("mouseleave", () => {
        hideTimeout = setTimeout(hideDropdown, 150);
      });
    }
  });
</script>
