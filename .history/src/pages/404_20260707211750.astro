---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout
  title="Página no encontrada — VEZNER"
  description="Error 404. Parece que te perdiste en el espacio."
  noindex={true}
>
  <Header theme="dark" />

  <main
    class="bg-[#050505] text-blanco h-screen w-full flex flex-col items-center justify-center relative overflow-hidden"
    id="page-404"
  >
    <div
      class="absolute inset-0 z-0 opacity-10"
      style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 80px 80px; transform: perspective(500px) rotateX(60deg) translateY(-100px) translateZ(-200px); animation: gridMove 10s linear infinite;"
    >
    </div>

    <div
      class="relative z-10 flex flex-col items-center justify-center pointer-events-none"
    >
      <div
        id="magnetic-404"
        class="font-display text-[clamp(120px,25vw,300px)] leading-none text-transparent tracking-tighter"
        style="-webkit-text-stroke: 2px rgba(255,255,255,0.3);"
      >
        404
      </div>

      <div class="mt-8 text-center px-6">
        <h1
          class="font-mono text-xl md:text-2xl tracking-widest uppercase mb-4 text-blanco/80"
        >
          ¿Te perdiste?
        </h1>
        <p class="font-mono text-sm text-blanco/40 max-w-md mx-auto mb-10">
          La ruta que buscabas no existe o fue movida. Pero tu negocio no tiene
          por qué quedarse a la deriva.
        </p>

        <a
          href="/"
          class="btn-primary pointer-events-auto inline-flex items-center justify-center gap-3 bg-blanco text-negro px-8 py-4 font-mono text-xs tracking-widest uppercase border border-blanco hover:bg-negro hover:text-blanco transition-colors duration-300 group"
        >
          <span class="group-hover:text-blanco transition-colors duration-300"
            >Volver al Inicio</span
          >
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  @keyframes gridMove {
    0% {
      transform: perspective(500px) rotateX(60deg) translateY(0)
        translateZ(-200px);
    }
    100% {
      transform: perspective(500px) rotateX(60deg) translateY(80px)
        translateZ(-200px);
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  document.addEventListener("astro:page-load", () => {
    const text404 = document.getElementById("magnetic-404");
    const container = document.getElementById("page-404");

    if (text404 && container) {
      container.addEventListener("mousemove", (e) => {
        const { clientX, clientY } = e;
        const xPos = (clientX / window.innerWidth - 0.5) * 60;
        const yPos = (clientY / window.innerHeight - 0.5) * 60;

        gsap.to(text404, {
          x: xPos,
          y: yPos,
          duration: 1,
          ease: "power3.out",
        });
      });

      container.addEventListener("mouseleave", () => {
        gsap.to(text404, {
          x: 0,
          y: 0,
          duration: 1,
          ease: "power3.out",
        });
      });
    }
  });
</script>
