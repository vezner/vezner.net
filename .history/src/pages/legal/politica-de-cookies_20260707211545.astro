---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const año = new Date().getFullYear();
---

<Layout
  title="Política de Cookies — VEZNER"
  description="Política de uso de cookies de VEZNER. Córdoba, Argentina."
  noindex={true}
>
  <Header />
  <main class="bg-blanco min-h-screen pt-32 pb-0">
    <section class="px-6 md:px-12 py-20">
      <div class="container mx-auto max-w-3xl">
        <div class="mb-4">
          <span
            class="font-mono text-xs tracking-[0.35em] uppercase text-negro/30"
            >Legal</span
          >
        </div>
        <h1
          class="font-display text-[clamp(48px,10vw,120px)] leading-none text-negro mb-12"
        >
          POLÍTICA DE<br />COOKIES
        </h1>

        <div
          class="font-mono text-sm text-negro/60 leading-relaxed space-y-8 max-w-2xl"
        >
          <p class="text-negro/30 text-xs">Última actualización: Enero 2026</p>

          <div>
            <h2 class="font-display text-2xl text-negro mb-4">
              ¿Qué son las cookies?
            </h2>
            <p>
              Las cookies son pequeños archivos de texto que se almacenan en tu
              dispositivo cuando visitás un sitio web. Sirven para recordar
              preferencias, analizar el tráfico y mejorar la experiencia de
              navegación.
            </p>
          </div>

          <div>
            <h2 class="font-display text-2xl text-negro mb-4">
              Tipos de cookies que usamos
            </h2>
            <div class="space-y-4">
              <div class="border-l-2 border-verde/40 pl-4">
                <p class="text-negro font-medium mb-1">
                  Cookies técnicas (necesarias)
                </p>
                <p>
                  Esenciales para el funcionamiento del sitio. No pueden
                  desactivarse.
                </p>
              </div>
              <div class="border-l-2 border-azul/40 pl-4">
                <p class="text-negro font-medium mb-1">
                  Cookies de análisis (Google Analytics)
                </p>
                <p>
                  Recopilan datos anónimos sobre el uso del sitio para mejorar
                  su rendimiento. Pueden desactivarse sin afectar la
                  funcionalidad.
                </p>
              </div>
            </div>
          </div>

          <div>
            <h2 class="font-display text-2xl text-negro mb-4">
              Control de cookies
            </h2>
            <p>
              Podés configurar tu navegador para bloquear o eliminar cookies.
              Ten en cuenta que algunas funcionalidades del sitio pueden verse
              afectadas. Para más información, consultá la configuración de
              privacidad de tu navegador.
            </p>
          </div>

          <div class="pt-8 border-t border-negro/10">
            <p class="text-negro/40 text-xs">
              © {año} VEZNER. hola@vezner.net
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
