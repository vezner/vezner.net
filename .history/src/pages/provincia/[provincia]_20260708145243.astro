---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CardServicio from '../../components/CardServicio.astro';

export function getStaticPaths() {
  return [
    {
      params: { provincia: 'cordoba' },
      props: {
        name: 'Córdoba',
        colorCls: 'text-rosa',
        accentBg: 'bg-rosa',
        glowCls: 'bg-rosa/10',
        desc: 'Desarrollamos soluciones digitales de alta gama en Córdoba. Landing pages de máxima conversión, software industrial en Python y ecosistemas de marca con geometría estratégica para liderar el mercado de la Docta.'
      }
    },
    {
      params: { provincia: 'buenos-aires' },
      props: {
        name: 'Buenos Aires',
        colorCls: 'text-yellow-400',
        accentBg: 'bg-yellow-400',
        glowCls: 'bg-yellow-400/5',
        desc: 'Ingeniería digital y branding premium en Buenos Aires. Creamos sitios web semánticos, automatizaciones corporativas con tipado estricto y marcas minimalistas de altísima gama para competir en el entorno más exigente.'
      }
    },
    {
      params: { provincia: 'mendoza' },
      props: {
        name: 'Mendoza',
        colorCls: 'text-verde',
        accentBg: 'bg-verde',
        glowCls: 'bg-verde/10',
        desc: 'Diseño web a medida y desarrollo de sistemas en Mendoza. Optimizamos tus Core Web Vitals, automatizamos procesos operativos masivos en Python y construimos identidades visuales memorables para empresas cuyanas.'
      }
    },
    {
      params: { provincia: 'santa-fe' },
      props: {
        name: 'Santa Fe',
        colorCls: 'text-rosa',
        accentBg: 'bg-rosa',
        glowCls: 'bg-rosa/10',
        desc: 'Agencia de software, diseño web y branding en Santa Fe. Sitios web mobile-first integrados con pasarelas de pago, bots automáticos 24/7 y manuales de marca técnicos para consolidar tu autoridad digital.'
      }
    }
    // Podés continuar listando las provincias restantes siguiendo este mismo mapeo estratégico.
  ];
}

const { provincia } = Astro.params;
const { name, colorCls, accentBg, glowCls, desc } = Astro.props;
---

<Layout
  title={`Diseño Web, Software & Branding en ${name} — VEZNER`}
  description={desc}
>
  <Header theme="dark" />

  <main class="bg-negro text-blanco min-h-screen overflow-hidden">

    <section id="hero" class="relative min-h-screen flex flex-col justify-center px-6 md:px-16 pt-32 pb-20">
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class={`absolute top-[-10%] left-[-10%] w-[40vw] h-[40vw] ${glowCls} rounded-full blur-[80px] animate-pulse`}></div>
      </div>
      <div class="absolute inset-0 pointer-events-none z-0 opacity-5"
           style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 50px 50px;">
      </div>

      <div class="relative z-10 w-full max-w-7xl mx-auto">
        <div class="hero-reveal flex items-center gap-4 mb-8 opacity-0">
          <div class={`w-12 h-px ${accentBg}/50`}></div>
          <span class="font-mono text-xs tracking-[0.4em] uppercase text-blanco/60">Ingeniería Local / {name}</span>
        </div>

        <h1 class="font-display text-[clamp(45px,10vw,140px)] leading-[0.9] text-blanco uppercase mb-12">
          <span class="block overflow-hidden pt-6 -mt-6"><span class="title-line block translate-y-[120%]">Ingeniería Digital</span></span>
          <span class="block overflow-hidden pt-6 -mt-6"><span class="title-line block translate-y-[120%] ` + colorCls + `">en {name}</span></span>
        </h1>

        <div class="grid md:grid-cols-2 gap-12 md:gap-24 items-end">
          <p class="hero-desc font-mono text-base md:text-lg text-blanco/60 leading-relaxed opacity-0 transform translate-y-8 max-w-lg">
            No usamos plantillas genéricas. Desarrollamos software, marcas y plataformas web a medida bajo una arquitectura semántica y rendimiento extremo, adaptados específicamente al mercado comercial de {name}.
          </p>

          <div class="hero-stats flex flex-wrap gap-8 md:justify-end opacity-0 transform translate-y-8">
            <div class="border-l border-blanco/20 pl-4">
              <p class="font-display text-4xl text-blanco">100%</p>
              <p class="font-mono text-xs text-blanco/40 tracking-widest uppercase">Rendimiento</p>
            </div>
            <div class="border-l border-blanco/20 pl-4">
              <p class="font-display text-4xl text-blanco">Puro</p>
              <p class="font-mono text-xs text-blanco/40 tracking-widest uppercase">Código a Medida</p>
            </div>
          </div>
        </div>
      </div>

      <div class="scroll-prompt absolute bottom-10 left-16 flex items-center gap-4 opacity-0">
        <div class="w-px h-12 bg-blanco/20 relative overflow-hidden">
          <div class={`absolute top-0 left-0 w-full h-1/2 ${accentBg} animate-[scrollPulse_2s_ease-in-out_infinite]`}></div>
        </div>
        <span class="font-mono text-xs tracking-widest uppercase text-blanco/30">Soluciones</span>
      </div>
    </section>

    <section id="soluciones" class="py-32 bg-[#050505] relative overflow-hidden border-y border-blanco/5 text-negro">
      <div class="container mx-auto px-6 md:px-16 max-w-7xl">
        <div class="mb-20">
          <h2 data-gsap="fade-up" class="font-display text-6xl md:text-8xl text-blanco section-title opacity-0 translate-y-10 pl-0">
            SOLUCIONES DE ALTA GAMA
          </h2>
          <p class="font-mono text-sm text-blanco/50 max-w-xl mt-4">
            Ecosistema completo de desarrollo y branding para empresas de la provincia de {name} que buscan desmarcarse de la competencia mediocre.
          </p>
        </div>

        <div class="grid md:grid-cols-1 lg:grid-cols-3 gap-8">
          <CardServicio
            numero="01"
            titulo="DISEÑO WEB"
            descripcion={`Landing pages y sitios corporativos optimizados para Core Web Vitals. Código limpio en Astro, integraciones con Shopify o TiendaNube y pasarelas de pago listas en ${name}.`}
            href="/servicios/diseno-web"
          />
          <CardServicio
            numero="02"
            titulo="SOFTWARE"
            descripcion={`Automatizaciones corporativas, procesamiento de datos masivos y bots
