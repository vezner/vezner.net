---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="Diseño Web — VEZNER"
  description="Diseño de Landing Pages de alta gama para negocios. Optimizadas para conversión, ultrarrápidas y construidas a medida. VEZNER, Córdoba."
>
  <Header />

  <main class="bg-[#fafafa] text-negro min-h-screen overflow-hidden">
    <section
      id="hero"
      class="relative min-h-screen flex flex-col justify-center px-6 md:px-16 pt-32 pb-20"
    >
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div
          class="absolute top-[-10%] left-[-10%] w-[40vw] h-[40vw] bg-rosa/10 rounded-full blur-[80px] animate-pulse"
        >
        </div>
        <div
          class="absolute bottom-[10%] right-[-10%] w-[50vw] h-[50vw] bg-yellow-400/10 rounded-full blur-[100px] animate-pulse"
          style="animation-delay: 2s;"
        >
        </div>
      </div>
      <div
        class="absolute inset-0 pointer-events-none z-0 opacity-10"
        style="background-image: linear-gradient(#000 1px, transparent 1px), linear-gradient(90deg, #000 1px, transparent 1px); background-size: 50px 50px;"
      >
      </div>

      <div class="relative z-10 w-full max-w-7xl mx-auto">
        <div class="hero-reveal flex items-center gap-4 mb-8 opacity-0">
          <div class="w-12 h-px bg-rosa/50"></div>
          <span class="font-mono text-xs tracking-[0.4em] uppercase text-rosa"
            >Servicios / 01</span
          >
        </div>

        <h1
          class="font-display text-[clamp(60px,12vw,180px)] leading-none text-negro uppercase mb-12"
        >
          <span class="block overflow-hidden pt-12 -mt-12"
            ><span class="title-line block translate-y-[120%]">Diseño</span
            ></span
          >
          <span class="block overflow-hidden pt-12 -mt-12"
            ><span class="title-line block translate-y-[120%] text-rosa"
              >Web</span
            ></span
          >
        </h1>

        <div class="grid md:grid-cols-2 gap-12 md:gap-24 items-end">
          <div class="max-w-lg">
            <p
              class="hero-desc font-mono text-base md:text-lg text-negro/70 leading-relaxed opacity-0 transform translate-y-8 mb-8"
            >
              Transformamos visitantes en clientes de alto valor. Diseñamos e
              implementamos ecosistemas web ultrarrápidos, optimizados para <strong
                >Core Web Vitals</strong
              > y enfocados 100% en la conversión. Sin plantillas, pura ingeniería
              estética para marcas premium.
            </p>

            <div
              class="hero-desc opacity-0 transform translate-y-8 flex flex-col sm:flex-row gap-4 mb-6"
            >
              <a
                href="https://wa.me/5493512803889?text=Hola%20VEZNER,%20quiero%20crear%20una%20p%C3%A1gina%20web%20premium"
                target="_blank"
                rel="noopener noreferrer"
                class="group relative inline-flex items-center justify-center gap-3 bg-negro text-blanco px-8 py-4 font-mono text-xs tracking-widest uppercase overflow-hidden border-2 border-negro rounded-2xl hover:rounded-none transition-[border-radius] duration-300 w-full sm:w-auto"
              >
                <span class="relative z-10 flex items-center gap-2"
                  ><i class="fa-brands fa-whatsapp text-base"></i> Cotizar por WhatsApp</span
                >
                <span
                  class="absolute inset-0 bg-rosa translate-x-[-101%] group-hover:translate-x-0 transition-transform duration-300 ease-out z-0"
                ></span>
              </a>
              <a
                href="#soluciones"
                class="inline-flex items-center justify-center px-8 py-4 font-mono text-xs tracking-widest uppercase border-2 border-negro/20 text-negro rounded-2xl hover:rounded-none hover:border-negro transition-all duration-300 w-full sm:w-auto"
              >
                Ver Soluciones
              </a>
            </div>

            <div
              class="hero-desc opacity-0 transform translate-y-8 flex items-center gap-4 text-xs font-mono text-negro/50"
            >
              <span class="flex items-center gap-1.5"
                ><i class="fa-solid fa-check text-verde"></i> Desarrollo a medida</span
              >
              <span class="flex items-center gap-1.5"
                ><i class="fa-solid fa-bolt text-yellow-500"></i> Carga &lt; 1s
              </span>
            </div>
          </div>

          <div
            class="hero-stats flex flex-wrap gap-8 md:justify-end opacity-0 transform translate-y-8"
          >
            <div
              class="border-l-2 border-rosa pl-5 group hover:border-negro transition-colors duration-300"
            >
              <p
                class="font-display text-5xl text-negro group-hover:text-rosa transition-colors duration-300"
              >
                UI/UX
              </p>
              <p
                class="font-mono text-[10px] text-negro/50 tracking-[0.2em] uppercase mt-1"
              >
                Calidad Premium
              </p>
            </div>
            <div
              class="border-l-2 border-rosa pl-5 group hover:border-negro transition-colors duration-300"
            >
              <p
                class="font-display text-5xl text-negro group-hover:text-rosa transition-colors duration-300"
              >
                MAX
              </p>
              <p
                class="font-mono text-[10px] text-negro/50 tracking-[0.2em] uppercase mt-1"
              >
                Ingeniería de Conversión
              </p>
            </div>
            <div
              class="border-l-2 border-rosa pl-5 group hover:border-negro transition-colors duration-300"
            >
              <p
                class="font-display text-5xl text-negro group-hover:text-rosa transition-colors duration-300"
              >
                0%
              </p>
              <p
                class="font-mono text-[10px] text-negro/50 tracking-[0.2em] uppercase mt-1"
              >
                Plantillas Genéricas
              </p>
            </div>
          </div>
        </div>
      </div>

      <div
        class="scroll-prompt absolute bottom-10 left-6 md:left-16 flex items-center gap-4 opacity-0"
      >
        <div class="w-px h-12 bg-negro/20 relative overflow-hidden">
          <div
            class="absolute top-0 left-0 w-full h-1/2 bg-rosa animate-[scrollPulse_2s_ease-in-out_infinite]"
          >
          </div>
        </div>
        <span
          class="font-mono text-[10px] tracking-[0.3em] uppercase text-negro/40"
          >Scroll</span
        >
      </div>
    </section>

    <section
      id="soluciones"
      class="py-32 bg-[#050505] relative overflow-hidden text-blanco"
    >
      <div class="container mx-auto px-6 md:px-16 max-w-7xl">
        <h2
          data-gsap="fade-up"
          class="font-display text-6xl md:text-8xl text-blanco mb-20 section-title opacity-0 border-l-4 border-rosa pl-8"
        >
          ¿QUÉ PODEMOS<br />CONSTRUIR?
        </h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
          {
            [
              {
                t: "Landing Pages",
                d: "Sitios de una sola página ultra optimizados para captar leads y ventas directas con pasarelas de pago.",
                c: "bg-[#111] hover:bg-rosa/10 hover:border-rosa/30",
              },
              {
                t: "E-Commerce",
                d: "Tiendas online completas integradas con plataformas sólidas como Shopify o TiendaNube.",
                c: "bg-[#111] hover:bg-yellow-400/10 hover:border-yellow-400/30",
              },
              {
                t: "Web Corporativa",
                d: "Sitios multipágina con una arquitectura de la información impecable y rendimiento auditado con Lighthouse.",
                c: "bg-[#111] hover:bg-verde/10 hover:border-verde/30",
              },
              {
                t: "Suscripción Total",
                d: "Nos encargamos de todo. Hosting de alto rendimiento, dominio y mantenimiento continuo cubiertos por un fee mensual.",
                c: "bg-[#111] hover:bg-azul/10 hover:border-azul/30",
              },
            ].map((item, i) => (
              <div
                class={`use-case opacity-0 transform-gpu will-change-transform will-change-[opacity] border border-blanco/5 p-8 transition-colors transition-[border-radius] duration-300 rounded-2xl hover:rounded-none ${item.c} group`}
              >
                <div class="font-mono text-xs text-blanco/30 mb-6 group-hover:text-blanco transition-colors duration-300">
                  0{i + 1}
                </div>
                <h3
                  data-gsap="fade-up"
                  class="font-display text-3xl mb-4 text-blanco group-hover:translate-x-2 transition-transform duration-300"
                >
                  {item.t}
                </h3>
                <p class="font-mono text-xs text-blanco/50 leading-relaxed">
                  {item.d}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="estandar"
      class="py-32 bg-negro text-blanco relative overflow-hidden"
    >
      <div class="container mx-auto px-6 md:px-16 max-w-7xl relative z-10">
        <div class="grid md:grid-cols-2 gap-20">
          <div
            data-gsap="fade-up"
            class="vs-card opacity-0 transform-gpu will-change-transform will-change-[opacity] border border-blanco/10 p-10 md:p-16 hover:bg-blanco/5 rounded-2xl hover:rounded-none transition-colors transition-[border-radius] duration-500"
          >
            <span
              class="font-mono text-xs tracking-widest uppercase text-blanco/30 mb-8 block"
              >El estándar mediocre</span
            >
            <h3
              data-gsap="fade-up"
              class="font-display text-5xl mb-6 text-blanco/50"
            >
              Plantillas & <br />Desarrollo Genérico
            </h3>
            <ul class="space-y-4 font-mono text-sm text-blanco/40">
              <li class="flex gap-4">
                <span>×</span> Diseños genéricos que no transmiten autoridad.
              </li>
              <li class="flex gap-4">
                <span>×</span> Carga extremadamente lenta que mata las ventas.
              </li>
              <li class="flex gap-4">
                <span>×</span> Cero enfoque en jerarquía de información.
              </li>
              <li class="flex gap-4">
                <span>×</span> UI rota en dispositivos móviles.
              </li>
            </ul>
          </div>

          <div
            data-gsap="fade-up"
            class="vs-card opacity-0 transform-gpu will-change-transform will-change-[opacity] border border-blanco/30 bg-blanco/5 p-10 md:p-16 relative rounded-2xl hover:rounded-none transition-colors transition-[border-radius] duration-500"
          >
            <div
              class="absolute top-0 right-0 w-24 h-24 bg-blanco/20 blur-[50px]"
            >
            </div>
            <span
              class="font-mono text-xs tracking-widest uppercase text-blanco mb-8 block"
              >El estándar VEZNER</span
            >
            <h3
              data-gsap="fade-up"
              class="font-display text-5xl mb-6 text-blanco"
            >
              Ventas &<br />Autoridad
            </h3>
            <ul class="space-y-4 font-mono text-sm text-blanco/70">
              <li class="flex gap-4">
                <span class="text-blanco">✓</span> Desarrollo a medida (Astro, React,
                HTML puro).
              </li>
              <li class="flex gap-4">
                <span class="text-blanco">✓</span> E-commerce optimizado (Shopify
                o TiendaNube).
              </li>
              <li class="flex gap-4">
                <span class="text-blanco">✓</span> Diseño de alta gama, estético y
                estratégico.
              </li>
              <li class="flex gap-4">
                <span class="text-blanco">✓</span> Integración de pasarelas (Mercado
                Pago, Stripe).
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section
      id="proceso"
      class="py-32 px-6 md:px-16 bg-[#050505] text-blanco border-t border-blanco/10"
    >
      <div class="max-w-7xl mx-auto">
        <h2
          data-gsap="fade-up"
          class="font-display text-5xl md:text-7xl text-blanco mb-20 text-center section-title opacity-0"
        >
          PROCESO DE CREACIÓN
        </h2>
        <div
          class="space-y-0 relative border-l border-blanco/10 ml-4 md:ml-8 pl-8 md:pl-16 py-8"
        >
          {
            [
              {
                n: "01",
                t: "Investigación & Arquitectura",
                d: "Analizamos tu negocio, competencia y objetivos. Definimos el mapa de sitio y la estructura de la información para maximizar la conversión.",
              },
              {
                n: "02",
                t: "Diseño UX/UI",
                d: "Creamos interfaces estéticas, funcionales y alineadas a tu identidad de marca, priorizando la experiencia del usuario.",
              },
              {
                n: "03",
                t: "Desarrollo & Optimización",
                d: "Escribimos el código a medida, implementamos animaciones e integramos plataformas asegurando un rendimiento impecable.",
              },
              {
                n: "04",
                t: "Pruebas & Lanzamiento",
                d: "Auditamos la web en diferentes dispositivos, verificamos tiempos de carga y desplegamos el proyecto en producción.",
              },
            ].map((paso, i) => (
              <div class="proceso-card opacity-0 transform-gpu will-change-transform will-change-[opacity] relative pb-16 last:pb-0 rounded-2xl hover:rounded-none transition-colors transition-[border-radius] duration-300 group">
                <div class="absolute -left-[45px] md:-left-[77px] top-0 w-3 h-3 rounded-full bg-blanco/20 group-hover:bg-rosa group-hover:shadow-[0_0_15px_rgba(225,29,72,0.6)] border-4 border-[#050505] transform -translate-x-1/2 transition-all duration-300" />
                <span class="font-display text-4xl text-blanco/10 group-hover:text-rosa/40 transition-colors duration-300 absolute -left-12 top-0 -translate-x-full md:-translate-x-0 md:relative md:left-0 md:-top-4">
                  {paso.n}
                </span>
                <h3
                  data-gsap="fade-up"
                  class="font-display text-3xl md:text-4xl text-blanco mb-4 mt-2 md:mt-0 group-hover:text-rosa transition-colors duration-300"
                >
                  {paso.t}
                </h3>
                <p class="font-mono text-sm text-blanco/50 group-hover:text-blanco/80 transition-colors duration-300 leading-relaxed max-w-2xl">
                  {paso.d}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="enfoque" class="py-32 px-6 md:px-16 bg-blanco">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-20">
          <h2
            data-gsap="fade-up"
            class="font-display text-6xl md:text-8xl text-negro mb-6 section-title opacity-0"
          >
            INGENIERÍA<br />DE CONVERSIÓN
          </h2>
        </div>
        <div class="grid md:grid-cols-3 gap-x-12 gap-y-20">
          {
            [
              {
                t: "Stack Moderno",
                d: "Construimos sobre Astro, React y Next.js para garantizar optimización de Core Web Vitals y una experiencia veloz.",
                i: "fa-solid fa-bolt",
              },
              {
                t: "UI Dinámica",
                d: "Implementamos animaciones fluidas, scroll interactivo y diseños estéticos de máxima calidad visual.",
                i: "fa-solid fa-wand-magic-sparkles",
              },
              {
                t: "Arquitectura",
                d: "Estructura semántica HTML5 y buenas prácticas de desarrollo. Integraciones impecables con Shopify o TiendaNube.",
                i: "fa-solid fa-magnifying-glass",
              },
              {
                t: "Alta Conversión",
                d: "Integramos pasarelas de pago como Mercado Pago y Stripe directo en la web, con botones estratégicos para guiar la acción.",
                i: "fa-solid fa-arrow-trend-up",
              },
              {
                t: "Responsive Puro",
                d: "Cero problemas en móvil. Diseñamos con un enfoque mobile-first absoluto, para que se vea premium en cualquier pantalla.",
                i: "fa-solid fa-mobile-screen-button",
              },
              {
                t: "Hosting & Soporte",
                d: "Nos encargamos de todo. Mantenimiento mensual, soporte directo, despliegue global automático y máxima seguridad para que vos te enfoques en vender.",
                i: "fa-solid fa-server",
              },
            ].map((f, i) => (
              <div class="feat-card opacity-0 transform-gpu will-change-transform will-change-[opacity] border-t-2 border-negro/10 pt-8 transition-colors transition-[border-radius] duration-300 rounded-2xl hover:rounded-none hover:border-rosa group hover:bg-negro/[0.02] px-4 -mx-4 pb-4">
                <i
                  class={`${f.i} text-3xl text-negro/20 group-hover:text-rosa group-hover:-translate-y-2 transition-all duration-300 mb-6 block drop-shadow-sm group-hover:drop-shadow-md`}
                />
                <h4 class="font-display text-3xl text-negro mb-4 group-hover:translate-x-1 transition-transform duration-300">
                  {f.t}
                </h4>
                <p class="font-mono text-xs text-negro/60 leading-relaxed">
                  {f.d}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="cta"
      class="py-32 bg-rosa text-blanco text-center relative overflow-hidden"
    >
      <div class="absolute inset-0 z-0">
        <div
          class="absolute inset-0 bg-gradient-to-t from-negro/80 to-transparent"
        >
        </div>
      </div>

      <div class="relative z-10 max-w-4xl mx-auto px-6">
        <h2
          data-gsap="fade-up"
          class="font-display text-6xl md:text-8xl mb-6 cta-title"
        >
          ESCALÁ TUS VENTAS<br /><span class="text-negro/40">HOY MISMO</span>
        </h2>
        <p
          class="font-mono text-sm md:text-base text-blanco/70 mb-12 max-w-2xl mx-auto leading-relaxed cta-desc"
        >
          No pierdas más clientes por una web lenta o genérica. Hablemos sobre
          tu proyecto y construyamos un ecosistema digital de alta conversión.
        </p>

        <div
          class="flex flex-col sm:flex-row items-center justify-center gap-6 cta-btns"
        >
          <a
            href="https://wa.me/5493512803889?text=Hola,%20quiero%20crear%20una%20web%20premium%20con%20VEZNER."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary group relative inline-flex items-center gap-3 bg-[#25D366] text-blanco px-10 py-5 font-mono text-xs tracking-widest uppercase overflow-hidden rounded-2xl hover:rounded-none transition-all duration-300 w-full sm:w-auto justify-center hover:bg-[#1DA851] hover:shadow-[0_0_20px_rgba(37,211,102,0.4)]"
          >
            <i class="fa-brands fa-whatsapp text-lg relative z-10"></i>
            <span class="relative z-10 font-bold">Contactar por WhatsApp</span>
          </a>
          <a
            href="/contacto"
            class="btn-secondary group relative inline-flex items-center justify-center gap-3 border border-blanco/20 text-blanco px-10 py-5 font-mono text-xs tracking-widest uppercase hover:bg-blanco/10 hover:border-blanco/50 transition-all duration-300 rounded-2xl hover:rounded-none w-full sm:w-auto"
          >
            Completar Formulario
          </a>
        </div>

        <p
          class="mt-8 font-mono text-[10px] uppercase tracking-widest text-blanco/40"
        >
          Respuesta inmediata • Proyectos a medida
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .btn-primary:hover span:first-child,
  .btn-primary:hover span:nth-child(2) {
    color: #ffffff;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  document.addEventListener("astro:page-load", () => {
    gsap.registerPlugin(ScrollTrigger);

    // 1. Animación del Hero
    const tl = gsap.timeline();
    tl.to(".hero-reveal", {
      opacity: 1,
      duration: 1,
      ease: "power3.out",
      delay: 0.2,
    });
    tl.to(
      ".title-line",
      { y: "0%", duration: 1.2, stagger: 0.15, ease: "power4.out" },
      "-=0.6",
    );
    tl.to(
      ".hero-desc",
      { opacity: 1, y: 0, duration: 1, ease: "power3.out" },
      "-=0.8",
    );
    tl.to(
      ".hero-stats",
      { opacity: 1, y: 0, duration: 1, ease: "power3.out" },
      "-=0.8",
    );
    tl.to(".scroll-prompt", { opacity: 1, duration: 1 }, "-=0.5");

    // 2. Títulos de las secciones (Ajustado para que se animen individualmente al bajar)
    gsap.utils.toArray(".section-title").forEach((title) => {
      gsap.fromTo(
        title as HTMLElement,
        { opacity: 0, y: 50 },
        {
          scrollTrigger: {
            trigger: title as HTMLElement,
            start: "top 85%",
            once: true,
          },
          opacity: 1,
          y: 0,
          duration: 1,
          ease: "power4.out",
        },
      );
    });

    // 3. Tarjetas: ¿QUÉ PODEMOS CONSTRUIR? (.use-case) - TU PATRÓN FAVORITO
    gsap.utils.toArray(".use-case").forEach((card, i) => {
      gsap.fromTo(
        card as HTMLElement,
        { opacity: 0, y: 50 },
        {
          scrollTrigger: {
            trigger: card as HTMLElement,
            start: "top 85%",
            once: true,
          },
          opacity: 1,
          y: 0,
          duration: 0.8,
          delay: i * 0.15,
          ease: "power3.out",
        },
      );
    });

    // 4. Tarjetas: EL ESTÁNDAR (.vs-card) - CLONADO EXACTO DE .use-case
    gsap.utils.toArray(".vs-card").forEach((card, i) => {
      gsap.fromTo(
        card as HTMLElement,
        { opacity: 0, y: 50 },
        {
          scrollTrigger: {
            trigger: card as HTMLElement,
            start: "top 85%",
            once: true,
          },
          opacity: 1,
          y: 0,
          duration: 0.8,
          delay: i * 0.15,
          ease: "power3.out",
        },
      );
    });

    // 5. Tarjetas: PROCESO DE CREACIÓN (.proceso-card) - CLONADO EXACTO DE .use-case
    gsap.utils.toArray(".proceso-card").forEach((card, i) => {
      gsap.fromTo(
        card as HTMLElement,
        { opacity: 0, y: 50 },
        {
          scrollTrigger: {
            trigger: card as HTMLElement,
            start: "top 85%",
            once: true,
          },
          opacity: 1,
          y: 0,
          duration: 0.8,
          delay: i * 0.15,
          ease: "power3.out",
        },
      );
    });

    // 6. Tarjetas: INGENIERÍA DE CONVERSIÓN (.feat-card) - CLONADO EXACTO DE .use-case
    gsap.utils.toArray(".feat-card").forEach((feat, i) => {
      gsap.fromTo(
        feat as HTMLElement,
        { opacity: 0, y: 50 },
        {
          scrollTrigger: {
            trigger: feat as HTMLElement,
            start: "top 85%",
            once: true,
          },
          opacity: 1,
          y: 0,
          duration: 0.8,
          delay: (i % 3) * 0.15,
          ease: "power3.out",
        },
      );
    });
  });
</script>
