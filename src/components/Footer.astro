<style>
  .footer-col {
    opacity: 0;
    transform: translateY(24px);
  }

  .footer-link {
    text-decoration: none;
    position: relative;
    display: inline-block;
    transition: color 0.25s ease;
  }

  .footer-link::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width 0.3s ease;
  }

  .footer-link:hover::after {
    width: 100%;
  }

  .social-icon-btn {
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      background 0.3s ease;
  }

  .social-icon-btn:hover {
    border-color: var(--hover-color);
    background: color-mix(in srgb, var(--hover-color) 10%, transparent);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { DotLottie } from "@lottiefiles/dotlottie-web";

  document.addEventListener("astro:page-load", () => {
    gsap.registerPlugin(ScrollTrigger);

    gsap.utils.toArray<HTMLElement>(".footer-col").forEach((col, i) => {
      gsap.fromTo(
        col,
        { opacity: 0, y: 24 },
        {
          opacity: 1,
          y: 0,
          duration: 0.7,
          delay: i * 0.1,
          ease: "power3.out",
          scrollTrigger: { trigger: col, start: "top 95%", once: true },
        },
      );
    });

    const footer = document.getElementById("site-footer");
    const footerContent = document.getElementById("site-footer-content");
    const header = document.getElementById("header");
    const letsBuild = document.getElementById("footer-lets-build");

    if (footer && letsBuild) {
      gsap.fromTo(
        letsBuild,
        { x: "50%", opacity: 0, filter: "blur(16px)" },
        {
          x: "-5%",
          opacity: 0.9,
          filter: "blur(0px)",
          ease: "none",
          scrollTrigger: {
            trigger: footer,
            start: "top 90%",
            end: "bottom bottom",
            scrub: 1.5,
          },
        }
      );
    }

    if (header) {
      ScrollTrigger.create({
        trigger: footer,
        start: "bottom bottom+=15px",
        refreshPriority: -1,
        onEnter: () => {
          gsap.to(header, {
            yPercent: -100,
            duration: 0.4,
            ease: "power2.out",
            overwrite: true,
          });
        },
        onLeaveBack: () => {
          gsap.to(header, {
            yPercent: 0,
            duration: 0.4,
            ease: "power2.out",
            overwrite: true,
          });
        },
      });
    }

    const footerCanvas = document.getElementById(
      "footer-logo-canvas",
    ) as HTMLCanvasElement;

    if (footerCanvas && !footerCanvas.hasAttribute("data-initialized")) {
      footerCanvas.setAttribute("data-initialized", "true");

      const footerLottie = new DotLottie({
        canvas: footerCanvas,
        src: "/assets/logo.lottie",
        loop: true,
        autoplay: false,
        speed: 0.8,
      });

      footerLottie.addEventListener("ready", () => {
        footerLottie.setFrame(0);
        footerLottie.pause();
      });

      const footerLogo = footerCanvas.parentElement;
      let stop = false;

      footerLottie.addEventListener("loop", () => {
        if (stop) {
          stop = false;
          footerLottie.setFrame(0);
          footerLottie.pause();
        }
      });

      footerLogo?.addEventListener("mouseenter", () => {
        stop = false;
        footerLottie.play();
      });

      footerLogo?.addEventListener("mouseleave", () => {
        stop = true;
      });
    }
  });
</script>
