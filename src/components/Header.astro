---
import { getCollection } from "astro:content";
import Logo from "./Logo.astro";

let latestPosts: any[] = [];
try {
  const allPosts = await getCollection("blog");
  if (allPosts) {
    latestPosts = allPosts
      .sort(
        (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
      )
      .slice(0, 3);
  }
} catch (e) {}

export interface Props {
  theme?: "light" | "dark";
}

const { theme = "light" } = Astro.props;
---

<header
  id="header"
  class={`fixed top-0 left-0 right-0 z-50 ${theme === "dark" ? "theme-dark" : "theme-light"}`}
>
  <nav class="flex items-center justify-between px-6 md:px-12 h-20 py-0">
    <a
      href="/"
      class="group flex items-center h-full logo-container transition-colors duration-300"
      aria-label="Ir a inicio"
    >
      <Logo />
    </a>

    <ul
      class="hidden lg:flex items-stretch gap-8 list-none m-0 p-0 h-full relative"
      id="desktop-nav-list"
    >
      <li class="h-full desktop-nav-item" data-dropdown="inicio">
        <a
          href="/"
          class="flex items-center h-full px-2 group/navlink font-mono text-xs tracking-widest uppercase"
        >
          <span class="nav-link block">
            <span class="nav-link-text">Inicio</span>
            <span class="nav-link-clone" aria-hidden="true">Inicio</span>
          </span>
        </a>
      </li>

      <li class="h-full desktop-nav-item" data-dropdown="servicios">
        <a
          href="/#servicios"
          class="flex items-center h-full px-2 group/navlink font-mono text-xs tracking-widest uppercase"
        >
          <span class="nav-link block">
            <span class="nav-link-text">Servicios</span>
            <span class="nav-link-clone" aria-hidden="true">Servicios</span>
          </span>
        </a>
      </li>

      <li class="h-full desktop-nav-item" data-dropdown="nosotros">
        <a
          href="/nosotros"
          class="flex items-center h-full px-2 group/navlink font-mono text-xs tracking-widest uppercase"
        >
          <span class="nav-link block">
            <span class="nav-link-text">Nosotros</span>
            <span class="nav-link-clone" aria-hidden="true">Nosotros</span>
          </span>
        </a>
      </li>

      <li class="h-full desktop-nav-item" data-dropdown="blog">
        <a
          href="/blog"
          class="flex items-center h-full px-2 group/navlink font-mono text-xs tracking-widest uppercase"
        >
          <span class="nav-link block">
            <span class="nav-link-text">Blog</span>
            <span class="nav-link-clone" aria-hidden="true">Blog</span>
          </span>
        </a>
      </li>

      <li class="h-full desktop-nav-item" data-dropdown="contacto">
        <a
          href="/contacto"
          class="flex items-center h-full px-2 group/navlink font-mono text-xs tracking-widest uppercase"
        >
          <span class="nav-link block">
            <span class="nav-link-text">Contacto</span>
            <span class="nav-link-clone" aria-hidden="true">Contacto</span>
          </span>
        </a>
      </li>

      <div
        id="morphing-dropdown"
        class="dropdown-theme-sync absolute top-[calc(100%-10px)] left-0 opacity-0 pointer-events-none shadow-2xl rounded-2xl border backdrop-blur-2xl overflow-hidden z-50 origin-top-left"
        style="will-change: width, height, transform, opacity;"
      >
        <div id="morphing-content" class="relative w-full h-full">
          <div
            class="morph-panel absolute top-0 left-0 opacity-0 pointer-events-none"
            data-panel="inicio"
          >
            <div class="p-8 w-[350px]">
              <p
                class="font-mono text-[10px] tracking-widest uppercase opacity-40 mb-4"
              >
                Secciones
              </p>
              <div class="flex flex-col gap-1">
                <a href="/#manifiesto" class="mega-link flex items-center py-2">
                  <span class="mega-arrow">→</span>
                  <span class="mega-text">Manifiesto</span>
                </a>
                <a href="/#servicios" class="mega-link flex items-center py-2">
                  <span class="mega-arrow">→</span>
                  <span class="mega-text">Servicios</span>
                </a>
                <a
                  href="/#crafted-with-purpose"
                  class="mega-link flex items-center py-2"
                >
                  <span class="mega-arrow">→</span>
                  <span class="mega-text">Metodología</span>
                </a>
                <a href="/#potenciamos" class="mega-link flex items-center py-2">
                  <span class="mega-arrow">→</span>
                  <span class="mega-text">Potenciamos</span>
                </a>
              </div>
            </div>
          </div>

          <div
            class="morph-panel absolute top-0 left-0 opacity-0 pointer-events-none"
            data-panel="servicios"
          >
            <div class="p-10 w-[650px]">
              <div class="grid grid-cols-3 gap-8">
                <div>
                  <a
                    href="/servicios/diseno-web"
                    class="font-display text-2xl mb-4 block hover:opacity-70 transition-opacity duration-300"
                    >Diseño Web</a
                  >
                  <div class="flex flex-col font-mono text-xs opacity-70">
                    <a
                      href="/servicios/diseno-web#hero"
                      class="mega-link flex items-center py-2"
                    >
                      <span class="mega-arrow">→</span>
                      <span class="mega-text">Landing Pages</span>
                    </a>
                    <a
                      href="/servicios/diseno-web#estandar"
                      class="mega-link flex items-center py-2"
                    >
                      <span class="mega-arrow">→</span>
                      <span class="mega-text">Estándar VEZNER</span>
                    </a>
                    <a
                      href="/servicios/diseno-web#enfoque"
                      class="mega-link flex items-center py-2"
                    >
                      <span class="mega-arrow">→</span>
                      <span class="mega-text">Nuestro Enfoque</span>
                    </a>
                    <a
                      href="/servicios/diseno-web#contacto-servicio"
                      class="mega-link flex items-center py-2"
                    >
                      <span class="mega-arrow">→</span>
                      <span class="mega-text">Completar Formulario</span>
                    </a>
                  </div>
                </div>
                <div>
                  <a
                    href="/servicios/software-python"
                    class="font-display text-2xl mb-4 block hover:opacity-70 transition-opacity duration-300"
                    >Software</a
                  >
                  <div class="flex flex-col font-mono text-xs opacity-70">
                    <a
                      href="/servicios/software-python#soluciones"
                      class="mega-link flex items-center py-2"
                    >
                      <span class="mega-arrow">→</span>
                      <span class="mega-text">Casos de Uso</span>
                    </a>
                    <a
                      href="/servicios/software-python#calidad"
                      class="mega-link flex items-center py-2"
                    >
                      <span class="mega-arrow">→</span>
                      <span class="mega-text">Código de Calidad</span>
                    </a>
                    <a
                      href="/servicios/software-python#stack"
                      class="mega-link flex items-center py-2"
                    >
                      <span class="mega-arrow">→</span>
                      <span class="mega-text">Nuestro Stack</span>
                    </a>
                    <a
                      href="/servicios/software-python#contacto-servicio"
                      class="mega-link flex items-center py-2"
                    >
                      <span class="mega-arrow">→</span>
                      <span class="mega-text">Completar Formulario</span>
                    </a>
                  </div>
                </div>
                <div>
                  <a
                    href="/servicios/diseno-identidad"
                    class="font-display text-2xl mb-4 block hover:opacity-70 transition-opacity duration-300"
                    >Branding</a
                  >
                  <div class="flex flex-col font-mono text-xs opacity-70">
                    <a
                      href="/servicios/diseno-identidad#hero"
                      class="mega-link flex items-center py-2"
                    >
                      <span class="mega-arrow">→</span>
                      <span class="mega-text">Logotipos</span>
                    </a>
                    <a
                      href="/servicios/diseno-identidad#galeria"
                      class="mega-link flex items-center py-2"
                    >
                      <span class="mega-arrow">→</span>
                      <span class="mega-text">Identidad Visual</span>
                    </a>
                    <a
                      href="/servicios/diseno-identidad#entregables"
                      class="mega-link flex items-center py-2"
                    >
                      <span class="mega-arrow">→</span>
                      <span class="mega-text">Entregables</span>
                    </a>
                    <a
                      href="/servicios/diseno-identidad#contacto-servicio"
                      class="mega-link flex items-center py-2"
                    >
                      <span class="mega-arrow">→</span>
                      <span class="mega-text">Completar Formulario</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div
            class="morph-panel absolute top-0 left-0 opacity-0 pointer-events-none"
            data-panel="nosotros"
          >
            <div class="p-8 w-[250px]">
              <div class="flex flex-col gap-1">
                <a
                  href="/nosotros#agencia"
                  class="mega-link flex flex-col items-start py-2"
                >
                  <span class="flex items-center">
                    <span class="mega-arrow">→</span>
                    <span class="mega-text font-display text-2xl block mb-1"
                      >La Agencia</span
                    >
                  </span>
                  <span
                    class="font-mono text-[10px] opacity-50 block uppercase tracking-wider pl-0 group-hover:pl-4 transition-all duration-500 ease-out"
                    >Nuestra Esencia</span
                  >
                </a>
                <a
                  href="/nosotros#manifiesto"
                  class="mega-link flex flex-col items-start py-2"
                >
                  <span class="flex items-center">
                    <span class="mega-arrow">→</span>
                    <span class="mega-text font-display text-2xl block mb-1"
                      >Manifiesto</span
                    >
                  </span>
                  <span
                    class="font-mono text-[10px] opacity-50 block uppercase tracking-wider pl-0 group-hover:pl-4 transition-all duration-500 ease-out"
                    >Nuestra Verdad</span
                  >
                </a>
                <a
                  href="/nosotros#pilares"
                  class="mega-link flex flex-col items-start py-2"
                >
                  <span class="flex items-center">
                    <span class="mega-arrow">→</span>
                    <span class="mega-text font-display text-2xl block mb-1"
                      >Los 3 Pilares</span
                    >
                  </span>
                  <span
                    class="font-mono text-[10px] opacity-50 block uppercase tracking-wider pl-0 group-hover:pl-4 transition-all duration-500 ease-out"
                    >Nuestro Enfoque</span
                  >
                </a>
              </div>
            </div>
          </div>

          <div
            class="morph-panel absolute top-0 left-0 opacity-0 pointer-events-none"
            data-panel="blog"
          >
            <div class="p-8 w-[400px]">
              <p
                class="font-mono text-[10px] tracking-widest uppercase opacity-40 mb-4"
              >
                Últimos Artículos
              </p>
              <div class="flex flex-col gap-1">
                {
                  latestPosts.length > 0 ? (
                    latestPosts.map((post: any) => (
                      <a
                        href={`/blog/${post.id}`}
                        class="mega-link flex flex-col items-start py-2 border-b border-current/10 last:border-0"
                      >
                        <span class="flex items-center w-full">
                          <span class="mega-arrow">→</span>
                          <span
                            class="mega-text font-display text-xl block mb-1 truncate w-full"
                            title={post.data.title}
                          >
                            {post.data.title}
                          </span>
                        </span>
                        <span class="font-mono text-[10px] opacity-50 block tracking-wider pl-0 group-hover:pl-4 transition-all duration-500 ease-out">
                          {post.data.pubDate.toLocaleDateString("es-AR", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                          })}
                        </span>
                      </a>
                    ))
                  ) : (
                    <p class="font-mono text-xs opacity-50 italic py-2">
                      Próximamente...
                    </p>
                  )
                }

                <a
                  href="/blog"
                  class="mega-link flex items-center mt-4 pt-4 border-t border-current/20 font-mono text-[10px] uppercase tracking-widest"
                >
                  <span class="mega-arrow">→</span>
                  <span class="mega-text">Ver Todos los Artículos</span>
                </a>
              </div>
            </div>
          </div>

          <div
            class="morph-panel absolute top-0 left-0 opacity-0 pointer-events-none"
            data-panel="contacto"
          >
            <div class="p-8 w-[350px]">
              <p
                class="font-mono text-[10px] tracking-widest uppercase opacity-40 mb-4"
              >
                Contactar
              </p>
              <div class="flex flex-col gap-1">
                <a href="/contacto" class="mega-link flex items-center py-3">
                  <span class="mega-arrow">→</span>
                  <span class="mega-text font-display text-xl flex-1"
                    >Formulario Directo</span
                  >
                  <span
                    class="font-mono text-[10px] opacity-50 uppercase tracking-wider border border-current/20 px-2 py-1 rounded-sm ml-auto"
                    >24hs</span
                  >
                </a>
                <a
                  href="mailto:hola@vezner.net"
                  class="mega-link flex items-center py-3"
                >
                  <span class="mega-arrow">→</span>
                  <span class="mega-text font-display text-xl flex-1"
                    >Email Directo</span
                  >
                  <span
                    class="font-mono text-[10px] opacity-50 uppercase tracking-wider border border-current/20 px-2 py-1 rounded-sm ml-auto"
                    >Mail</span
                  >
                </a>
                <a
                  href="https://wa.me/+5493513323272"
                  class="mega-link flex items-center py-3"
                >
                  <span class="mega-arrow">→</span>
                  <span class="mega-text font-display text-xl flex-1"
                    >WhatsApp</span
                  >
                  <span
                    class="font-mono text-[10px] opacity-50 uppercase tracking-wider border border-current/20 px-2 py-1 rounded-sm ml-auto"
                    >+54 9 351 332-3272</span
                  >
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </ul>

    <a
      href="/contacto"
      id="header-cta"
      class="hidden lg:flex items-center gap-2 border border-negro px-5 py-2.5 font-mono text-xs tracking-widest uppercase overflow-hidden relative group transition-colors duration-300 !rounded-2xl hover:!rounded-none"
    >
      <span
        class="relative z-10 group-hover:text-blanco transition-colors duration-300 ease-out cta-text"
      >
        Trabajemos juntos
      </span>
      <div
        class="absolute inset-0 bg-negro scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-out cta-bg"
      >
      </div>
    </a>

    <button
      id="menu-toggle"
      class="lg:hidden flex flex-col gap-1.5 p-2"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <span
        class="menu-bar block w-6 h-0.5 bg-negro transition-colors duration-400"
      ></span>
      <span
        class="menu-bar block w-6 h-0.5 bg-negro transition-colors duration-400"
      ></span>
      <span
        class="menu-bar block w-4 h-0.5 bg-negro transition-colors duration-400"
      ></span>
    </button>
  </nav>

  <div
    id="mobile-menu-overlay"
    class="fixed inset-0 bg-negro/60 z-40 opacity-0 pointer-events-none transition-opacity duration-500 backdrop-blur-sm"
    aria-hidden="true"
  >
  </div>

  <div
    id="mobile-menu"
    class="fixed top-0 right-0 h-screen w-full md:w-[320px] bg-[#0a0a0a] border-l border-blanco/10 z-50 flex flex-col translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] shadow-2xl"
    aria-hidden="true"
  >
    <div
      class="flex items-center justify-between px-6 h-20 border-b border-blanco/10"
    >
      <a href="/" class="invert opacity-90 w-20">
        <Logo />
      </a>
      <button
        id="menu-close"
        class="text-blanco/50 hover:text-blanco p-2 -mr-2 transition-colors"
        aria-label="Cerrar menú"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"><path d="M18 6L6 18M6 6l12 12"></path></svg
        >
      </button>
    </div>

    <ul class="flex flex-col flex-1 px-8 justify-center list-none m-0 gap-8">
      <li class="mobile-item overflow-hidden">
        <a
          href="/"
          class="text-blanco font-display text-5xl mobile-menu-link block translate-y-full hover:text-blanco/70 transition-colors"
          >Inicio</a
        >
      </li>
      <li class="mobile-item overflow-hidden">
        <a
          href="/#servicios"
          class="text-blanco font-display text-5xl mobile-menu-link block translate-y-full hover:text-blanco/70 transition-colors"
          >Servicios</a
        >
      </li>
      <li class="mobile-item overflow-hidden">
        <a
          href="/nosotros"
          class="text-blanco font-display text-5xl mobile-menu-link block translate-y-full hover:text-blanco/70 transition-colors"
          >Nosotros</a
        >
      </li>
      <li class="mobile-item overflow-hidden">
        <a
          href="/blog"
          class="text-blanco font-display text-5xl mobile-menu-link block translate-y-full hover:text-blanco/70 transition-colors"
          >Blog</a
        >
      </li>
      <li class="mobile-item overflow-hidden">
        <a
          href="/contacto"
          class="text-blanco font-display text-5xl mobile-menu-link block translate-y-full hover:text-blanco/70 transition-colors"
          >Contacto</a
        >
      </li>
    </ul>

    <div class="p-6 border-t border-blanco/10 bg-negro">
      <a
        href="/contacto"
        class="flex items-center justify-center gap-2 border border-blanco/20 bg-blanco/5 text-blanco px-5 py-4 font-mono text-xs tracking-widest uppercase hover:bg-blanco hover:text-negro transition-colors duration-300 w-full rounded-md hover:rounded-none"
      >
        Trabajemos juntos
      </a>
      <div
        class="mt-6 font-mono text-[10px] text-blanco/20 tracking-[0.2em] uppercase text-center"
      >
        VEZNER © vezner.net
      </div>
    </div>
  </div>
</header>

<style>
  #header {
    background: transparent;
    transition:
      background 0.5s ease,
      backdrop-filter 0.5s ease,
      border-color 0.5s ease;
    border-bottom: 1px solid transparent;
  }

  #header.scrolled {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: rgba(10, 10, 10, 0.06);
  }

  :global(#header.theme-dark.scrolled) {
    background: rgba(10, 10, 10, 0.92);
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  :global(#header.theme-dark .logo-container img) {
    filter: invert(1);
  }
  :global(#header.theme-dark .logo-container .logo-canvas) {
    filter: invert(1);
  }

  :global(#header.theme-dark .nav-link),
  :global(#header.theme-dark .cta-text) {
    color: #ffffff;
  }
  :global(#header.theme-dark #header-cta) {
    border-color: rgba(255, 255, 255, 0.5);
  }
  :global(#header.theme-dark .cta-bg) {
    background-color: #ffffff;
  }
  :global(#header.theme-dark #header-cta:hover .cta-text) {
    color: #000000;
  }
  :global(#header.theme-dark .menu-bar) {
    background-color: #ffffff;
  }

  :global(#header .logo-container img),
  :global(#header .logo-container .logo-canvas) {
    transition: filter 0.5s ease !important;
  }

  :global(#header .nav-link),
  :global(#header .cta-text),
  :global(#header .menu-bar),
  :global(#header #header-cta),
  :global(#header .cta-bg) {
    transition: all 0.5s ease !important;
  }

  .dropdown-theme-sync {
    background-color: rgba(255, 255, 255, 0.95);
    border-color: rgba(0, 0, 0, 0.05);
    color: #000000;
  }

  :global(#header.theme-dark) .dropdown-theme-sync {
    background-color: rgba(10, 10, 10, 0.95);
    border-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  .mega-link {
    text-decoration: none;
    color: inherit;
    transition: color 0.5s ease;
  }

  .mega-arrow {
    display: inline-block;
    width: 0;
    opacity: 0;
    transform: translateX(-12px);
    transition:
      width 0.5s cubic-bezier(0.25, 1, 0.5, 1),
      opacity 0.5s cubic-bezier(0.25, 1, 0.5, 1),
      transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    font-size: 12px;
    overflow: hidden;
  }

  .mega-text {
    display: inline-block;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .mega-link:hover {
    opacity: 1 !important;
  }

  .mega-link:hover .mega-arrow {
    width: 16px;
    opacity: 1;
    transform: translateX(0);
  }

  .mega-link:hover .mega-text {
    transform: translateX(4px);
  }

  :global(#header.theme-dark) .mega-link {
    color: #ffffff;
  }
  :global(#header.theme-dark) .mega-arrow {
    color: #ffffff;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    line-height: 1.4;
    height: 1.4em;
  }

  .nav-link-text,
  .nav-link-clone {
    display: block;
    transition: transform 0.35s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .nav-link-clone {
    position: absolute;
    top: 100%;
    left: 0;
  }

  .group\/navlink:hover .nav-link-text,
  .desktop-nav-item:hover .nav-link-text {
    transform: translateY(-100%);
  }

  .group\/navlink:hover .nav-link-clone,
  .desktop-nav-item:hover .nav-link-clone {
    transform: translateY(-100%);
  }

  .mobile-menu-link {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #mobile-menu.open .mobile-menu-link {
    transform: translateY(0);
  }

  #mobile-menu.open .mobile-item:nth-child(1) .mobile-menu-link {
    transition-delay: 0.2s;
  }
  #mobile-menu.open .mobile-item:nth-child(2) .mobile-menu-link {
    transition-delay: 0.3s;
  }
  #mobile-menu.open .mobile-item:nth-child(3) .mobile-menu-link {
    transition-delay: 0.4s;
  }
  #mobile-menu.open .mobile-item:nth-child(4) .mobile-menu-link {
    transition-delay: 0.5s;
  }

  .menu-toggle-open .menu-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .menu-toggle-open .menu-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .menu-toggle-open .menu-bar:nth-child(3) {
    width: 24px;
    transform: translateY(-8px) rotate(-45deg);
  }

  #mobile-menu-overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  #mobile-menu.open {
    transform: translateX(0);
    pointer-events: all;
  }
</style>

<script>
  import { gsap } from "gsap";

  document.addEventListener("astro:page-load", () => {
    const header = document.getElementById("header");
    const sections = Array.from(
      document.querySelectorAll("section, footer, main > div, main > section"),
    ).filter((el) => !el.classList.contains("ticker-wrap"));

    const onScroll = () => {
      const scrollY = window.scrollY;
      if (scrollY > 40) {
        header?.classList.add("scrolled");
      } else {
        header?.classList.remove("scrolled");
      }

      if (header) {
        const headerMidY = 40;
        let activeSection = null;

        for (let i = sections.length - 1; i >= 0; i--) {
          const rect = sections[i].getBoundingClientRect();

          if (rect.top <= headerMidY && rect.bottom >= headerMidY) {
            activeSection = sections[i];
            break;
          }
        }

        if (activeSection) {
          let isDark = false;
          let currentEl: Element | null = activeSection;

          while (currentEl && currentEl !== document.documentElement) {
            const className = currentEl.className || "";

            if (
              className.includes("bg-negro") ||
              className.includes("bg-[#050505]") ||
              className.includes("bg-[#080808]") ||
              className.includes("bg-[#0a0a0a]") ||
              className.includes("bg-[#111]") ||
              className.includes("bg-[#1a1a1a]") ||
              className.includes("bg-black")
            ) {
              isDark = true;
              break;
            }

            if (
              className.includes("bg-blanco") ||
              className.includes("bg-white") ||
              className.includes("bg-[#f5f5f5]") ||
              className.includes("bg-[#fafafa]")
            ) {
              isDark = false;
              break;
            }

            currentEl = currentEl.parentElement;
          }

          if (isDark) {
            header.classList.add("theme-dark");
            header.classList.remove("theme-light");
          } else {
            header.classList.add("theme-light");
            header.classList.remove("theme-dark");
          }
        }
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });

    setTimeout(onScroll, 50);

    const toggle = document.getElementById("menu-toggle");
    const closeBtn = document.getElementById("menu-close");
    const mobileMenu = document.getElementById("mobile-menu");
    const overlay = document.getElementById("mobile-menu-overlay");
    let menuOpen = false;

    const openMenu = () => {
      menuOpen = true;
      toggle?.classList.add("menu-toggle-open");
      toggle?.setAttribute("aria-expanded", "true");
      mobileMenu?.classList.add("open");
      overlay?.classList.add("open");
      mobileMenu?.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    const closeMenu = () => {
      menuOpen = false;
      toggle?.classList.remove("menu-toggle-open");
      toggle?.setAttribute("aria-expanded", "false");
      mobileMenu?.classList.remove("open");
      overlay?.classList.remove("open");
      mobileMenu?.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    toggle?.addEventListener("click", () =>
      menuOpen ? closeMenu() : openMenu(),
    );
    closeBtn?.addEventListener("click", closeMenu);
    document.querySelectorAll(".mobile-menu-link").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menuOpen) closeMenu();
    });

    const desktopNavList = document.getElementById("desktop-nav-list");
    const morphingDropdown = document.getElementById("morphing-dropdown");
    const navItems = document.querySelectorAll(".desktop-nav-item");
    const panels = document.querySelectorAll(".morph-panel");

    let hideTimeout: ReturnType<typeof setTimeout> | undefined;
    let isDropdownOpen = false;
    let currentPanelIndex = -1;
    const panelOrder = ["inicio", "servicios", "nosotros", "blog", "contacto"];

    const hideDropdown = () => {
      isDropdownOpen = false;
      currentPanelIndex = -1;

      gsap.killTweensOf(morphingDropdown);
      gsap.to(morphingDropdown, {
        opacity: 0,
        y: 10,
        duration: 0.3,
        ease: "power2.out",
        onComplete: () => {
          if (morphingDropdown) morphingDropdown.style.pointerEvents = "none";
        },
      });

      panels.forEach((p) => {
        if (p instanceof HTMLElement) {
          gsap.killTweensOf(p);
          gsap.to(p, { opacity: 0, duration: 0.2, ease: "power2.inOut" });
          p.style.pointerEvents = "none";
        }
      });
    };

    navItems.forEach((item) => {
      item.addEventListener("mouseenter", () => {
        clearTimeout(hideTimeout);
        const dropdownName = item.getAttribute("data-dropdown");
        if (!dropdownName || !morphingDropdown) return;

        const targetPanel = document.querySelector(
          `.morph-panel[data-panel="${dropdownName}"]`,
        );
        if (!(targetPanel instanceof HTMLElement)) return;

        const newIndex = panelOrder.indexOf(dropdownName);
        const direction =
          currentPanelIndex !== -1 && newIndex > currentPanelIndex ? 1 : -1;

        const isSamePanel = currentPanelIndex === newIndex;

        panels.forEach((p, idx) => {
          if (idx !== newIndex && p instanceof HTMLElement) {
            gsap.killTweensOf(p);
            gsap.to(p, {
              opacity: 0,
              x: isDropdownOpen ? -direction * 15 : 0,
              duration: 0.25,
              ease: "power2.out",
            });
            p.style.pointerEvents = "none";
          }
        });

        if (!isSamePanel || !isDropdownOpen) {
          gsap.killTweensOf(targetPanel);
          gsap.fromTo(
            targetPanel,
            {
              opacity: 0,
              x: isDropdownOpen ? direction * 20 : 0,
              y: isDropdownOpen ? 0 : 8,
            },
            {
              opacity: 1,
              x: 0,
              y: 0,
              duration: 0.4,
              delay: isDropdownOpen ? 0.05 : 0,
              ease: "power3.out",
            },
          );
        } else {
          gsap.killTweensOf(targetPanel);
          gsap.to(targetPanel, {
            opacity: 1,
            x: 0,
            y: 0,
            duration: 0.3,
            ease: "power3.out",
          });
        }

        targetPanel.style.pointerEvents = "auto";
        currentPanelIndex = newIndex;

        const panelContent = targetPanel.firstElementChild;
        if (panelContent) {
          const contentWidth = panelContent.getBoundingClientRect().width;
          const contentHeight = panelContent.getBoundingClientRect().height;

          const itemRect = item.getBoundingClientRect();
          const navRect = desktopNavList?.getBoundingClientRect();

          if (navRect && morphingDropdown instanceof HTMLElement) {
            const left =
              itemRect.left -
              navRect.left +
              itemRect.width / 2 -
              contentWidth / 2;

            gsap.killTweensOf(morphingDropdown);
            morphingDropdown.style.pointerEvents = "auto";

            if (!isDropdownOpen) {
              gsap.set(morphingDropdown, {
                x: left,
                width: contentWidth,
                height: contentHeight,
                opacity: 0,
                y: 10,
              });

              gsap.to(morphingDropdown, {
                opacity: 1,
                y: 0,
                duration: 0.4,
                ease: "power3.out",
              });
              isDropdownOpen = true;
            } else {
              gsap.to(morphingDropdown, {
                width: contentWidth,
                height: contentHeight,
                x: left,
                y: 0,
                opacity: 1,
                duration: 0.4,
                ease: "power3.out",
              });
            }
          }
        }
      });

      item.addEventListener("mouseleave", () => {
        hideTimeout = setTimeout(hideDropdown, 150);
      });
    });

    if (morphingDropdown) {
      morphingDropdown.addEventListener("mouseenter", () =>
        clearTimeout(hideTimeout),
      );
      morphingDropdown.addEventListener("mouseleave", () => {
        hideTimeout = setTimeout(hideDropdown, 150);
      });
    }
  });
</script>
