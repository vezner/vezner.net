---

---

<div
  class="logo-wrapper flex items-center select-none group cursor-pointer pointer-events-auto"
>
  <div
    class="w-[76px] h-[76px] flex items-center justify-center shrink-0 -mr-1 pointer-events-none"
  >
    <canvas class="logo-canvas w-full h-full block"></canvas>
  </div>

  <div class="flex items-center shrink-0 pointer-events-none">
    <img
      src="/assets/vezner-text.webp"
      alt="VEZNER"
      class="h-[30px] w-auto object-contain block"
      width="112"
      height="30"
      draggable="false"
    />
  </div>
</div>

<script>
  let DotLottieClass: any = null;

  function initLogo() {
    const wrappers = document.querySelectorAll(".logo-wrapper");
    if (wrappers.length === 0) return;

    wrappers.forEach((wrapper) => {
      if (wrapper.getAttribute("data-lottie-initialized")) return;
      wrapper.setAttribute("data-lottie-initialized", "true");

      const canvas = wrapper.querySelector(".logo-canvas") as HTMLCanvasElement;
      if (!canvas) return;

      let dotLottie: any = null;
      let shouldStopAtEnd = false;
      let isHovering = false;

      const initDotLottie = async () => {
        if (!DotLottieClass) {
          const { DotLottie } = await import("@lottiefiles/dotlottie-web");
          DotLottieClass = DotLottie;
        }

        if (!dotLottie) {
          dotLottie = new DotLottieClass({
            canvas,
            src: "/assets/logo.lottie",
            loop: true,
            autoplay: isHovering,
            speed: 1,
          });

          dotLottie.addEventListener("ready", () => {
            if (!isHovering) {
              dotLottie.setFrame(0);
              dotLottie.pause();
            }
          });

          dotLottie.addEventListener("loop", () => {
            if (shouldStopAtEnd) {
              shouldStopAtEnd = false;
              dotLottie.setFrame(0);
              dotLottie.pause();
            }
          });
        }
      };

      if ("requestIdleCallback" in window) {
        (window as any).requestIdleCallback(initDotLottie, { timeout: 2000 });
      } else {
        setTimeout(initDotLottie, 1000);
      }

      wrapper.addEventListener("mouseenter", () => {
        isHovering = true;
        shouldStopAtEnd = false;
        if (dotLottie) {
          dotLottie.play();
        }
      });

      wrapper.addEventListener("mouseleave", () => {
        isHovering = false;
        shouldStopAtEnd = true;
      });
    });
  }

  initLogo();
  document.addEventListener("astro:page-load", initLogo);
</script>
