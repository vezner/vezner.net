---
const { phone = "+5493513323272", displayPhone = "+54 9 351 332-3272" } = Astro.props;
---

<a
  href={`https://wa.me/${phone}`}
  target="_blank"
  rel="noopener noreferrer"
  id="wa-float"
  class="fixed bottom-6 left-6 z-[90] flex items-center bg-negro border border-blanco/20 text-blanco h-12 overflow-hidden transition-safe duration-500 ease-[cubic-bezier(0.87,0,0.13,1)] hover:bg-[#111] shadow-2xl hover:border-verde group w-12 hover:w-[220px] rounded-2xl hover:rounded-none"
  aria-label="Contactar por WhatsApp"
>
  <div class="w-12 h-12 flex items-center justify-center shrink-0 border-r border-transparent group-hover:border-blanco/10 transition-safe duration-500">
    <i class="fa-brands fa-whatsapp text-xl text-blanco group-hover:text-verde transition-safe duration-500"></i>
  </div>
  <div class="whitespace-nowrap px-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-100 flex flex-col justify-center">
    <span class="font-mono text-[9px] uppercase tracking-widest text-blanco/40 mb-0.5">Asesoría directa</span>
    <span class="font-mono text-xs text-blanco">{displayPhone}</span>
  </div>
</a>

<style>
  #wa-float {
    
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  #wa-float.is-hidden {
    transform: translateY(120%) scale(0.95);
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {

    const waFloat = document.getElementById('wa-float');
    const footer = document.getElementById('mega-footer');

    if (waFloat && footer) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              waFloat.classList.add('is-hidden');
            } else {
              waFloat.classList.remove('is-hidden');
            }
          });
        },
        { rootMargin: '0px', threshold: 0.05 }
      );
      observer.observe(footer);
    }
  });
</script>

