      function openMenu(x: number, y: number, items: Array<any>) {
        const ctxMenu = document.getElementById(
          "vz-context-menu",
        ) as HTMLElement;
        if (!ctxMenu) return;
        ctxMenu.innerHTML = buildMenuHTML(items);

        const vw = window.innerWidth;
        const vh = window.innerHeight;

        ctxMenu.style.visibility = "hidden";
        ctxMenu.style.display = "block";
        const menuW = ctxMenu.offsetWidth || 230;
        const menuH = ctxMenu.offsetHeight || items.length * 34 + 40;
        ctxMenu.style.visibility = "visible";
        ctxMenu.style.display = "";

        const offset = 2;

        const left = x + offset + menuW > vw ? x - menuW - offset : x + offset;
        const top = y + offset + menuH > vh ? y - menuH - offset : y + offset;

        ctxMenu.style.left = `${Math.max(2, left)}px`;
        ctxMenu.style.top = `${Math.max(2, top)}px`;
        ctxMenu.classList.add("open");
        ctxOpen = true;

        ctxMenu.querySelectorAll(".ctx-item").forEach((item) => {
          item.addEventListener("click", (e) => {
            const action = (item as HTMLElement).dataset.action;
            const href = (item as HTMLAnchorElement).href;

            if (action === "copy-url" || action === "copy-img-url") {
              const url =
                (item as HTMLElement).dataset.action === "copy-url"
                  ? href
                  : (item as HTMLElement).getAttribute("href") || "";
              navigator.clipboard?.writeText(url).catch(() => {});
            } else if (action === "copy-url-current") {
              navigator.clipboard
                ?.writeText(window.location.href)
                .catch(() => {});
            } else if (action === "scroll-top") {
              window.scrollTo({ top: 0, behavior: "smooth" });
            } else if (action === "paste") {
              const active = document.activeElement as HTMLInputElement;
              if (
                (active && active.tagName === "INPUT") ||
                (active as HTMLElement)?.tagName === "TEXTAREA"
              ) {
                navigator.clipboard
                  ?.readText()
                  .then((t) => {
                    (active as HTMLInputElement).value += t;
                  })
                  .catch(() => {});
              }
            } else if (action === "copy-sel") {
              const sel = window.getSelection()?.toString();
              if (sel) navigator.clipboard?.writeText(sel).catch(() => {});
            } else if (action === "search-web") {
              const sel = window.getSelection()?.toString();
              if (sel)
                window.open(
                  `https://www.google.com/search?q=${encodeURIComponent(sel)}`,
                  "_blank",
                );
            } else if (action === "clear-input") {
              const active = document.activeElement as HTMLInputElement;
              if (active) active.value = "";
            } else if (action === "open-new" && href) {
              window.open(href, "_blank", "noopener,noreferrer");
              e.preventDefault();
            } else if (action === "view-img") {
              window.open(href, "_blank");
              e.preventDefault();
            }

            closeMenu();
          });
        });
      }

      function closeMenu() {
        const ctxMenu = document.getElementById("vz-context-menu");
        if (ctxMenu) ctxMenu.classList.remove("open");
        ctxOpen = false;
      }

      document.addEventListener("contextmenu", (e) => {
        e.preventDefault();
        const items = getContextItems(e.target as Element);
        openMenu(e.clientX, e.clientY, items);
      });

      document.addEventListener("click", (e) => {
        const ctxMenu = document.getElementById("vz-context-menu");
        if (ctxOpen && ctxMenu && !ctxMenu.contains(e.target as Node))
          closeMenu();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && ctxOpen) closeMenu();
      });

      window.addEventListener(
        "scroll",
        () => {
          if (ctxOpen) closeMenu();
        },
        { passive: true },
      );
    </script>
  </body>
