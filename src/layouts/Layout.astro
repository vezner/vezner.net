---
import { ClientRouter } from "astro:transitions";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonicalUrl?: string;
  pageType?: "website" | "article" | "service";
  noindex?: boolean;
}

const {
  title = "VEZNER — Ingeniería Digital de Alta Gama | Córdoba, Argentina",
  description = "VEZNER: Agencia de ingeniería digital en Córdoba, Argentina. Diseño web a medida, software Python y diseño de identidad visual. Más de 10 años de experiencia.",
  keywords = "desarrollo web Córdoba, agencia digital Argentina, software Python a medida, diseño identidad visual, diseño web, VEZNER, ingeniería digital",
  ogImage = "/og-image.webp",
  canonicalUrl,
  pageType = "website",
  noindex = false,
} = Astro.props;

const siteUrl = "https://vezner.net";
const fullCanonical = canonicalUrl ? `${siteUrl}${canonicalUrl}` : siteUrl;
const fullOgImage = `${siteUrl}${ogImage}`;

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "VEZNER",
      url: siteUrl,
      logo: {
        "@type": "ImageObject",
        url: `${siteUrl}/assets/vezner-text.webp`,
        width: 200,
        height: 50,
      },
      description:
        "Agencia de ingeniería digital de alta gama en Córdoba, Argentina.",
      foundingDate: "2026",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Córdoba",
        addressCountry: "AR",
      },
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer service",
        email: "hola@vezner.net",
        availableLanguage: ["Spanish"],
      },
      sameAs: [
        "https://x.com/veznerarg",
        "https://github.com/vezner",
        "https://youtube.com/@veznerarg",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "VEZNER",
      publisher: { "@id": `${siteUrl}/#organization` },
      inLanguage: "es-AR",
    },
    {
      "@type": "WebPage",
      "@id": `${fullCanonical}#webpage`,
      url: fullCanonical,
      name: title,
      description,
      isPartOf: { "@id": `${siteUrl}/#website` },
      publisher: { "@id": `${siteUrl}/#organization` },
      inLanguage: "es-AR",
    },
  ],
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <ClientRouter />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="VEZNER" />
    <meta
      name="robots"
      content={noindex
        ? "noindex,nofollow"
        : "index,follow,max-image-preview:large,max-snippet:-1"}
    />
    <link rel="canonical" href={fullCanonical} />
    <link rel="alternate" hreflang="es-AR" href={fullCanonical} />
    <link rel="alternate" hreflang="x-default" href={fullCanonical} />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content="VEZNER" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="VEZNER — Ingeniería Digital" />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@veznerarg" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta name="twitter:creator" content="@veznerarg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="geo.region" content="AR-X" />
    <meta name="geo.placename" content="Córdoba, Argentina" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
        crossorigin="anonymous"
        referrerpolicy="no-referrer"
      />
    </noscript>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@300;400;500;600;700;900&family=JetBrains+Mono:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

    <style is:global>
      /* View Transitions Animaciones Premium */
      ::view-transition-old(root) {
        animation: fadeOutTop 0.4s cubic-bezier(0.87, 0, 0.13, 1) both;
      }
      ::view-transition-new(root) {
        animation: fadeInUp 0.6s cubic-bezier(0.87, 0, 0.13, 1) both;
      }

      @keyframes fadeOutTop {
        from {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
        to {
          opacity: 0;
          transform: translateY(-40px) scale(0.98);
        }
      }
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(40px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      .font-mono {
        font-family: "Outfit", "Inter", system-ui, sans-serif !important;
      }
      html {
        background: #ffffff;
        color: #0a0a0a;
        font-family: "Outfit", "Inter", system-ui, sans-serif;
        overflow-x: hidden;
        height: auto;
      }
      body {
        background: #ffffff;
        color: #0a0a0a;
        overflow-x: clip;
        min-height: 100vh;
      }
      html.lenis,
      html.lenis body {
        height: auto;
      }

      /* Global Border Radius & Animations para Tarjetas (Sin romper GSAP) */
      .servicio-card,
      .servicio-card-simple,
      .use-case,
      .vs-card,
      .term-mockup {
        border-radius: 0.375rem !important;
        transition-property:
          border-radius, background-color, border-color, color !important;
        transition-duration: 400ms !important;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1) !important;
      }
      .servicio-card:hover,
      .servicio-card-simple:hover,
      .use-case:hover,
      .vs-card:hover,
      .term-mockup:hover {
        border-radius: 0 !important;
      }

      /* Global Border Radius & Animations para TODOS los Botones */
      button,
      a.btn-primary,
      a.btn-secondary,
      a.cta-btn,
      a.social-icon-btn,
      a[id$="-cta"] {
        border-radius: 0.375rem !important;
        transition-property: all !important;
        transition-duration: 300ms !important;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1) !important;
      }
      button:hover,
      a.btn-primary:hover,
      a.btn-secondary:hover,
      a.cta-btn:hover,
      a.social-icon-btn:hover,
      a[id$="-cta"]:hover {
        border-radius: 0 !important;
      }

      .lenis.lenis-smooth {
        scroll-behavior: auto !important;
      }
      .lenis.lenis-stopped {
        overflow: hidden;
      }
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: "Bebas Neue", sans-serif;
        line-height: 0.9;
      }
      ::-webkit-scrollbar {
        width: 3px;
      }
      ::-webkit-scrollbar-track {
        background: #ffffff;
      }
      ::-webkit-scrollbar-thumb {
        background: #0a0a0a;
      }
      ::selection {
        background: #0a0a0a;
        color: #ffffff;
      }
      img {
        max-width: 100%;
        height: auto;
      }

      .js-cursor-active,
      .js-cursor-active * {
        cursor: none !important;
      }

      #vz-cursor {
        position: fixed;
        top: 0;
        left: 0;
        pointer-events: none;
        z-index: 99999;
        will-change: transform;
        opacity: 0;
        transition: opacity 0.2s ease;
        transform-origin: 3px 3px;
      }
      .airplane-svg {
        transition:
          transform 0.15s ease,
          filter 0.2s ease;
        filter: drop-shadow(1px 2px 3px rgba(0, 0, 0, 0.3));
      }
      #vz-cursor.visible {
        opacity: 1;
      }
      #vz-cursor.clicking .airplane-svg {
        transform: scale(0.85);
      }
      #vz-cursor.hovering .airplane-svg {
        transform: scale(1.05);
        filter: drop-shadow(0px 0px 5px rgba(255, 255, 255, 0.4));
      }
      #vz-cursor-trail {
        position: fixed;
        top: 0;
        left: 0;
        pointer-events: none;
        z-index: 99998;
        will-change: transform;
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      .cursor-trail-ring {
        width: 32px;
        height: 32px;
        border: 1px solid rgba(10, 10, 10, 0.3);
        border-radius: 50%;
        margin-top: -16px;
        margin-left: -16px;
        transition:
          transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
          background-color 0.3s ease,
          border-color 0.3s ease;
      }
      #vz-cursor.visible,
      #vz-cursor-trail.visible {
        opacity: 1;
      }
      #vz-cursor.clicking .cursor-dot {
        transform: scale(0.5);
      }
      #vz-cursor-trail.clicking .cursor-trail-ring {
        transform: scale(0.8);
        background-color: rgba(10, 10, 10, 0.05);
      }
      #vz-cursor.hovering .cursor-dot {
        transform: scale(0);
      }
      #vz-cursor-trail.hovering .cursor-trail-ring {
        transform: scale(1.5);
        background-color: rgba(10, 10, 10, 0.05);
        border-color: rgba(10, 10, 10, 0.1);
      }

      #vz-context-menu {
        position: fixed;
        z-index: 99990;
        min-width: 220px;
        background: rgba(10, 10, 10, 0.65);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        padding: 6px;
        transform-origin: top left;
        transform: scale(0.92);
        opacity: 0;
        pointer-events: none;
        transition:
          transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1),
          opacity 0.15s ease;
        box-shadow:
          0 8px 40px rgba(0, 0, 0, 0.35),
          0 2px 8px rgba(0, 0, 0, 0.2);
      }

      #vz-context-menu.open {
        transform: scale(1);
        opacity: 1;
        pointer-events: all;
      }

      .ctx-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        color: rgba(255, 255, 255, 0.85);
        font-size: 13px;
        letter-spacing: 0.02em;
        cursor: none !important;
        border-radius: 8px;
        transition:
          background 0.12s ease,
          color 0.12s ease;
        white-space: nowrap;
        text-decoration: none;
      }

      .ctx-item:hover {
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 1);
      }

      .ctx-item i {
        width: 16px;
        text-align: center;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.4);
        flex-shrink: 0;
      }

      .ctx-item:hover i {
        color: rgba(255, 255, 255, 0.7);
      }

      .ctx-sep {
        height: 1px;
        background: rgba(255, 255, 255, 0.07);
        margin: 5px 6px;
      }

      .ctx-label {
        padding: 8px 12px 4px;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.3);
      }

      .ctx-item.danger:hover {
        background: rgba(255, 60, 0, 0.15);
        color: #ff3c00;
      }
      .ctx-item.danger:hover i {
        color: #ff3c00;
      }
    </style>
  </head>
  <body>
    <div id="vz-cursor" aria-hidden="true">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="airplane-svg"
      >
        <path
          d="M3 3 L3 20 L8.5 15 L16 15 Z"
          fill="#0a0a0a"
          stroke="#ffffff"
          stroke-width="1.5"
          stroke-linejoin="round"></path>
      </svg>
    </div>

    <div id="vz-context-menu" role="menu" aria-label="Menú contextual"></div>

    <WhatsAppFloat />

    <slot />

    <script>
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      document.addEventListener("astro:before-swap", () => {
        ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
      });

      let lenisInstance: any = null;

      document.addEventListener("astro:page-load", () => {
        // 1. Refresh ScrollTrigger
        ScrollTrigger.refresh();

        // 2. Destruir instancia anterior de Lenis si existe (para evitar bugs de Astro View Transitions)
        if (lenisInstance) {
          lenisInstance.destroy();
          lenisInstance = null;
        }

        // 3. Inicializar Lenis
        lenisInstance = new Lenis({
          duration: 1.15,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          wheelMultiplier: 0.9,
          touchMultiplier: 1.8,
        });

        // 4. Sincronizar Lenis con GSAP ScrollTrigger de forma irrompible
        lenisInstance.on("scroll", ScrollTrigger.update);

        gsap.ticker.add((time) => {
          lenisInstance.raf(time * 1000);
        });

        gsap.ticker.lagSmoothing(0);

        // Guardar globalmente para otros scripts si lo necesitan
        (window as any).lenisInstance = lenisInstance;
      });

      let mouseX = -100,
        mouseY = -100;

      let isTouch =
        window.matchMedia("(hover: none)").matches ||
        window.matchMedia("(pointer: coarse)").matches;

      document.addEventListener("astro:page-load", () => {
        const cursor = document.getElementById("vz-cursor");
        if (cursor) {
          if (isTouch) {
            cursor.style.display = "none";
          } else {
            document.documentElement.classList.add("js-cursor-active");
          }
        }

        const interactives = document.querySelectorAll(
          "a, button, input, textarea, [data-servicio]",
        );
        interactives.forEach((el) => {
          el.addEventListener("mouseenter", () => {
            if (!isTouch && cursor) cursor.classList.add("hovering");
          });
          el.addEventListener("mouseleave", () => {
            if (!isTouch && cursor) cursor.classList.remove("hovering");
          });
        });
      });

      window.addEventListener(
        "touchstart",
        () => {
          isTouch = true;
          const cursor = document.getElementById("vz-cursor");
          if (cursor) cursor.style.display = "none";
          document.documentElement.classList.remove("js-cursor-active");
        },
        { once: true, passive: true },
      );

      document.addEventListener(
        "mousemove",
        (e) => {
          if (isTouch) return;
          mouseX = e.clientX;
          mouseY = e.clientY;
          const cursor = document.getElementById("vz-cursor");

          if (cursor) {
            cursor.style.transform = `translate(${mouseX - 3}px, ${mouseY - 3}px)`;
            if (!cursor.classList.contains("visible")) {
              cursor.classList.add("visible");
            }
          }
        },
        { passive: true },
      );

      document.addEventListener("mouseleave", () => {
        if (isTouch) return;
        const cursor = document.getElementById("vz-cursor");
        if (cursor) cursor.classList.remove("visible");
      });
      document.addEventListener("mouseenter", () => {
        if (isTouch) return;
        const cursor = document.getElementById("vz-cursor");
        if (cursor) cursor.classList.add("visible");
      });
      document.addEventListener("mousedown", () => {
        if (isTouch) return;
        const cursor = document.getElementById("vz-cursor");
        if (cursor) cursor.classList.add("clicking");
      });
      document.addEventListener("mouseup", () => {
        if (isTouch) return;
        const cursor = document.getElementById("vz-cursor");
        if (cursor) cursor.classList.remove("clicking");
      });

      let ctxOpen = false;

      function buildMenuHTML(
        items: Array<{
          type: string;
          icon?: string;
          label?: string;
          href?: string;
          action?: string;
          danger?: boolean;
        }>,
      ): string {
        return items
          .map((item) => {
            if (item.type === "sep") return `<div class="ctx-sep"></div>`;
            if (item.type === "label")
              return `<div class="ctx-label">${item.label}</div>`;
            const href = item.href ? `href="${item.href}"` : "";
            const tag = item.href ? "a" : "button";
            const dangerCls = item.danger ? " danger" : "";
            const datAction = item.action ? `data-action="${item.action}"` : "";
            return `<${tag} class="ctx-item${dangerCls}" ${href} ${datAction} role="menuitem">
            <i class="${item.icon || "fa-regular fa-circle"}"></i>
            <span>${item.label}</span>
          </${tag}>`;
          })
          .join("");
      }

      function getContextItems(target: Element): Array<any> {
        const selText = window.getSelection()?.toString().trim();
        const hasSelection = selText && selText.length > 0;

        const link = target.closest("a") as HTMLAnchorElement | null;
        const img = target.closest("img") as HTMLImageElement | null;
        const isInput = target.closest("input, textarea, select");
        const isService = target.closest("[data-servicio]");
        const isSection = target.closest("section");

        if (hasSelection && !isInput) {
          const shortText =
            selText.length > 15 ? selText.substring(0, 15) + "..." : selText;
          return [
            { type: "label", label: "Texto seleccionado" },
            {
              type: "item",
              icon: "fa-regular fa-copy",
              label: "Copiar texto",
              action: "copy-sel",
            },
            {
              type: "item",
              icon: "fa-brands fa-google",
              label: `Buscar "${shortText}"`,
              action: "search-web",
            },
            { type: "sep" },
            {
              type: "item",
              icon: "fa-solid fa-arrow-right",
              label: "Ir al inicio",
              href: "/",
            },
          ];
        }

        if (link) {
          const href = link.href;
          const isExternal =
            href &&
            !href.includes("vezner.net") &&
            !href.startsWith("/") &&
            !href.startsWith("#");
          return [
            { type: "label", label: "Enlace" },
            {
              type: "item",
              icon: "fa-solid fa-arrow-up-right-from-square",
              label: isExternal ? "Abrir en nueva pestaña" : "Abrir enlace",
              href,
              action: "open-new",
            },
            {
              type: "item",
              icon: "fa-regular fa-copy",
              label: "Copiar URL",
              action: "copy-url",
              href,
            },
            { type: "sep" },
            { type: "label", label: "VEZNER" },
            {
              type: "item",
              icon: "fa-solid fa-house",
              label: "Inicio",
              href: "/",
            },
            {
              type: "item",
              icon: "fa-solid fa-list",
              label: "Servicios",
              href: "/#servicios",
            },
            {
              type: "item",
              icon: "fa-solid fa-users",
              label: "Nosotros",
              href: "/nosotros",
            },
            {
              type: "item",
              icon: "fa-solid fa-envelope",
              label: "Contacto",
              href: "/contacto",
            },
          ];
        }

        if (img) {
          return [
            { type: "label", label: "Imagen" },
            {
              type: "item",
              icon: "fa-regular fa-image",
              label: "Ver imagen",
              action: "view-img",
              href: img.src,
            },
            {
              type: "item",
              icon: "fa-regular fa-copy",
              label: "Copiar URL de imagen",
              action: "copy-img-url",
              href: img.src,
            },
            { type: "sep" },
            { type: "label", label: "VEZNER" },
            {
              type: "item",
              icon: "fa-solid fa-house",
              label: "Inicio",
              href: "/",
            },
            {
              type: "item",
              icon: "fa-solid fa-list",
              label: "Servicios",
              href: "/#servicios",
            },
            {
              type: "item",
              icon: "fa-solid fa-users",
              label: "Nosotros",
              href: "/nosotros",
            },
            {
              type: "item",
              icon: "fa-solid fa-envelope",
              label: "Contacto",
              href: "/contacto",
            },
          ];
        }

        if (isInput) {
          return [
            { type: "label", label: "Campo de texto" },
            {
              type: "item",
              icon: "fa-regular fa-paste",
              label: "Pegar",
              action: "paste",
            },
            {
              type: "item",
              icon: "fa-regular fa-copy",
              label: "Copiar selección",
              action: "copy-sel",
            },
            {
              type: "item",
              icon: "fa-solid fa-xmark",
              label: "Limpiar campo",
              action: "clear-input",
              danger: true,
            },
            { type: "sep" },
            { type: "label", label: "VEZNER" },
            {
              type: "item",
              icon: "fa-solid fa-house",
              label: "Inicio",
              href: "/",
            },
            {
              type: "item",
              icon: "fa-solid fa-list",
              label: "Servicios",
              href: "/#servicios",
            },
            {
              type: "item",
              icon: "fa-solid fa-users",
              label: "Nosotros",
              href: "/nosotros",
            },
            {
              type: "item",
              icon: "fa-solid fa-envelope",
              label: "Contacto",
              href: "/contacto",
            },
          ];
        }

        if (isService) {
          const servEl = isService as HTMLElement;
          return [
            {
              type: "label",
              label: servEl.dataset.servicio?.toUpperCase() || "SERVICIO",
            },
            {
              type: "item",
              icon: "fa-solid fa-arrow-right",
              label: "Ver servicio",
              href: servEl.dataset.href || "/#servicios",
            },
            {
              type: "item",
              icon: "fa-solid fa-envelope",
              label: "Solicitar presupuesto",
