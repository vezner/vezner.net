---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post: CollectionEntry<'blog'>) => ({
		params: { slug: post.slug },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await post.render();
---

<Layout title={`${post.data.title} — VEZNER`} description={post.data.description}>
  <Header theme="light" />

  <main class="bg-blanco text-negro min-h-screen pt-32 pb-20">
    <article class="px-6 md:px-16">
      <div class="max-w-4xl mx-auto">
        <!-- Encabezado -->
        <header class="mb-12">
          <div class="flex items-center gap-4 font-mono text-xs uppercase tracking-widest text-negro/40 mb-6">
            <a href="/blog" class="hover:text-negro transition-colors">&larr; Volver al blog</a>
            <span>/</span>
            <time datetime={post.data.pubDate.toISOString()}>
              {
                post.data.pubDate.toLocaleDateString('es-AR', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })
              }
            </time>
          </div>
          <h1 class="font-display text-[clamp(40px,6vw,80px)] leading-[0.9] text-negro mb-6">
            {post.data.title}
          </h1>
          <p class="font-mono text-sm md:text-base text-negro/60 leading-relaxed max-w-2xl">
            {post.data.description}
          </p>
        </header>

        {post.data.heroImage && (
          <div class="w-full aspect-[16/9] md:aspect-[21/9] mb-16 overflow-hidden bg-negro/5 border border-negro/10">
            <img 
              src={post.data.heroImage} 
              alt={post.data.title}
              class="w-full h-full object-cover"
            />
          </div>
        )}

        <!-- Contenido Markdown -->
        <div class="blog-content max-w-3xl mx-auto">
          <Content />
        </div>
        
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mt-16 pt-8 border-t border-negro/10 max-w-3xl mx-auto flex flex-wrap gap-2">
            {post.data.tags.map((tag: string) => (
              <span class="px-3 py-1 bg-negro/5 text-negro font-mono text-[10px] uppercase tracking-widest border border-negro/10">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  .blog-content h1, .blog-content h2, .blog-content h3, .blog-content h4 {
    font-family: 'Space Grotesk', sans-serif; /* Fallback si usas otra font-display */
    color: #000;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  .blog-content h2 { font-size: 2rem; }
  .blog-content h3 { font-size: 1.5rem; }
  
  .blog-content p, .blog-content li {
    font-family: 'JetBrains Mono', monospace; /* Fallback */
    font-size: 0.875rem; /* text-sm */
    line-height: 1.75;
    color: rgba(0, 0, 0, 0.7);
    margin-bottom: 1.25rem;
  }
  
  .blog-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  
  .blog-content ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  
  .blog-content a {
    color: #000;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 0.3s;
  }
  .blog-content a:hover {
    opacity: 0.6;
  }
  
  .blog-content blockquote {
    border-left: 2px solid #000;
    padding-left: 1rem;
    margin-left: 0;
    font-style: italic;
    color: rgba(0, 0, 0, 0.5);
  }
  
  .blog-content img {
    max-width: 100%;
    height: auto;
    border: 1px solid rgba(0,0,0,0.1);
    margin: 2rem 0;
  }
  
  .blog-content pre {
    background-color: rgba(0,0,0,0.05);
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
    font-size: 0.75rem;
  }
  
  .blog-content code {
    background-color: rgba(0,0,0,0.05);
    padding: 0.2em 0.4em;
    font-size: 0.8em;
  }
  
  .blog-content pre code {
    background-color: transparent;
    padding: 0;
  }
</style>
