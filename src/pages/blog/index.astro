---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
	(a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Blog — VEZNER"
  description="Artículos, tutoriales y reflexiones sobre ingeniería digital, marketing y tecnología."
>
  <Header theme="light" />

  <main class="bg-blanco text-negro min-h-screen overflow-hidden pt-32 pb-20">
    <section class="relative px-6 md:px-16">
      <div class="relative z-10 w-full max-w-7xl mx-auto">
        <div class="mb-16">
          <h1 class="font-display text-[clamp(48px,8vw,100px)] leading-none text-negro uppercase">
            El Blog
          </h1>
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mt-6">
            <p class="font-mono text-sm text-negro/60 max-w-lg">
              Insights, tecnología y estrategias de crecimiento digital.
            </p>
            <div class="relative w-full md:w-72">
              <input 
                type="text" 
                id="blog-search" 
                placeholder="Buscar artículos..." 
                class="w-full bg-transparent border-b border-negro/20 py-2 pl-8 font-mono text-xs text-negro placeholder:text-negro/40 focus:outline-none focus:border-negro transition-colors"
              />
              <svg class="absolute left-0 top-1/2 -translate-y-1/2 w-4 h-4 text-negro/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="blog-grid">
          {
            posts.map((post: any) => {
              const searchContent = `${post.data.title} ${post.data.description}`;
              return (
                <a href={`/blog/${post.id}`} class="blog-card group block border border-negro/10 rounded-2xl bg-negro/[0.03] backdrop-blur-2xl hover:border-negro hover:rounded-none transition-safe duration-500 overflow-hidden relative transition-colors duration-300" data-search={searchContent} data-tags={post.data.tags ? post.data.tags.join(',').toLowerCase() : ''}>
                  <div class="aspect-[4/3] w-full overflow-hidden border-b border-negro/10">
                  <img
                    src={post.data.heroImage || '/og-image.webp'}
                    alt={post.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
                  />
                </div>
                <div class="p-6">
                  <div class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-negro/40 mb-4">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {
                        post.data.pubDate.toLocaleDateString('es-AR', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                        })
                      }
                    </time>
                  </div>
                  <h3 class="font-display text-2xl text-negro mb-3 leading-tight transition-colors">
                    {post.data.title}
                  </h3>
                  <p class="font-mono text-xs text-negro/60 line-clamp-3">
                    {post.data.description}
                  </p>
                </div>
                
                <div class="absolute bottom-0 left-0 h-0.5 bg-negro w-0 group-hover:w-full transition-colors duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"></div>
              </a>
              );
            })
          }
        </div>
        
        {posts.length === 0 && (
          <div class="py-20 border-t border-negro/10">
             <p class="font-mono text-sm text-negro/40">Próximamente nuevos artículos...</p>
          </div>
        )}

        
        <div id="pagination-controls" class="hidden mt-16 pt-8 border-t border-negro/10 flex items-center justify-center gap-2">
          
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const searchInput = document.getElementById('blog-search') as HTMLInputElement;
    const blogCards = document.querySelectorAll('.blog-card');
    const grid = document.getElementById('blog-grid');
    const paginationContainer = document.getElementById('pagination-controls');
    
    if (!searchInput || !grid || !paginationContainer) return;
    
    const ITEMS_PER_PAGE = 12;
    let currentPage = 1;
    let activeTag = '';
    let currentQuery = '';

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('tag')) {
      activeTag = urlParams.get('tag')?.toLowerCase() || '';
    }

    const normalizeText = (text: string) => {
      return text
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[.,\/#!$%\^&\*;:{}=\-_`~()]/g, "");
    };

    const updateView = () => {
      let filteredCards: HTMLElement[] = [];

      blogCards.forEach((card) => {
        const el = card as HTMLElement;
        const searchContent = el.getAttribute('data-search') || '';
        const tagsContent = el.getAttribute('data-tags') || '';
        const normalizedQuery = normalizeText(currentQuery);
        
        const matchesSearch = normalizedQuery === '' || normalizeText(searchContent).includes(normalizedQuery);
        const matchesTag = activeTag === '' || tagsContent.split(',').includes(activeTag);
        
        if (matchesSearch && matchesTag) {
          filteredCards.push(el);
        } else {
          el.style.display = 'none';
        }
      });

      let noResultsEl = document.getElementById('no-results-msg');
      if (filteredCards.length === 0) {
        if (!noResultsEl) {
          noResultsEl = document.createElement('div');
          noResultsEl.id = 'no-results-msg';
          noResultsEl.className = 'col-span-full py-20 text-center font-mono text-sm text-negro/40 border-t border-negro/10 mt-8';
          grid.appendChild(noResultsEl);
        }
        noResultsEl.textContent = activeTag ? `No se encontraron artículos con el tag "${activeTag.toUpperCase()}" o esa búsqueda.` : 'No se encontraron artículos con esa búsqueda.';
        noResultsEl.style.display = 'block';
        paginationContainer.classList.add('hidden');
        return;
      } else if (noResultsEl) {
        noResultsEl.style.display = 'none';
      }

      const totalPages = Math.ceil(filteredCards.length / ITEMS_PER_PAGE);
      if (currentPage > totalPages) currentPage = 1;
      
      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const endIndex = startIndex + ITEMS_PER_PAGE;
      
      filteredCards.forEach((el, index) => {
        if (index >= startIndex && index < endIndex) {
          el.style.display = 'block';
        } else {
          el.style.display = 'none';
        }
      });
      
      renderPagination(totalPages);
    };

    const renderPagination = (totalPages: number) => {
      paginationContainer.innerHTML = '';
      
      if (totalPages <= 1) {
        paginationContainer.classList.add('hidden');
        paginationContainer.classList.remove('flex');
        return;
      }
      
      paginationContainer.classList.remove('hidden');
      paginationContainer.classList.add('flex');

      const prevBtn = document.createElement('button');
      prevBtn.innerHTML = '&larr; Anterior';
      prevBtn.className = `font-mono text-xs tracking-widest uppercase px-4 py-2 transition-colors ${currentPage === 1 ? 'text-negro/20 cursor-not-allowed' : 'text-negro hover:bg-negro/5'}`;
      prevBtn.disabled = currentPage === 1;
      prevBtn.onclick = () => {
        if (currentPage > 1) {
          currentPage--;
          updateView();
          window.scrollTo({ top: grid.offsetTop - 100, behavior: 'smooth' });
        }
      };
      paginationContainer.appendChild(prevBtn);

      let startPage = Math.max(1, currentPage - 3);
      let endPage = Math.min(totalPages, currentPage + 3);
      
      if (endPage - startPage < 6) {
        if (startPage === 1) endPage = Math.min(totalPages, 7);
        else if (endPage === totalPages) startPage = Math.max(1, totalPages - 6);
      }
      
      for (let i = startPage; i <= endPage; i++) {
        const btn = document.createElement('button');
        btn.textContent = i.toString();
        if (i === currentPage) {
          btn.className = 'w-8 h-8 rounded-2xl bg-negro text-blanco font-mono text-xs flex items-center justify-center';
        } else {
          btn.className = 'w-8 h-8 rounded-2xl text-negro/50 hover:bg-negro/5 hover:rounded-none font-mono text-xs flex items-center justify-center transition-safe duration-300';
          btn.onclick = () => {
            currentPage = i;
            updateView();
            window.scrollTo({ top: grid.offsetTop - 100, behavior: 'smooth' });
          };
        }
        paginationContainer.appendChild(btn);
      }

      const nextBtn = document.createElement('button');
      nextBtn.innerHTML = 'Siguiente &rarr;';
      nextBtn.className = `font-mono text-xs tracking-widest uppercase px-4 py-2 transition-colors ${currentPage === totalPages ? 'text-negro/20 cursor-not-allowed' : 'text-negro hover:bg-negro/5'}`;
      nextBtn.disabled = currentPage === totalPages;
      nextBtn.onclick = () => {
        if (currentPage < totalPages) {
          currentPage++;
          updateView();
          window.scrollTo({ top: grid.offsetTop - 100, behavior: 'smooth' });
        }
      };
      paginationContainer.appendChild(nextBtn);
    };

    searchInput.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      currentQuery = target.value;
      currentPage = 1; 
      updateView();
    });

    updateView();
  });
</script>

