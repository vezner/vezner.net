              cwpCards[0].querySelector(".cwp-card-darken"),
              { opacity: 0.6 },
              { opacity: 0.75, duration: 2, ease: "none" },
              14,
            );

          cwpTl.to({}, { duration: 2 });

          cwpTl
            .to(".cwp-img-3-1", { scale: 1.05, duration: 2, ease: "none" }, 18)
            .fromTo(
              ".cwp-img-3-2",
              { opacity: 0, scale: 1.05 },
              { opacity: 1, scale: 1, duration: 2, ease: "none" },
              18,
            )
            .fromTo(
              ".cwp-text-3-1",
              { opacity: 1, y: 0 },
              { opacity: 0, y: -20, duration: 2, ease: "none" },
              18,
            )
            .fromTo(
              ".cwp-text-3-2",
              { opacity: 0, y: 15 },
              { opacity: 1, y: 0, duration: 2, ease: "none" },
              18,
            );

          cwpTl.to({}, { duration: 2 });

          cwpTl
            .fromTo(
              cwpCards[3],
              { y: "150%" },
              { y: "0%", duration: 2, ease: "none" },
              22,
            )
            .fromTo(
              cwpCards[2],
              { scale: 1 },
              { scale: 0.94, duration: 2, ease: "none" },
              22,
            )
            .fromTo(
              cwpCards[2].querySelector(".cwp-card-darken"),
              { opacity: 0 },
              { opacity: 0.6, duration: 2, ease: "none" },
              22,
            )
            .fromTo(
              cwpCards[1],
              { scale: 0.94 },
              { scale: 0.88, duration: 2, ease: "none" },
              22,
            )
            .fromTo(
              cwpCards[1].querySelector(".cwp-card-darken"),
              { opacity: 0.6 },
              { opacity: 0.75, duration: 2, ease: "none" },
              22,
            )
            .fromTo(
              cwpCards[0],
              { scale: 0.88 },
              { scale: 0.82, duration: 2, ease: "none" },
              22,
            )
            .fromTo(
              cwpCards[0].querySelector(".cwp-card-darken"),
              { opacity: 0.75 },
              { opacity: 0.85, duration: 2, ease: "none" },
              22,
            );

          cwpTl.to({}, { duration: 2 });

          cwpTl
            .to(".cwp-img-4-1", { scale: 1.05, duration: 2, ease: "none" }, 26)
            .fromTo(
              ".cwp-img-4-2",
              { opacity: 0, scale: 1.05 },
              { opacity: 1, scale: 1, duration: 2, ease: "none" },
              26,
            )
            .fromTo(
              ".cwp-text-4-1",
              { opacity: 1, y: 0 },
              { opacity: 0, y: -20, duration: 2, ease: "none" },
              26,
            )
            .fromTo(
              ".cwp-text-4-2",
              { opacity: 0, y: 15 },
              { opacity: 1, y: 0, duration: 2, ease: "none" },
              26,
            );

          cwpTl.to({}, { duration: 2 });
        } else {
          gsap.set(cwpCards, {
            position: "relative",
            y: 0,
            height: "auto",
            marginBottom: "2rem",
          });
          gsap.set(".cwp-cards-wrapper", { height: "auto" });
          gsap.set(".cwp-pin-container", {
            height: "auto",
            display: "block",
            padding: "100px 0",
          });

          cwpCards.forEach((card: any) => {
            gsap.set(card.querySelectorAll("img, div"), {
              opacity: 1,
              position: "relative",
              y: 0,
              scale: 1,
            });
            gsap.set(card.querySelectorAll(".absolute"), {
              position: "relative",
            });
          });
        }
      }
    });
  </script>

  <style is:global>
