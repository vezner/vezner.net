  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    import * as THREE from "three";
    import { DotLottie } from "@lottiefiles/dotlottie-web";

    document.addEventListener("astro:page-load", () => {
      gsap.registerPlugin(ScrollTrigger);

      const heroCanvas = document.getElementById(
        "hero-canvas",
      ) as HTMLCanvasElement;
      const isDesktop = window.matchMedia("(min-width: 768px)").matches;

      if (heroCanvas && isDesktop) {
        const renderer = new THREE.WebGLRenderer({
          canvas: heroCanvas,
          antialias: true,
          alpha: true,
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.setSize(window.innerWidth, window.innerHeight);

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(
          45,
          window.innerWidth / window.innerHeight,
          0.1,
          100,
        );
        camera.position.set(0, 0, 10);

        // Luces Difuminadas (Halos suaves)
        const lights: any[] = [];
        const colors = [
          { hex: 0x00ff73, css: "rgba(0, 255, 115, 1)" },
          { hex: 0xff005c, css: "rgba(255, 0, 92, 1)" },
          { hex: 0xffcc00, css: "rgba(255, 204, 0, 1)" },
          { hex: 0x00aaff, css: "rgba(0, 170, 255, 1)" },
        ];

        // Función para crear textura de halo difuminado
        function createGlowTexture(colorStr: string) {
          const canvas = document.createElement("canvas");
          canvas.width = 256;
          canvas.height = 256;
          const ctx = canvas.getContext("2d")!;
          const gradient = ctx.createRadialGradient(128, 128, 0, 128, 128, 128);
          gradient.addColorStop(0, colorStr);
          gradient.addColorStop(0.5, colorStr.replace("1)", "0.5)"));
          gradient.addColorStop(1, "rgba(0,0,0,0)");
          ctx.fillStyle = gradient;
          ctx.fillRect(0, 0, 256, 256);
          return new THREE.CanvasTexture(canvas);
        }

        colors.forEach((col) => {
          const spriteMat = new THREE.SpriteMaterial({
            map: createGlowTexture(col.css),
            color: 0xffffff,
            transparent: true,
            blending: THREE.AdditiveBlending,
            depthWrite: false,
          });
          const sprite = new THREE.Sprite(spriteMat);

          sprite.scale.set(40, 40, 1);

          sprite.position.set(
            (Math.random() - 0.5) * 30,
            (Math.random() - 0.5) * 30,
            -20,
          );
          scene.add(sprite);

          lights.push({
            mesh: sprite,
            angX: Math.random() * Math.PI * 2,
            angY: Math.random() * Math.PI * 2,
            speed: 0.1 + Math.random() * 0.1,
            radius: 10 + Math.random() * 10,
          });
        });

        window.addEventListener("resize", () => {
          camera.aspect = window.innerWidth / window.innerHeight;
          camera.updateProjectionMatrix();
          renderer.setSize(window.innerWidth, window.innerHeight);
        });

        const reloj = new THREE.Clock();

        function animarThree() {
          if (!document.body.contains(heroCanvas)) return; // Stop loop on page leave
          requestAnimationFrame(animarThree);
          const t = reloj.getElapsedTime();

          // Mover las luces en órbitas caóticas de forma autónoma y fluida
          lights.forEach((l, i) => {
            l.angX += l.speed * 0.005;
            l.angY += l.speed * 0.007;
            l.mesh.position.x = Math.cos(l.angX) * l.radius;
            l.mesh.position.y = Math.sin(l.angY) * l.radius;
          });

          renderer.render(scene, camera);
        }

        // Render the first frame immediately so it's not blank
        renderer.render(scene, camera);

        // Defer the heavy WebGL animation loop until user interaction to bypass Lighthouse CPU throttling
        let threeStarted = false;
        const startThree = () => {
          if (threeStarted) return;
          threeStarted = true;
          animarThree();
        };

        ["scroll", "mousemove", "touchstart"].forEach((evt) => {
          window.addEventListener(evt, startThree, {
            once: true,
            passive: true,
          });
        });
        setTimeout(startThree, 4000);
      }

      const tl = gsap.timeline({ delay: 0.5 }); // CSS anim handles hero text now, JS kicks in after
      tl.to(
        ".hero-line",
        { scaleX: 1, duration: 0.7, ease: "power3.out", stagger: 0.1 },
        "-=0.6",
      );
      tl.to(
        "#hero-tag",
        { opacity: 1, duration: 0.6, ease: "power3.out" },
        "-=0.5",
      );
      tl.to(
        "#hero-sub",
        { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" },
        "-=0.4",
      );
      tl.to(
        "#hero-ctas",
        { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" },
        "-=0.5",
      );
      tl.to(
        "#hero-side-info",
        { opacity: 1, duration: 0.7, ease: "power3.out" },
        "-=0.4",
      );
      tl.to(
        "#scroll-indicator",
        { opacity: 1, duration: 0.6, ease: "power3.out" },
        "-=0.3",
      );

      gsap.to(".manifiesto-top-line", {
        scaleX: 1,
        duration: 1.5,
        ease: "power3.out",
        scrollTrigger: { trigger: "#manifiesto", start: "top 80%", once: true },
      });

      gsap.to(".manifesto-label", {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: { trigger: "#manifiesto", start: "top 75%", once: true },
      });

      document.querySelectorAll(".manifesto-reveal").forEach((el, i) => {
        gsap.to(el, {
          y: "0%",
          duration: 1.1,
          ease: "power4.out",
          delay: i * 0.06,
          scrollTrigger: {
            trigger: el.parentElement,
            start: "top 88%",
            once: true,
          },
        });
      });

      gsap.to(".manifesto-body", {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: "power3.out",
        scrollTrigger: {
          trigger: ".manifesto-body",
          start: "top 82%",
          once: true,
        },
      });

      gsap.to(".manifesto-stats", {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: "power3.out",
        scrollTrigger: {
          trigger: ".manifesto-stats",
          start: "top 88%",
          once: true,
        },
      });

      const manifestoAsset = document.querySelector(".manifesto-lottie");
      if (manifestoAsset) {
        ScrollTrigger.create({
          trigger: "#manifiesto",
          start: "top 70%",
          once: true,
          onEnter: () => {
            gsap.to(".manifesto-lottie", {
              opacity: 1,
              scale: 1,
              duration: 1.2,
              ease: "power3.out",
              delay: 0.4,
            });
          },
        });
      }

      gsap.to(".proceso-label", {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: { trigger: "#proceso", start: "top 80%", once: true },
      });

      gsap.to(".proceso-title", {
        y: "0%",
        duration: 1.1,
        ease: "power4.out",
        scrollTrigger: {
          trigger: ".proceso-title",
          start: "top 85%",
          once: true,
        },
      });

      gsap.to(".proceso-desc", {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: {
          trigger: ".proceso-desc",
          start: "top 85%",
          once: true,
        },
      });

      document.querySelectorAll(".proceso-step").forEach((step, i) => {
        gsap.to(step, {
          opacity: 1,
          y: 0,
          duration: 0.7,
          ease: "power3.out",
          scrollTrigger: { trigger: step, start: "top 88%", once: true },
        });
      });

      gsap.to(".cta-eyebrow", {
        opacity: 1,
        y: 0,
        duration: 0.7,
        ease: "power3.out",
        scrollTrigger: { trigger: "#cta-final", start: "top 75%", once: true },
      });

      gsap.to(".cta-main", {
        y: "0%",
        duration: 1.1,
        ease: "power4.out",
        scrollTrigger: { trigger: ".cta-main", start: "top 80%", once: true },
      });

      gsap.to(".cta-body-wrap", {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: "power3.out",
        scrollTrigger: {
          trigger: ".cta-body-wrap",
          start: "top 82%",
          once: true,
        },
      });

      gsap.to("#servicios-label", {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: { trigger: "#servicios", start: "top 80%", once: true },
      });

      gsap.utils.toArray(".servicio-card-simple").forEach((el, i) => {
        gsap.to(el as HTMLElement, {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: "power3.out",
          delay: i * 0.1,
          scrollTrigger: {
            trigger: "#servicios",
            start: "top 70%",
            once: true,
          },
        });
      });

      // Empresas section animations
      gsap.to("#empresas-label", {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: {
          trigger: "#empresas-label",
          start: "top 85%",
          once: true,
        },
      });

      gsap.to("#empresas-title", {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: "power3.out",
        delay: 0.1,
        scrollTrigger: {
          trigger: "#empresas-label",
          start: "top 85%",
          once: true,
        },
      });

      gsap.utils.toArray(".empresas-card").forEach((el, i) => {
        gsap.to(el as Element, {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: "power3.out",
          delay: i * 0.1,
          scrollTrigger: {
            trigger: ".empresas-card",
            start: "top 80%",
            once: true,
          },
        });
      });
    });
  </script>

  <style is:global>
    .proceso-step:hover .proceso-num {
      color: var(--hover-c);
    }
  </style>

  <script>
    document.addEventListener("astro:page-load", () => {
      const urlParams = new URLSearchParams(window.location.search);
      const empresa = urlParams.get("e") || urlParams.get("empresa");

      if (empresa && !sessionStorage.getItem(`vz_trk_full_${empresa}`)) {
        sessionStorage.setItem(`vz_trk_full_${empresa}`, "true");

        const startTime = Date.now();
        let maxScroll = 0;
        let geoData: any = {
          ip: "Calculando...",
          country: "Desconocido",
          city: "Desconocida",
          organization: "Desconocido",
        };

        // Forzar IPv4 usando el subdominio ipv4 de geojs
        fetch("https://ipv4.geojs.io/v1/ip/geo.json")
          .then((res) => res.json())
          .then((geo) => {
            geoData = geo;
          })
          .catch(() => {});

        window.addEventListener(
          "scroll",
          () => {
            maxScroll = Math.max(maxScroll, window.scrollY);
          },
          { passive: true },
        );

        const sendData = async () => {
          if (document.visibilityState !== "hidden") return;

          document.removeEventListener("visibilitychange", sendData);

          const timeSpentSeconds = Math.round((Date.now() - startTime) / 1000);
          const scrollableHeight = Math.max(
            1,
            document.body.scrollHeight - window.innerHeight,
          );
          const scrollPercent = Math.min(
            100,
            Math.round((maxScroll / scrollableHeight) * 100),
          );

          let batteryStr = "No disponible";
          try {
            if ((navigator as any).getBattery) {
              const bat = await (navigator as any).getBattery();
              batteryStr = `${Math.round(bat.level * 100)}% ${bat.charging ? "(Cargando)" : "(Desenchufado)"}`;
            }
          } catch (e) {}

          const connection = (navigator as any).connection;
          const network = connection ? connection.effectiveType : "Desconocida";

          const darkMode = window.matchMedia("(prefers-color-scheme: dark)")
            .matches
            ? "Sí"
            : "No";
          const referrer = document.referrer || "Directo / Desconocido";

          const payload = {
            Empresa: empresa,
            Fecha: new Date().toLocaleString("es-AR", {
              timeZone: "America/Argentina/Buenos_Aires",
            }),
            IP: geoData.ip,
            Proveedor_Internet:
              geoData.organization_name ||
              geoData.organization ||
              "Desconocido",
            Ubicacion: `${geoData.city}, ${geoData.country}`,
            Tiempo_En_Sitio: `${Math.floor(timeSpentSeconds / 60)}m ${timeSpentSeconds % 60}s`,
            Profundidad_Scroll: `${scrollPercent}%`,
            Origen_Visita: referrer,
            Pantalla: `${window.screen.width}x${window.screen.height}`,
            Sistema_Operativo: navigator.platform,
            Idioma: navigator.language,
            Modo_Oscuro: darkMode,
            Red: network,
            Bateria: batteryStr,
            URL_Visitada: window.location.href,
            UserAgent: navigator.userAgent,
          };

          fetch("https://formspree.io/f/mwvdjvaz", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(payload),
            keepalive: true,
          }).catch(() => {});
        };

        document.addEventListener("visibilitychange", sendData);
      }
    });
  </script>
</Layout>
