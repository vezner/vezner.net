  <script>
    document.addEventListener("astro:page-load", () => {
      const servTitle = document.getElementById("servicios-title");
      const dynLinks = document.querySelectorAll(".servicio-dyn-link");

      let lastSlug = "";

      document.addEventListener("map-province-clicked", (e: any) => {
        const { slug, name, element } = e.detail;

        if (!servTitle || !dynLinks.length) return;

        servTitle.style.opacity = "0";
        dynLinks.forEach((link) => {
          const provSpan = link.querySelector(".prov-name");
          if (provSpan) (provSpan as HTMLElement).style.opacity = "0";
        });

        setTimeout(() => {
          if (lastSlug === slug) {
            lastSlug = "";
            servTitle.textContent = "Nuestros Servicios";
            dynLinks.forEach((link) => {
              const baseHref = link.getAttribute("data-base-href");
              if (baseHref) link.setAttribute("href", baseHref);
            });
            document
              .querySelectorAll(".province")
              .forEach((p) => p.classList.remove("active-province"));
          } else {
            lastSlug = slug;
            servTitle.textContent = `Servicios en ${name}`;
            dynLinks.forEach((link) => {
              const baseHref = link.getAttribute("data-base-href");
              if (baseHref) link.setAttribute("href", `${baseHref}/${slug}`);
              const provSpan = link.querySelector(".prov-name");
              if (provSpan) {
                provSpan.textContent = ` en ${name}`;
                (provSpan as HTMLElement).style.opacity = "1";
              }
            });
            document
              .querySelectorAll(".province")
              .forEach((p) => p.classList.remove("active-province"));
            element.classList.add("active-province");
          }
          servTitle.style.opacity = "1";
        }, 300);
      });
    });
  </script>

  <script>
    document.addEventListener("astro:page-load", async () => {
      const SPAM_KEY = "trk_cooldown";
      const COOLDOWN_MINUTES = 30;
      const lastSent = localStorage.getItem(SPAM_KEY);

      if (
        lastSent &&
        Date.now() - parseInt(lastSent) < COOLDOWN_MINUTES * 60 * 1000
      ) {
        return;
      }

      localStorage.setItem(SPAM_KEY, Date.now().toString());

      const urlParams = new URLSearchParams(window.location.search);
      const paramsExtraidos = Object.fromEntries(urlParams.entries());
      const empresa =
        urlParams.get("e") || urlParams.get("empresa") || "Sin Empresa";

      let geoData: any = {
        ip: "Desconocida",
        country: "Desconocido",
        city: "Desconocida",
        organization: "Desconocido",
      };
      try {
        const geoRes = await fetch("https://ipv4.geojs.io/v1/ip/geo.json");
        if (geoRes.ok) geoData = await geoRes.json();
      } catch (e) {}

      let batteryStr = "No disponible";
      try {
        if ((navigator as any).getBattery) {
          const bat = await (navigator as any).getBattery();
          batteryStr = `${Math.round(bat.level * 100)}% ${bat.charging ? "(Cargando)" : "(Desenchufado)"}`;
        }
      } catch (e) {}

      const connection = (navigator as any).connection;
      const network = connection ? connection.effectiveType : "Desconocida";
      const darkMode = window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "Sí"
        : "No";
      const referrer = document.referrer || "Directo / URL Escrita";

      let tipoTrafico = "Directo";
      const refLower = referrer.toLowerCase();
      if (
        refLower.includes("google") ||
        refLower.includes("bing") ||
        refLower.includes("yahoo")
      ) {
        tipoTrafico = "Orgánico (Buscador)";
      } else if (
        refLower.includes("facebook") ||
        refLower.includes("instagram") ||
        refLower.includes("t.co") ||
        refLower.includes("linkedin")
      ) {
        tipoTrafico = "Social (Redes)";
      } else if (referrer) {
        tipoTrafico = "Referido (Otro Sitio)";
      }

      const payload = {
        ...paramsExtraidos,
        Empresa: empresa,
        Tipo_Trafico: tipoTrafico,
        Origen_Referrer: referrer,

        Fecha_Ingreso: new Date().toLocaleString("es-AR", {
          timeZone: "America/Argentina/Buenos_Aires",
        }),
        Pantalla_Resolucion: `${window.screen.width}x${window.screen.height}`,
        Ventana_Real: `${window.innerWidth}x${window.innerHeight}`,
        Sistema_Operativo: navigator.platform,
        Idioma: navigator.language,
        Modo_Oscuro: darkMode,
        Bateria: batteryStr,
        Red_Conexion: network,
        UserAgent: navigator.userAgent,
        URL_Visitada: window.location.href,

        IP: geoData.ip,
        Proveedor_ISP:
          geoData.organization_name || geoData.organization || "Desconocido",
        Ubicacion: `${geoData.city}, ${geoData.country}`,
      };

      fetch("https://formspree.io/f/mwvdjvaz", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(payload),
      }).catch(() => {});
    });
  </script>
</Layout>
