---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CardServicio from "../components/CardServicio.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import InteractiveMap from "../components/InteractiveMap.astro";
import { seoRubros } from "../data/seoRubros.js";
import { getCollection } from "astro:content";

const rubrosUnicos = Array.from(
  new Map(seoRubros.map((r) => [r.nombreRubro, r])).values(),
);
---

<Layout
  title="VEZNER — Diseño web en Argentina · Software Python · Automatización · Sitios y sistemas para empresas"
  description="VEZNER diseña y construye infraestructura digital de alta gama. Desarrollo de páginas web a medida, software Python, automatización de procesos y branding corporativo en Buenos Aires, Córdoba, Rosario, Mendoza, Santa Fe y toda Argentina."
  keywords="agencia digital Argentina, diseño web, diseño web córdoba, diseño web buenos aires, desarrollo web a medida rosario, diseño web santa fe, software python empresas mendoza, desarrollo de software a medida caba, automatización de procesos neuquén, diseño de identidad visual tucumán, VEZNER, páginas web premium, tiendas online argentina"
  canonicalUrl="/"
>
  <Header />

  <main id="main-content">
    <div id="vezner-preloader" class="hidden md:block fixed inset-0 z-[9999] bg-blanco overflow-hidden pointer-events-none">
      <canvas id="preloader-lights-canvas" class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true"></canvas>
      <div class="absolute inset-0 pointer-events-none z-0 opacity-[0.025]" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;); background-size: 256px 256px;"></div>

      <div id="preloader-lottie-container" class="absolute w-[250px] h-[250px] opacity-0">
        <canvas id="preloader-lottie-canvas" class="w-full h-full block"></canvas>
      </div>
      <h2 id="preloader-somos" class="absolute font-display text-[25vw] md:text-[15vw] text-negro opacity-0 whitespace-nowrap">SOMOS</h2>
      <img id="preloader-vezner-text" src="/assets/vezner-text.webp" alt="VEZNER" class="absolute h-[80px] md:h-[130px] w-auto opacity-0" />
    </div>

    <section
      id="hero"
      class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden bg-blanco"
    >
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div
          class="absolute top-[-10%] right-[-5%] w-[40vw] h-[40vw] bg-negro/5 rounded-full blur-[80px] animate-pulse"
        >
        </div>
        <div
          class="absolute bottom-[-10%] left-[-5%] w-[50vw] h-[50vw] bg-negro/5 rounded-full blur-[100px] animate-pulse"
          style="animation-delay: 2s;"
        >
        </div>
      </div>
      <canvas
        id="hero-canvas"
        class="hidden md:block absolute inset-0 w-full h-full pointer-events-none"
        aria-hidden="true"></canvas>

      <div
        class="absolute inset-0 pointer-events-none z-0 opacity-[0.025]"
        style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;); background-size: 256px 256px;"
      >
      </div>

      <!-- Desktop Hero -->
      <div
        class="hidden md:grid grid-cols-2 relative z-10 text-left px-8 md:px-16 w-full mt-12 md:mt-0 h-full min-h-screen items-center"
      >
        <div class="flex flex-col justify-center">
          <div
            class="hero-tag-anim mb-6 md:mb-8 flex items-center justify-start gap-4"
            style="opacity:0;"
          >
            <span
              class="font-mono text-[10px] md:text-sm tracking-[0.4em] uppercase text-negro/60"
              >Agencia de Ingeniería Digital</span
            >
            <div
              class="hero-line w-12 md:w-32 h-px bg-negro/30 origin-left scale-x-0"
            >
            </div>
          </div>

          <h1
            class="relative font-display leading-[1.1] tracking-tight text-negro overflow-hidden pt-4 -mt-4"
            style="font-size: clamp(48px, 14vw, 180px);"
          >
            <span class="hero-word block css-hero-anim">DISEÑO WEB</span>
            <span class="hero-word block css-hero-anim text-negro/80"
              >& SOFTWARE</span
            >
          </h1>

          <div
            class="hero-sub-anim mt-6 md:mt-10"
            style="opacity:0; transform: translateY(16px);"
          >
            <p
              class="font-mono text-sm md:text-base tracking-[0.15em] uppercase text-negro/50 max-w-2xl leading-relaxed"
            >
              Construimos la infraestructura digital<br
                class="hidden md:block"
              />
              que hace que las empresas <span class="text-negro/90 font-medium"
                >escalen.</span
              >
            </p>
          </div>

          <div
            class="hero-ctas-anim mt-10 md:mt-14 flex flex-col items-start gap-6 md:gap-8"
            style="opacity:0; transform: translateY(20px);"
          >
            <div
              class="flex flex-col sm:flex-row items-start sm:items-center justify-start gap-4"
            >
              <a
                href="https://wa.me/5493513323272?text=Hola%20VEZNER,%20quiero%20cotizar%20un%20proyecto"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary group relative inline-flex items-center gap-3 bg-negro text-blanco px-8 md:px-10 py-4 font-mono text-[10px] md:text-xs tracking-widest uppercase overflow-hidden hover:rounded-none transition-[border-radius] duration-300 border border-transparent rounded-2xl w-auto justify-center"
              >
                <span class="relative z-10 flex items-center gap-2"
                  ><i class="fa-brands fa-whatsapp text-base"></i> Cotizar Ahora</span
                >
                <span
                  class="absolute inset-0 bg-[#25D366] translate-x-[-101%] group-hover:translate-x-0 transition-transform duration-400 ease-out z-0"
                ></span>
              </a>
              <a
                href="#servicios"
                class="btn-secondary group relative inline-flex items-center gap-3 border border-negro/50 text-negro px-8 md:px-10 py-4 font-mono text-[10px] md:text-xs tracking-widest uppercase overflow-hidden hover:border-negro hover:rounded-none transition-colors duration-300 rounded-2xl w-auto justify-center"
              >
                <span
                  class="relative z-10 group-hover:text-blanco transition-colors duration-300"
                  >Ver Servicios</span
                >
                <span
                  class="relative z-10 group-hover:text-blanco transition-colors duration-300"
                  >↓</span
                >
                <span
                  class="absolute inset-0 bg-negro translate-y-[101%] group-hover:translate-y-0 transition-transform duration-350 ease-out z-0"
                ></span>
              </a>
            </div>
            <div
              class="flex items-center justify-start gap-6 text-xs font-mono text-negro/50"
            >
              <span class="flex items-center gap-1.5"
                ><i class="fa-solid fa-check text-[#00c851]"></i> Alta Gama</span
              >
              <span class="flex items-center gap-1.5"
                ><i class="fa-solid fa-bolt text-yellow-500"></i> Máximo Rendimiento</span
              >
            </div>
          </div>
        </div>

        <div
          class="flex items-center justify-end w-full h-full p-4 lg:p-12 pr-0 select-none overflow-hidden"
        >
        </div>
      </div>

      <div
        class="md:hidden relative z-10 text-center px-6 max-w-6xl mx-auto flex flex-col items-center justify-center h-full min-h-[80vh]"
      >
        <div
          class="hero-tag-anim mb-8 flex items-center justify-center gap-3"
          style="opacity:0;"
        >
          <div class="hero-line w-8 h-px bg-negro/30 origin-right scale-x-0">
          </div>
          <span
            class="font-mono text-[10px] tracking-[0.4em] uppercase text-negro/50"
            >Ingeniería Digital</span
          >
          <div class="hero-line w-8 h-px bg-negro/30 origin-left scale-x-0">
          </div>
        </div>

        <h1
          class="relative font-display leading-none tracking-tight text-negro overflow-hidden"
          style="font-size: clamp(60px, 20vw, 120px);"
        >
          <span class="hero-word block css-hero-anim">VEZNER</span>
        </h1>

        <div
          class="hero-sub-anim mt-6"
          style="opacity:0; transform: translateY(16px);"
        >
          <p
            class="font-mono text-[11px] tracking-[0.15em] uppercase text-negro/40 max-w-sm mx-auto leading-relaxed px-4"
          >
            Construimos la infraestructura digital que hace que los negocios <span
              class="text-negro/80 font-medium">escalen.</span
            >
          </p>
        </div>

        <div
          class="hero-ctas-anim mt-10 flex flex-col items-center justify-center gap-4 w-full"
          style="opacity:0; transform: translateY(20px);"
        >
          <a
            href="https://wa.me/5493513323272?text=Hola%20VEZNER,%20quiero%20cotizar%20un%20proyecto"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary group relative inline-flex items-center gap-3 bg-negro text-blanco px-8 py-4 font-mono text-[10px] tracking-widest uppercase overflow-hidden hover:rounded-none transition-[border-radius] duration-300 border border-transparent rounded-2xl w-full justify-center"
          >
            <span class="relative z-10 flex items-center gap-2"
              ><i class="fa-brands fa-whatsapp text-base"></i> Cotizar Ahora</span
            >
            <span
              class="absolute inset-0 bg-[#25D366] translate-x-[-101%] group-hover:translate-x-0 transition-transform duration-400 ease-out z-0"
            ></span>
          </a>
          <a
            href="#servicios"
            class="btn-secondary group relative inline-flex items-center gap-3 border border-negro/50 text-negro px-8 py-4 font-mono text-[10px] tracking-widest uppercase overflow-hidden hover:border-negro hover:rounded-none transition-colors duration-300 rounded-2xl w-full justify-center"
          >
            <span
              class="relative z-10 group-hover:text-blanco transition-colors duration-300"
              >Ver Servicios</span
            >
            <span
              class="relative z-10 group-hover:text-blanco transition-colors duration-300"
              >↓</span
            >
            <span
              class="absolute inset-0 bg-negro translate-y-[101%] group-hover:translate-y-0 transition-transform duration-350 ease-out z-0"
            ></span>
          </a>
        </div>
      </div>

      <div
        id="scroll-indicator"
        class="absolute bottom-8 right-12 hidden lg:flex flex-col items-center gap-2"
        style="opacity:0;"
      >
        <span class="font-mono text-xs tracking-[0.3em] uppercase text-negro/30"
          >Scroll</span
        >
        <div class="w-px h-14 bg-negro/10 relative overflow-hidden">
          <div
            class="scroll-pulse absolute top-0 left-0 w-full bg-negro"
            style="height: 40%; animation: scrollPulse 2s ease-in-out infinite;"
          >
          </div>
        </div>
      </div>
    </section>

    <div
      class="ticker-wrap bg-negro overflow-hidden py-5 border-y border-blanco/5"
    >
      <div
        id="ticker-inner"
        class="ticker-inner flex gap-0 whitespace-nowrap select-none"
      >
        {
          Array.from({ length: 6 }).map((_, repIdx) => (
            <div
              class="ticker-track flex items-center gap-0 shrink-0"
              aria-hidden={repIdx > 0 ? "true" : "false"}
            >
              {[
                {
                  label: "Diseño Web",
                  href: "/servicios/diseno-web",
                  color: "#ff005c",
                },
                {
                  label: "Software Python",
                  href: "/servicios/software-python",
                  color: "#00ff73",
                },
                {
                  label: "Diseño de Identidad",
                  href: "/servicios/diseno-identidad",
                  color: "#ffcc00",
                },
              ].map((s) => (
                <>
                  <a
                    href={s.href}
                    tabindex={repIdx > 0 ? "-1" : "0"}
                    class="ticker-item font-display text-2xl tracking-wider px-8 py-1 transition-colors duration-200 no-underline"
                    style={`color: rgba(255,255,255,0.7); --hc: ${s.color};`}
                    onmouseenter={`this.style.color='${s.color}'`}
                    onmouseleave="this.style.color='rgba(255,255,255,0.7)'"
                  >
                    {s.label}
                  </a>
                  <span class="text-blanco/15 font-mono text-base">◆</span>
                </>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <section
      id="manifiesto"
      class="relative py-32 md:py-52 px-6 md:px-16 bg-blanco overflow-hidden"
    >
      <div
        class="manifiesto-top-line absolute top-0 left-0 w-full h-px bg-negro/8 origin-left"
        style="transform: scaleX(0);"
      >
      </div>

      <div class="absolute top-24 right-16 hidden md:block" aria-hidden="true">
        <span
          class="font-display text-[clamp(80px,10vw,140px)] text-negro/3 leading-none select-none"
          >02</span
        >
      </div>

      <div class="w-full">
        <div
          class="manifesto-label flex items-center gap-4 mb-16"
          style="opacity:0; transform:translateY(16px);"
        >
          <span
            class="font-mono text-xs tracking-[0.4em] uppercase text-negro/30"
            >§ 02 — Manifiesto</span
          >
          <div class="flex-1 max-w-16 h-px bg-negro/15"></div>
        </div>

        <div
          class="grid grid-cols-1 lg:grid-cols-2 items-center gap-12 lg:gap-8 min-h-[60vh] mt-8 lg:mt-0"
        >
          <div class="space-y-0 relative z-10 w-full lg:pl-20 xl:pl-32">
            {
              [
                { text: "Diseñamos", faded: false },
                { text: "tecnología que", faded: false },
                { text: "", gap: true },
                { text: "vende,", color: "text-rosa", glow: "255,0,92" },
                {
                  text: "automatiza y",
                  color: "text-verde",
                  glow: "0,255,115",
                },
                {
                  text: "escala negocios.",
                  color: "text-yellow-400",
                  glow: "255,204,0",
                },
              ].map((line) =>
                line.gap ? (
                  <div class="h-4 md:h-6" />
                ) : (
                  <div
                    class="overflow-hidden"
                    style="padding-top: 1.5em; margin-top: -1.5em; padding-bottom: 0.5em; margin-bottom: -0.5em;"
                  >
                    <p
                      class={`manifesto-reveal font-display leading-[0.88] ${line.faded ? "text-negro/20" : line.color ? `${line.color} selection:bg-negro selection:text-blanco` : "text-negro"}`}
                      style={`font-size: clamp(48px, 6vw, 110px); transform: translateY(150%); position: relative; top: 0.15em; ${line.glow ? `text-shadow: 0 0 40px rgba(${line.glow},0.2);` : ""}`}
                    >
                      {line.text}
                    </p>
                  </div>
                ),
              )
            }
          </div>

          <div
            class="manifesto-lottie hidden md:flex justify-center lg:justify-start lg:pl-12 w-full opacity-0 pointer-events-none"
          >
            <img
              loading="lazy"
              decoding="async"
              src="/assets/insfraestructure-animation.svg"
              alt="Infraestructura"
              class="w-full max-w-[500px] lg:max-w-[700px]"
              width="700"
              height="500"
              style="height: auto;"
            />
          </div>
        </div>

        <div
          class="manifesto-body grid md:grid-cols-3 gap-8 md:gap-12 mt-20 pt-16 border-t border-negro/8 items-start"
          style="opacity:0; transform: translateY(24px);"
        >
          <div>
            <p
              class="font-mono text-sm md:text-base text-negro/55 leading-[1.9] max-w-lg"
            >
              Cada pixel tiene un propósito. Cada línea de código tiene una
              razón de existir. Trabajamos con la precisión de un ingeniero y la
              visión de un diseñador, entregando soluciones digitales que no
              solo funcionan —
              <strong class="text-negro font-semibold"
                >funcionan a un nivel superior.</strong
              >
            </p>
          </div>
          <div>
            <p
              class="font-mono text-sm md:text-base text-negro/55 leading-[1.9] max-w-lg"
            >
              Ejecutamos proyectos para empresas que entienden que la tecnología
              no es un gasto — es el activo más rentable de su negocio. Sin
              atajos. Sin plantillas.
              <strong class="text-negro font-semibold"
                >A medida, siempre.</strong
              >
            </p>
          </div>
          <div>
            <p
              data-gsap="fade-up"
              class="font-mono text-sm md:text-base text-negro/55 leading-[1.9] max-w-lg"
            >
              El contacto es directo. Sin intermedios. Sin burocracia. Hablas <strong
                class="text-negro font-semibold"
              >
                directamente con los desarrolladores.</strong
              > Ágil, transparente y enfocado 100% en el código y el diseño.
            </p>
          </div>

          <div
            class="manifesto-stats flex flex-col lg:flex-row mt-16 gap-4 lg:gap-0"
            style="opacity:0; transform: translateY(24px);"
          >
            {
              [
                {
                  valor: "+10",
                  label: "Tecnologías",
                  color: "text-negro",
                  z: "z-[40]",
                  desc: "Stack ultra-optimizado con Next.js, Astro y Tailwind.",
                },
                {
                  valor: "100%",
                  label: "A medida",
                  color: "text-acento",
                  z: "z-[30]",
                  desc: "Código nativo diseñado sin plantillas predefinidas.",
                },
                {
                  valor: "+12",
                  label: "Años exp.",
                  color: "text-negro",
                  z: "z-[20]",
                  desc: "Construyendo software y diseñando webs de alto impacto.",
                },
                {
                  valor: "24/7",
                  label: "Soporte",
                  color: "text-verde",
                  z: "z-[10]",
                  desc: "Monitoreo y mantenimiento constante para clientes.",
                },
              ].map((stat, i) => (
                <div
                  class={`stat-accordion-card group relative flex flex-col lg:flex-row lg:items-center overflow-hidden bg-[#FAFAFA] border border-negro/10 lg:-ml-8 first:lg:ml-0 ${stat.z} rounded-2xl lg:rounded-l-none lg:rounded-r-3xl first:lg:rounded-l-3xl w-full lg:w-[240px] lg:hover:w-[480px] shrink-0 transition-all duration-[800ms] ease-[cubic-bezier(0.34,1.56,0.64,1)] p-6 lg:py-8 lg:pr-8 lg:pl-16 first:lg:pl-8 cursor-default`}
                >
                  <div class="flex flex-col justify-center shrink-0 min-w-[130px]">
                    <p
                      class={`font-display text-5xl lg:text-6xl ${stat.color} mb-2 leading-none transition-transform duration-[800ms] ease-[cubic-bezier(0.34,1.56,0.64,1)] lg:group-hover:scale-105 origin-left`}
                    >
                      {stat.valor}
                    </p>
                    <p class="font-mono text-xs text-negro/40 tracking-widest uppercase whitespace-nowrap">
                      {stat.label}
                    </p>
                  </div>

                  <div class="opacity-0 lg:-translate-x-8 lg:group-hover:opacity-100 lg:group-hover:translate-x-0 duration-[600ms] ease-[cubic-bezier(0.34,1.56,0.64,1)] lg:group-hover:delay-100 hidden lg:flex items-center shrink-0 w-[190px] ml-4 pointer-events-none">
                    <p class="font-mono text-sm text-negro/60 leading-relaxed border-l border-negro/10 pl-5">
                      {stat.desc}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section
      id="servicios"
      class="relative bg-negro pt-32 md:pt-44 pb-16 px-6 md:px-16 overflow-hidden"
    >
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div
          class="absolute top-[-10%] left-[-5%] w-[40vw] h-[40vw] bg-verde/5 rounded-full blur-[100px] animate-pulse"
        >
        </div>
        <div
          class="absolute bottom-[-10%] right-[-5%] w-[45vw] h-[45vw] bg-rosa/5 rounded-full blur-[120px] animate-pulse"
          style="animation-delay: 2s;"
        >
        </div>
        <div
          class="absolute top-[40%] right-[10%] w-[30vw] h-[30vw] bg-yellow-400/5 rounded-full blur-[90px] animate-pulse"
          style="animation-delay: 1s;"
        >
        </div>
      </div>
      <div class="container mx-auto max-w-[1400px] relative z-10">
        <div
          class="flex items-center gap-4 mb-16 opacity-0 translate-y-4"
          id="servicios-label"
        >
          <span
            class="font-mono text-xs tracking-[0.4em] uppercase text-blanco/30"
            >§ 01 — Servicios</span
          >
          <div class="w-12 h-px bg-blanco/15"></div>
        </div>

        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
        >
          <div class="relative w-full max-w-[500px] mx-auto lg:mx-0">
            <InteractiveMap
              servicioId=""
              fillColor="rgba(255,255,255,0.03)"
              strokeColor="rgba(255,255,255,0.15)"
              hoverColor="#ff005c"
              disableRedirect={true}
            />
          </div>

          <div class="flex flex-col">
            <h2
              id="servicios-title"
              class="font-display text-5xl md:text-7xl text-blanco mb-10 transition-all duration-300"
            >
              Nuestros Servicios
            </h2>

            <div class="grid grid-cols-1 gap-4">
              <a
                href="/servicios/software-python"
                data-base-href="/servicios/software-python"
                class="servicio-dyn-link group flex items-center justify-between border border-blanco/10 bg-blanco/[0.03] backdrop-blur-2xl p-6 hover:bg-verde/5 hover:border-verde/30 rounded-2xl hover:rounded-none transition-all duration-300"
              >
                <div>
                  <span
                    class="font-mono text-[10px] text-blanco/30 uppercase tracking-widest block mb-2 group-hover:text-verde transition-colors"
                    >01</span
                  >
                  <h3
                    class="font-display text-2xl md:text-3xl text-blanco group-hover:text-verde transition-colors"
                  >
                    Software Python<span
                      class="prov-name opacity-0 transition-opacity duration-300"
                    ></span>
                  </h3>
                </div>
                <span
                  class="text-blanco/30 group-hover:text-verde group-hover:translate-x-2 transition-all text-xl"
                  >→</span
                >
              </a>

              <a
                href="/servicios/diseno-web"
                data-base-href="/servicios/diseno-web"
                class="servicio-dyn-link group flex items-center justify-between border border-blanco/10 bg-blanco/[0.03] backdrop-blur-2xl p-6 hover:bg-rosa/5 hover:border-rosa/30 rounded-2xl hover:rounded-none transition-all duration-300"
              >
                <div>
                  <span
