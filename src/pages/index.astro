---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

let latestPosts: any[] = [];
try {
  const allPosts = await getCollection("blog");
  if (allPosts) {
    latestPosts = allPosts
      .sort(
        (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
      )
      .slice(0, 3);
  }
} catch (e) {}
---

<Layout
  title="VEZNER — Ingeniería Digital de Alta Gama | Córdoba, Argentina"
  description="VEZNER diseña y construye infraestructura digital de alta gama. Diseño de paginas web, software Python y branding. +50 proyectos entregados a nivel global."
  keywords="agencia digital Córdoba Argentina, desarrollo web a medida, software Python empresas, diseño identidad visual, VEZNER"
  canonicalUrl="/"
>
  <Header />

  <main id="main-content">
    <section
      id="hero"
      class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden bg-blanco"
    >
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div
          class="absolute top-[-10%] right-[-5%] w-[40vw] h-[40vw] bg-negro/5 rounded-full blur-[80px] animate-pulse"
        >
        </div>
        <div
          class="absolute bottom-[-10%] left-[-5%] w-[50vw] h-[50vw] bg-negro/5 rounded-full blur-[100px] animate-pulse"
          style="animation-delay: 2s;"
        >
        </div>
      </div>
      <canvas
        id="hero-canvas"
        class="hidden md:block absolute inset-0 w-full h-full pointer-events-none"
        aria-hidden="true"></canvas>

      <div
        class="absolute inset-0 pointer-events-none z-0 opacity-[0.025]"
        style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;); background-size: 256px 256px;"
      >
      </div>

      <div class="relative z-10 text-center px-6 max-w-6xl mx-auto">
        <div
          id="hero-tag"
          class="mb-10 flex items-center justify-center gap-3"
          style="opacity:0;"
        >
          <div class="hero-line w-12 h-px bg-negro/30 origin-right scale-x-0">
          </div>
          <span
            class="font-mono text-xs tracking-[0.4em] uppercase text-negro/50"
            >Ingeniería Digital</span
          >
          <div class="hero-line w-12 h-px bg-negro/30 origin-left scale-x-0">
          </div>
        </div>

        <h1
          class="relative font-display leading-none tracking-tight text-negro overflow-hidden"
          style="font-size: clamp(88px, 22vw, 280px);"
        >
          <span class="hero-word block css-hero-anim">VEZNER</span>
        </h1>

        <div
          id="hero-sub"
          class="mt-8"
          style="opacity:0; transform: translateY(16px);"
        >
          <p
            class="font-mono text-sm md:text-base tracking-[0.15em] uppercase text-negro/40 max-w-lg mx-auto leading-loose"
          >
            Construimos la infraestructura digital<br class="hidden md:block" />
            que hace que los negocios <span class="text-negro/80 font-medium"
              >escalen.</span
            >
          </p>
        </div>

        <div
          id="hero-ctas"
          class="mt-14 flex flex-col items-center justify-center gap-6"
          style="opacity:0; transform: translateY(20px);"
        >
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full">
            <a
              href="https://wa.me/5493513323272?text=Hola%20VEZNER,%20quiero%20cotizar%20un%20proyecto%20tecnológico%20premium"
              target="_blank" rel="noopener noreferrer"
              class="btn-primary group relative inline-flex items-center gap-3 bg-negro text-blanco px-10 py-4 font-mono text-xs tracking-widest uppercase overflow-hidden hover:rounded-none transition-[border-radius] duration-300 border border-transparent rounded-2xl w-full sm:w-auto justify-center"
            >
              <span class="relative z-10 flex items-center gap-2"><i class="fa-brands fa-whatsapp text-base"></i> Cotizar por WhatsApp</span>
              <span
                class="absolute inset-0 bg-[#25D366] translate-x-[-101%] group-hover:translate-x-0 transition-transform duration-400 ease-out z-0"
              ></span>
            </a>
            <a
              href="#servicios"
              class="btn-secondary group relative inline-flex items-center gap-3 border border-negro/50 text-negro px-10 py-4 font-mono text-xs tracking-widest uppercase overflow-hidden hover:border-negro hover:rounded-none transition-colors duration-300 rounded-2xl w-full sm:w-auto justify-center"
            >
              <span class="relative z-10 group-hover:text-blanco transition-colors duration-300">Ver Servicios</span>
              <span class="relative z-10 group-hover:text-blanco transition-colors duration-300">↓</span>
              <span class="absolute inset-0 bg-negro translate-y-[101%] group-hover:translate-y-0 transition-transform duration-350 ease-out z-0"></span>
            </a>
          </div>
          
          <div class="flex items-center justify-center gap-6 text-xs font-mono text-negro/50">
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-check text-[#00c851]"></i> Respuestas Rápidas</span>
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-bolt text-yellow-500"></i> Calidad Premium</span>
          </div>
        </div>
      </div>

      <div
        id="scroll-indicator"
        class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2"
        style="opacity:0;"
      >
        <span class="font-mono text-xs tracking-[0.3em] uppercase text-negro/30"
          >Scroll</span
        >
        <div class="w-px h-14 bg-negro/10 relative overflow-hidden">
          <div
            class="scroll-pulse absolute top-0 left-0 w-full bg-negro"
            style="height: 40%; animation: scrollPulse 2s ease-in-out infinite;"
          >
          </div>
        </div>
      </div>
    </section>

    <div
      class="ticker-wrap bg-negro overflow-hidden py-5 border-y border-blanco/5"
    >
      <div
        id="ticker-inner"
        class="ticker-inner flex gap-0 whitespace-nowrap select-none"
      >
        {
          Array.from({ length: 6 }).map((_, repIdx) => (
            <div
              class="ticker-track flex items-center gap-0 shrink-0"
              aria-hidden={repIdx > 0 ? "true" : "false"}
            >
              {[
                {
                  label: "Diseño Web",
                  href: "/servicios/diseno-web",
                  color: "#ff005c",
                },
                {
                  label: "Software Python",
                  href: "/servicios/software-python",
                  color: "#00ff73",
                },
                {
                  label: "Diseño de Identidad",
                  href: "/servicios/diseno-identidad",
                  color: "#ffcc00",
                },
              ].map((s) => (
                <>
                  <a
                    href={s.href}
                    tabindex={repIdx > 0 ? "-1" : "0"}
                    class="ticker-item font-display text-2xl tracking-wider px-8 py-1 transition-colors duration-200 no-underline"
                    style={`color: rgba(255,255,255,0.7); --hc: ${s.color};`}
                    onmouseenter={`this.style.color='${s.color}'`}
                    onmouseleave="this.style.color='rgba(255,255,255,0.7)'"
                  >
                    {s.label}
                  </a>
                  <span class="text-blanco/15 font-mono text-base">◆</span>
                </>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <section
      id="manifiesto"
      class="relative py-32 md:py-52 px-6 md:px-16 bg-blanco overflow-hidden"
    >
      <div
        class="manifiesto-top-line absolute top-0 left-0 w-full h-px bg-negro/8 origin-left"
        style="transform: scaleX(0);"
      >
      </div>

      <div class="absolute top-24 right-16 hidden md:block" aria-hidden="true">
        <span
          class="font-display text-[clamp(80px,10vw,140px)] text-negro/3 leading-none select-none"
          >02</span
        >
      </div>

      <div class="w-full">
        <div
          class="manifesto-label flex items-center gap-4 mb-16"
          style="opacity:0; transform:translateY(16px);"
        >
          <span
            class="font-mono text-xs tracking-[0.4em] uppercase text-negro/30"
            >§ 02 — Manifiesto</span
          >
          <div class="flex-1 max-w-16 h-px bg-negro/15"></div>
        </div>

        <div
          class="grid grid-cols-1 lg:grid-cols-2 items-center gap-12 lg:gap-8 min-h-[60vh] mt-8 lg:mt-0"
        >
          <div class="space-y-0 relative z-10 w-full lg:pl-20 xl:pl-32">
            {
              [
                { text: "No construimos", faded: false },
                { text: "páginas web.", faded: false },
                { text: "", gap: true },
                { text: "Construimos", color: "text-rosa", glow: "255,0,92" },
                { text: "tecnología", color: "text-verde", glow: "0,255,115" },
                {
                  text: "que escala.",
                  color: "text-yellow-400",
                  glow: "255,204,0",
                },
              ].map((line) =>
                line.gap ? (
                  <div class="h-4 md:h-6" />
                ) : (
                  <div class="overflow-hidden">
                    <p
                      class={`manifesto-reveal font-display leading-[0.88] ${line.faded ? "text-negro/20" : line.color ? `${line.color} selection:bg-negro selection:text-blanco` : "text-negro"}`}
                      style={`font-size: clamp(48px, 6vw, 110px); transform: translateY(110%); ${line.glow ? `text-shadow: 0 0 40px rgba(${line.glow},0.2);` : ""}`}
                    >
                      {line.text}
                    </p>
                  </div>
                ),
              )
            }
          </div>

          <div
            class="manifesto-lottie hidden md:flex justify-center lg:justify-start lg:pl-12 w-full opacity-0 pointer-events-none"
          >
            <img
              src="/assets/insfraestructure-animation.svg"
              alt="Infraestructura"
              class="w-full max-w-[500px] lg:max-w-[700px]"
              width="700"
              height="500"
              style="height: auto;"
            />
          </div>
        </div>

        <div
          class="manifesto-body grid md:grid-cols-2 gap-8 md:gap-12 mt-20 pt-16 border-t border-negro/8 items-start"
          style="opacity:0; transform: translateY(24px);"
        >
          <div>
            <p
              class="font-mono text-sm md:text-base text-negro/55 leading-[1.9] max-w-lg"
            >
              Cada pixel tiene un propósito. Cada línea de código tiene una
              razón de existir. Trabajamos con la precisión de un ingeniero y la
              visión de un diseñador, entregando soluciones digitales que no
              solo funcionan —
              <strong class="text-negro font-semibold"
                >funcionan a un nivel superior.</strong
              >
            </p>
          </div>
          <div>
            <p
              class="font-mono text-sm md:text-base text-negro/55 leading-[1.9] max-w-lg"
            >
              Ejecutamos proyectos para empresas que entienden que la tecnología
              no es un gasto — es el activo más rentable de su negocio. Sin
              atajos. Sin plantillas.
              <strong class="text-negro font-semibold"
                >A medida, siempre.</strong
              >
            </p>
          </div>

          <div
            class="manifesto-stats flex flex-col md:flex-row mt-16 gap-4 md:gap-0"
            style="opacity:0; transform: translateY(24px);"
          >
            {
              [
                {
                  valor: "+10",
                  label: "Tecnologías",
                  color: "text-negro",
                  z: "z-[40]",
                  desc: "Stack ultra-optimizado con Next.js, Astro y Tailwind.",
                },
                {
                  valor: "100%",
                  label: "A medida",
                  color: "text-acento",
                  z: "z-[30]",
                  desc: "Código nativo diseñado sin plantillas predefinidas.",
                },
                {
                  valor: "+12",
                  label: "Años exp.",
                  color: "text-negro",
                  z: "z-[20]",
                  desc: "Construyendo software y diseñando webs de alto impacto.",
                },
                {
                  valor: "24/7",
                  label: "Soporte",
                  color: "text-verde",
                  z: "z-[10]",
                  desc: "Monitoreo y mantenimiento constante para clientes.",
                },
              ].map((stat, i) => (
                <div
                  class={`stat-accordion-card group relative flex flex-col md:flex-row md:items-center overflow-hidden bg-[#fafafa] border border-negro/15 md:-ml-8 first:md:ml-0 ${stat.z} rounded-2xl md:rounded-l-none md:rounded-r-3xl first:md:rounded-l-3xl w-full md:w-[240px] md:hover:w-[480px] md:shrink-0 transition-all duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] p-6 md:py-8 md:pr-8 md:pl-16 first:md:pl-8 cursor-default`}
                >
                  <div class="flex flex-col justify-center shrink-0 min-w-[130px]">
                    <p
                      class={`font-display text-5xl md:text-6xl ${stat.color} mb-2 leading-none transition-transform duration-500 md:group-hover:scale-105 origin-left`}
                    >
                      {stat.valor}
                    </p>
                    <p class="font-mono text-xs text-negro/40 tracking-widest uppercase whitespace-nowrap">
                      {stat.label}
                    </p>
                  </div>

                  <div class="opacity-0 md:-translate-x-12 md:group-hover:opacity-100 md:group-hover:translate-x-0 transition-all duration-500 delay-100 hidden md:flex items-center shrink-0 w-[190px] ml-4">
                    <p class="font-mono text-sm text-negro/60 leading-relaxed border-l border-negro/10 pl-5">
                      {stat.desc}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section
      id="servicios"
      class="relative bg-negro py-32 md:py-44 px-6 md:px-16 overflow-hidden"
    >
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div
          class="absolute top-[-10%] left-[-5%] w-[40vw] h-[40vw] bg-verde/5 rounded-full blur-[100px] animate-pulse"
        >
        </div>
        <div
          class="absolute bottom-[-10%] right-[-5%] w-[45vw] h-[45vw] bg-rosa/5 rounded-full blur-[120px] animate-pulse"
          style="animation-delay: 2s;"
        >
        </div>
        <div
          class="absolute top-[40%] right-[10%] w-[30vw] h-[30vw] bg-yellow-400/5 rounded-full blur-[90px] animate-pulse"
          style="animation-delay: 1s;"
        >
        </div>
      </div>
      <div class="container mx-auto max-w-[1400px] relative z-10">
        <div
          class="flex items-center gap-4 mb-16 opacity-0 translate-y-4"
          id="servicios-label"
        >
          <span
            class="font-mono text-xs tracking-[0.4em] uppercase text-blanco/30"
            >§ 01 — Servicios</span
          >
          <div class="w-12 h-px bg-blanco/15"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <a
            href="/servicios/software-python"
            class="servicio-card-simple group block relative opacity-0 transform-gpu will-change-transform will-change-[opacity] border border-blanco/10 bg-[#0a0a0a] p-12 hover:bg-verde/5 hover:border-verde/30 transition-colors transition-[border-radius] duration-500 overflow-hidden min-h-[300px] flex flex-col justify-between rounded-2xl hover:rounded-none"
          >
            <div>
              <span
                class="font-mono text-xs text-blanco/30 uppercase tracking-widest mb-6 block group-hover:text-verde transition-colors duration-500"
                >01</span
              >
              <h2
                class="font-display text-4xl md:text-5xl text-blanco leading-none mb-4 group-hover:text-verde group-hover:translate-x-2 transition-all duration-500"
              >
                Software Python
              </h2>
              <p
                class="font-mono text-sm text-blanco/50 leading-relaxed max-w-sm group-hover:text-blanco/80 transition-colors duration-500"
              >
                Bots para Discord, APIs REST, y automatizaciones complejas a
                medida.
              </p>
            </div>
            <div
              class="flex items-center gap-3 text-blanco group-hover:text-verde group-hover:gap-5 transition-colors duration-300 mt-8"
            >
              <span class="font-mono text-xs uppercase tracking-widest"
                >Ver más</span
              >
              <span class="text-xs group-hover:translate-x-2 transition-transform duration-300">→</span>
            </div>
          </a>

          <a
            href="/servicios/diseno-web"
            class="servicio-card-simple group block relative opacity-0 transform-gpu will-change-transform will-change-[opacity] border border-blanco/10 bg-[#0a0a0a] p-12 hover:bg-rosa/5 hover:border-rosa/30 transition-colors transition-[border-radius] duration-500 overflow-hidden min-h-[300px] flex flex-col justify-between rounded-2xl hover:rounded-none"
          >
            <div>
              <span
                class="font-mono text-xs text-blanco/30 uppercase tracking-widest mb-6 block group-hover:text-rosa transition-colors duration-500"
                >02</span
              >
              <h2
                class="font-display text-4xl md:text-5xl text-blanco leading-none mb-4 group-hover:text-rosa group-hover:translate-x-2 transition-all duration-500"
              >
                Diseño Web
              </h2>
              <p
                class="font-mono text-sm text-blanco/50 leading-relaxed max-w-sm group-hover:text-blanco/80 transition-colors duration-500"
              >
                Desarrollo web a medida con Astro, React y optimización extrema.
                Animaciones fluidas y SEO técnico impecable.
              </p>
            </div>
            <div
              class="flex items-center gap-3 text-blanco group-hover:text-rosa group-hover:gap-5 transition-colors duration-300 mt-8"
            >
              <span class="font-mono text-xs uppercase tracking-widest"
                >Ver más</span
              >
              <span class="text-xs group-hover:translate-x-2 transition-transform duration-300">→</span>
            </div>
          </a>

          <a
            href="/servicios/diseno-identidad"
            class="servicio-card-simple group block relative opacity-0 transform-gpu will-change-transform will-change-[opacity] border border-blanco/10 bg-[#0a0a0a] p-12 hover:bg-yellow-400/5 hover:border-yellow-400/30 transition-colors transition-[border-radius] duration-500 overflow-hidden min-h-[300px] flex flex-col justify-between rounded-2xl hover:rounded-none md:col-span-2"
          >
            <div>
              <span
                class="font-mono text-xs text-blanco/30 uppercase tracking-widest mb-6 block group-hover:text-yellow-400 transition-colors duration-500"
                >03</span
              >
              <h2
                class="font-display text-4xl md:text-5xl text-blanco leading-none mb-4 group-hover:text-yellow-400 group-hover:translate-x-2 transition-all duration-500"
              >
                Diseño de Identidad
              </h2>
              <p
                class="font-mono text-sm text-blanco/50 leading-relaxed max-w-sm group-hover:text-blanco/80 transition-colors duration-500"
              >
                Marcas con presencia imponente, geometría precisa y branding
                premium.
              </p>
            </div>
            <div
              class="flex items-center gap-3 text-blanco group-hover:text-yellow-400 group-hover:gap-5 transition-colors duration-300 mt-8"
            >
              <span class="font-mono text-xs uppercase tracking-widest"
                >Ver más</span
              >
              <span class="text-xs group-hover:translate-x-2 transition-transform duration-300">→</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section
      id="proceso"
      class="relative py-32 md:py-44 px-6 md:px-16 bg-blanco overflow-hidden"
    >
      <div class="container mx-auto max-w-6xl">
        <div
          class="proceso-label flex items-center gap-4 mb-16"
          style="opacity:0; transform:translateY(16px);"
        >
          <span
            class="font-mono text-xs tracking-[0.4em] uppercase text-negro/30"
            >§ 03 — Proceso</span
          >
          <div class="w-12 h-px bg-negro/15"></div>
        </div>

        <div class="grid md:grid-cols-2 gap-x-16 gap-y-4">
          <div class="overflow-hidden">
            <h2
              class="proceso-title font-display text-[clamp(56px,8vw,110px)] leading-none text-negro"
              style="transform:translateY(110%);"
            >
              Así<br />trabajamos.
            </h2>
          </div>

          <div class="flex flex-col justify-end">
            <p
              class="proceso-desc font-mono text-sm text-negro/50 leading-relaxed max-w-md"
              style="opacity:0; transform:translateY(20px);"
            >
              Un proceso claro, sin sorpresas. Sabés exactamente en qué etapa
              está tu proyecto en todo momento.
            </p>
          </div>
        </div>

        <div class="mt-16 space-y-0">
          {
            [
              {
                num: "01",
                titulo: "Diagnóstico",
                desc: "Analizamos tu negocio, tu competencia y tus objetivos. Definimos el alcance real del proyecto sin adornos.",
                duracion: "1–2 días",
                color: "#ff005c",
              },
              {
                num: "02",
                titulo: "Propuesta técnica",
                desc: "Entregamos un plan detallado: tecnologías, cronograma, hitos de entrega y precio cerrado. Sin sorpresas.",
                duracion: "2–3 días",
                color: "#0057ff",
              },
              {
                num: "03",
                titulo: "Desarrollo",
                desc: "Construimos en sprints cortos con revisiones frecuentes. Acceso en tiempo real al estado del proyecto.",
                duracion: "Según scope",
                color: "#00c851",
              },
              {
                num: "04",
                titulo: "QA y entrega",
                desc: "Pruebas exhaustivas, correcciones, documentación y capacitación. Entregamos cuando está perfecto, no antes.",
                duracion: "3–5 días",
                color: "#ffd700",
              },
              {
                num: "05",
                titulo: "Soporte continuo",
                desc: "Mantenimiento activo, monitoreo y mejoras iterativas. La relación no termina con la entrega.",
                duracion: "Ongoing",
                color: "#ff3c00",
              },
            ].map((paso, i) => (
              <div
                class="proceso-step group grid md:grid-cols-[80px_1fr_auto] items-start gap-6 py-8 border-b border-negro/8 transition-colors duration-300 rounded-2xl hover:rounded-none"
                style={`opacity:0; transform:translateY(24px); --hover-c: ${paso.color};`}
              >
                <span class="proceso-num font-display text-5xl text-negro/25 leading-none transition-colors duration-300">
                  {paso.num}
                </span>
                <div>
                  <h3 class="font-display text-3xl text-negro leading-none mb-2">
                    {paso.titulo}
                  </h3>
                  <p class="font-mono text-sm text-negro/45 max-w-2xl leading-relaxed">
                    {paso.desc}
                  </p>
                </div>
                <span class="font-mono text-xs text-negro/25 uppercase tracking-widest mt-1 whitespace-nowrap">
                  {paso.duracion}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="noticias"
      class="py-32 px-6 md:px-16 bg-blanco border-t border-negro/10"
    >
      <div class="max-w-7xl mx-auto">
        <div
