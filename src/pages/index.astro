  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { DotLottie } from "@lottiefiles/dotlottie-web";

    document.addEventListener("astro:page-load", () => {
      gsap.registerPlugin(ScrollTrigger);

      const tickers = [
        { sel: "#ticker-inner", dir: -1 },
        { sel: "#stack-ticker-inner", dir: -1 },
        { sel: "#rubros-ticker-inner-1", dir: -1 },
        { sel: "#rubros-ticker-inner-2", dir: 1 },
        { sel: "#rubros-ticker-inner-3", dir: -1 },
      ];

      tickers.forEach(({ sel, dir }) => {
        const el = document.querySelector(sel);
        if (!el) return;
        const wrap = el.closest(".ticker-wrap") || el.parentElement;

        let tween: any;
        if (dir === 1) {
          gsap.set(el, { xPercent: -(100 / 6) });
          tween = gsap.to(el, {
            xPercent: 0,
            duration: 28,
            ease: "none",
            repeat: -1,
          });
        } else {
          tween = gsap.to(el, {
            xPercent: -(100 / 6),
            duration: 28,
            ease: "none",
            repeat: -1,
          });
        }

        wrap?.addEventListener("mouseenter", () =>
          gsap.to(tween, { timeScale: 0, duration: 1.2, ease: "power3.out" }),
        );
        wrap?.addEventListener("mouseleave", () =>
          gsap.to(tween, { timeScale: 1, duration: 1.2, ease: "power2.inOut" }),
        );
      });

      const heroCanvas = document.getElementById(
        "hero-canvas",
      ) as HTMLCanvasElement;
      const isDesktop = window.matchMedia("(min-width: 768px)").matches;

      const initWebGLBackground = async (targetCanvas: HTMLCanvasElement) => {
          if (!targetCanvas) return;
          const THREE = await import("three");

          const renderer = new THREE.WebGLRenderer({
            canvas: targetCanvas,
            antialias: true,
            alpha: true,
          });
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
          renderer.setSize(window.innerWidth, window.innerHeight);

          const scene = new THREE.Scene();
          const camera = new THREE.PerspectiveCamera(
            45,
            window.innerWidth / window.innerHeight,
            0.1,
            100,
          );
          camera.position.set(0, 0, 10);

          const lights: any[] = [];
          const colors = [
            { hex: 0x00ff73, css: "rgba(0, 255, 115, 1)" },
            { hex: 0xff005c, css: "rgba(255, 0, 92, 1)" },
            { hex: 0xffcc00, css: "rgba(255, 204, 0, 1)" },
            { hex: 0x00aaff, css: "rgba(0, 170, 255, 1)" },
          ];

          function createGlowTexture(colorStr: string) {
            const canvas = document.createElement("canvas");
            canvas.width = 256;
            canvas.height = 256;
            const ctx = canvas.getContext("2d")!;
            const gradient = ctx.createRadialGradient(
              128,
              128,
              0,
              128,
              128,
              128,
            );
            gradient.addColorStop(0, colorStr);
            gradient.addColorStop(0.5, colorStr.replace("1)", "0.5)"));
            gradient.addColorStop(1, "rgba(0,0,0,0)");
            ctx.fillStyle = gradient;
            ctx.fillRect(0, 0, 256, 256);
            return new THREE.CanvasTexture(canvas);
          }

          colors.forEach((col) => {
            const spriteMat = new THREE.SpriteMaterial({
              map: createGlowTexture(col.css),
              color: 0xffffff,
              transparent: true,
              blending: THREE.AdditiveBlending,
              depthWrite: false,
            });
            const sprite = new THREE.Sprite(spriteMat);

            sprite.scale.set(40, 40, 1);

            sprite.position.set(
              (Math.random() - 0.5) * 30,
              (Math.random() - 0.5) * 30,
              -20,
            );
            scene.add(sprite);

            lights.push({
              mesh: sprite,
              angX: Math.random() * Math.PI * 2,
              angY: Math.random() * Math.PI * 2,
              speed: 0.1 + Math.random() * 0.1,
              radius: 10 + Math.random() * 10,
            });
          });

          window.addEventListener("resize", () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
          });

          const reloj = new THREE.Clock();

          function animarThree() {
            if (!document.body.contains(targetCanvas)) return;
            requestAnimationFrame(animarThree);

            lights.forEach((l) => {
              l.angX += l.speed * 0.005;
              l.angY += l.speed * 0.007;
              l.mesh.position.x = Math.cos(l.angX) * l.radius;
              l.mesh.position.y = Math.sin(l.angY) * l.radius;
            });

            renderer.render(scene, camera);
          }

          renderer.render(scene, camera);
          animarThree();
      };

      if (isDesktop) {
        let threeStarted = false;
        const startThree = () => {
          if (threeStarted) return;
          threeStarted = true;
          if (heroCanvas) initWebGLBackground(heroCanvas);
        };

        ["scroll", "mousemove", "touchstart"].forEach((evt) => {
          window.addEventListener(evt, startThree, {
            once: true,
            passive: true,
          });
        });
        setTimeout(startThree, 100);
      }

      const tl = gsap.timeline({ paused: true, delay: 0.2 });
      
      const preloader = document.getElementById("vezner-preloader");
      if (preloader && isDesktop && !sessionStorage.getItem("vezner_preloader_done")) {
        sessionStorage.setItem("vezner_preloader_done", "true");
        document.body.style.overflow = "hidden";
        
        const preloaderCanvas = document.getElementById("preloader-lights-canvas") as HTMLCanvasElement;
        if (preloaderCanvas) initWebGLBackground(preloaderCanvas);
        
        gsap.set(preloader, { filter: "blur(50px)" });
        gsap.to(preloader, { filter: "blur(0px)", duration: 1.2, ease: "power3.out" });

        gsap.set("header", { opacity: 0 });

        gsap.set(["#preloader-lottie-container", "#preloader-somos", "#preloader-vezner-text"], {
          top: "50%",
          left: "50%",
          xPercent: -50,
          yPercent: -50
        });
        gsap.set("#preloader-somos", { x: window.innerWidth });
        gsap.set("#preloader-vezner-text", { x: window.innerWidth });

        import("@lottiefiles/dotlottie-web").then(({ DotLottie }) => {
          const canvas = document.getElementById("preloader-lottie-canvas") as HTMLCanvasElement;
          if (!canvas) return;
          
          const dotLottie = new DotLottie({
            canvas: canvas,
            src: "/assets/logo.lottie",
            autoplay: true,
            loop: false,
            speed: 1.8,
          });

          gsap.to("#preloader-lottie-container", { opacity: 1, duration: 0.5 });

          let preloaderFinished = false;
          let sequenceStarted = false;

          const finishPreloader = () => {
             if (preloaderFinished) return;
             preloaderFinished = true;
             gsap.to("header", { opacity: 1, duration: 0.8, ease: "power2.out" });
             gsap.to(preloader, { opacity: 0, duration: 0.8, ease: "power2.inOut", onComplete: () => {
               preloader.style.display = "none";
               document.body.style.overflow = "";
               tl.play();
             }});
          };

          const startSequence = () => {
             if (sequenceStarted) return;
             sequenceStarted = true;
             
             const pTl = gsap.timeline({ onComplete: finishPreloader });
             
             const lottieTarget = document.querySelector("header .logo-wrapper > div:first-child");
             const lottieSource = document.getElementById("preloader-lottie-container");
             if (lottieTarget && lottieSource) {
                const tr = lottieTarget.getBoundingClientRect();
                const sr = lottieSource.getBoundingClientRect();
                pTl.to(lottieSource, {
                  x: "+=" + (tr.left - sr.left),
                  y: "+=" + (tr.top - sr.top),
                  scaleX: tr.width / sr.width,
                  scaleY: tr.height / sr.height,
                  transformOrigin: "top left",
                  duration: 0.8,
                  ease: "power3.inOut"
                }, "start");
             }
             
             pTl.to("#preloader-somos", { x: 0, opacity: 1, duration: 0.6, ease: "power4.out" }, "start+=0.3");
             pTl.to("#preloader-somos", { x: -window.innerWidth, opacity: 0, duration: 0.5, ease: "power3.in" }, "+=0.2");
             pTl.to("#preloader-vezner-text", { x: 0, opacity: 1, duration: 0.6, ease: "power4.out" }, "<0.2");
             
             pTl.add(() => {
                const textTarget = document.querySelector("header img[alt='VEZNER']");
                const textSource = document.getElementById("preloader-vezner-text");
                if (textTarget && textSource) {
                   const tr = textTarget.getBoundingClientRect();
                   const sr = textSource.getBoundingClientRect();
                   gsap.to(textSource, {
                     x: "+=" + (tr.left - sr.left),
                     y: "+=" + (tr.top - sr.top),
                     scaleX: tr.width / sr.width,
                     scaleY: tr.height / sr.height,
                     transformOrigin: "top left",
                     duration: 0.7,
                     ease: "power3.inOut"
                   });
                }
             }, "+=0.2");
             
             pTl.to({}, { duration: 0.9 }); 
          };

          dotLottie.addEventListener("complete", startSequence);
          setTimeout(startSequence, 2000);
        });
      } else {
        if (preloader) preloader.style.display = "none";
        tl.play();
      }

      tl.to(
        ".hero-line",
        { scaleX: 1, duration: 0.7, ease: "power3.out", stagger: 0.1 },
