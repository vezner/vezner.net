      gsap.to(".showcase-label", {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: { trigger: "#showcase", start: "top 80%", once: true },
      });

      gsap.to(".showcase-title", {
        y: "0%",
