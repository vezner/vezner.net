<script>
  import { gsap } from "gsap";

  document.addEventListener("astro:page-load", () => {
    let geoData: any = {
      ip: "Calculando...",
      country: "Desconocido",
      city: "Desconocida",
      organization: "Desconocido",
    };
    fetch("https://ipv4.geojs.io/v1/ip/geo.json")
      .then((res) => res.json())
      .then((geo) => {
        geoData = geo;
      })
      .catch(() => {});

    const form = document.getElementById(
      "service-contact-form",
    ) as HTMLFormElement;
    const success = document.getElementById("form-success");

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = document.getElementById("submit-btn") as HTMLButtonElement;
      const btnText = btn?.querySelector("span.relative") as HTMLSpanElement;

      if (btn && btnText) {
        btnText.textContent = "Enviando...";
        btn.disabled = true;
      }

      try {
        const formData = new FormData(form);
        formData.append(
          "Origen_Visita",
          document.referrer || "Directo / Desconocido",
        );
        formData.append("IP_Cliente", geoData.ip);
        formData.append("Ubicacion", `${geoData.city}, ${geoData.country}`);
        formData.append(
          "Proveedor_Internet",
          geoData.organization_name || geoData.organization || "Desconocido",
        );
        formData.append("Sistema_Operativo", navigator.platform);

        const response = await fetch("https://formspree.io/f/mdarbbdy", {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          form.reset();
          if (btn && btnText) btnText.textContent = "✓ Enviado";
          success?.classList.remove("hidden");
          gsap.fromTo(
            success,
            { opacity: 0, y: 10 },
            { opacity: 1, y: 0, duration: 0.5 },
          );
        } else {
          throw new Error("Error");
        }
      } catch (error) {
        if (btn && btnText) {
          btnText.textContent = "Enviar consulta";
          btn.disabled = false;
        }
        alert(
          "Hubo un error al enviar tu consulta. Por favor, intentá nuevamente más tarde.",
        );
      }
    });
  });
</script>

<style>
  .btn-primary:hover span:first-child,
  .btn-primary:hover span:nth-child(2) {
    color: #0a0a0a;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  document.addEventListener("astro:page-load", () => {
    gsap.registerPlugin(ScrollTrigger);

    const tl = gsap.timeline();
    tl.to(".hero-reveal", {
      opacity: 1,
      duration: 1,
      ease: "power3.out",
      delay: 0.2,
    });
    tl.to(
      ".title-line",
      { y: "0%", duration: 1.2, stagger: 0.15, ease: "power4.out" },
      "-=0.6",
    );
    tl.to(
      ".hero-desc",
      { opacity: 1, y: 0, duration: 1, ease: "power3.out" },
      "-=0.8",
    );
    tl.to(
      ".hero-stats",
      { opacity: 1, y: 0, duration: 1, ease: "power3.out" },
      "-=0.8",
    );
    tl.to(".scroll-prompt", { opacity: 1, duration: 1 }, "-=0.5");

    gsap.to(".term-title", {
      scrollTrigger: { trigger: ".term-title", start: "top 85%", once: true },
      opacity: 1,
      y: 0,
      duration: 1,
      ease: "power4.out",
    });
    gsap.to(".term-desc", {
      scrollTrigger: { trigger: ".term-title", start: "top 85%", once: true },
      opacity: 1,
      y: 0,
      duration: 1,
      delay: 0.2,
      ease: "power3.out",
    });
    gsap.to(".term-mockup", {
      scrollTrigger: { trigger: ".term-mockup", start: "top 75%", once: true },
      opacity: 1,
      y: 0,
      duration: 1.2,
      ease: "power3.out",
    });

    gsap.utils.toArray(".id-step").forEach((step, i) => {
      gsap.to(step as HTMLElement, {
        scrollTrigger: {
          trigger: (step as HTMLElement).parentElement,
          start: "top 85%",
          once: true,
        },
        opacity: 1,
        y: 0,
        duration: 0.8,
        delay: i * 0.15,
        ease: "power3.out",
      });
    });

    gsap.utils.toArray(".plan-card").forEach((card, i) => {
      gsap.fromTo(
        card as HTMLElement,
        { opacity: 0, y: 50 },
        {
          scrollTrigger: {
            trigger: (card as HTMLElement).parentElement,
            start: "top 85%",
            once: true,
          },
          opacity: 1,
          y: 0,
          duration: 0.8,
          delay: i * 0.15,
          ease: "power3.out",
        },
      );
    });
  });
</script>
