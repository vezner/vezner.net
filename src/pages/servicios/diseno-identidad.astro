---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Diseño de Identidad — VEZNER"
  description="Branding y diseño de identidad visual. Creamos marcas brutalistas, minimalistas y de altísima gama. Córdoba, Argentina."
>
  <Header theme="dark" />
  
  <main class="bg-negro text-blanco min-h-screen overflow-hidden">
    
    
    <section id="hero" class="relative min-h-screen flex flex-col justify-center px-6 md:px-16 pt-32 pb-20">
      
      
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute top-[-10%] right-[-5%] w-[40vw] h-[40vw] bg-yellow-400/5 rounded-full blur-[80px] animate-pulse"></div>
        <div class="absolute bottom-[10%] left-[-10%] w-[50vw] h-[50vw] bg-yellow-400/5 rounded-full blur-[100px] animate-pulse" style="animation-delay: 2s;"></div>
        <svg class="absolute top-1/2 left-[60%] -translate-y-1/2 w-[800px] h-[800px] opacity-[0.03] animate-[spin_60s_linear_infinite]" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="48" fill="none" stroke="#ffd700" stroke-width="0.5"/>
          <rect x="15" y="15" width="70" height="70" fill="none" stroke="#ffd700" stroke-width="0.5" transform="rotate(45 50 50)"/>
          <polygon points="50,2 98,75 2,75" fill="none" stroke="#ffd700" stroke-width="0.5"/>
        </svg>
      </div>

      <div class="relative z-10 w-full max-w-7xl mx-auto">
        <div class="hero-reveal flex items-center gap-4 mb-8 opacity-0">
          <div class="w-12 h-px bg-yellow-400/40"></div>
          <span class="font-mono text-xs tracking-[0.4em] uppercase text-yellow-400/50">Servicios / 05</span>
        </div>
        
        <h1 class="font-display text-[clamp(60px,12vw,180px)] leading-none text-blanco uppercase mb-12">
          <span class="block overflow-hidden pt-12 -mt-12"><span class="title-line block translate-y-[120%]">Diseño &</span></span>
          <span class="block overflow-hidden pt-12 -mt-12"><span class="title-line block translate-y-[120%] text-yellow-400">Identidad</span></span>
        </h1>
        
        <div class="grid md:grid-cols-2 gap-12 md:gap-24 items-end">
          <div class="max-w-lg">
            <p class="hero-desc font-mono text-base md:text-lg text-blanco/60 leading-relaxed opacity-0 transform translate-y-8 mb-8">
              Construimos identidades visuales estratégicas. Más allá de vectores y paletas de color, diseñamos ecosistemas de marca que diferencian tu negocio, transmiten autoridad y te posicionan por encima de tu competencia.
            </p>
            
            <div class="hero-desc opacity-0 transform translate-y-8 flex flex-col sm:flex-row gap-4 mb-6">
              <a href="https://wa.me/5493513323272?text=Hola%20VEZNER,%20quiero%20crear%20una%20identidad%20visual%20premium" target="_blank" rel="noopener noreferrer" class="group relative inline-flex items-center justify-center gap-3 bg-yellow-400 text-negro px-8 py-4 font-mono text-xs tracking-widest uppercase overflow-hidden border-2 border-yellow-400 rounded-2xl hover:rounded-none transition-[border-radius] duration-300 w-full sm:w-auto">
                <span class="relative z-10 flex items-center gap-2"><i class="fa-brands fa-whatsapp text-base"></i> Cotizar por WhatsApp</span>
                <span class="absolute inset-0 bg-blanco translate-x-[-101%] group-hover:translate-x-0 transition-transform duration-300 ease-out z-0"></span>
              </a>
              <a href="#galeria" class="inline-flex items-center justify-center px-8 py-4 font-mono text-xs tracking-widest uppercase border-2 border-blanco/20 text-blanco rounded-2xl hover:rounded-none hover:border-blanco transition-all duration-300 w-full sm:w-auto">
                Ver Galería
              </a>
            </div>
            
            <div class="hero-desc opacity-0 transform translate-y-8 flex items-center gap-4 text-xs font-mono text-blanco/50">
              <span class="flex items-center gap-1.5"><i class="fa-solid fa-check text-yellow-400"></i> Manual de marca incluido</span>
              <span class="flex items-center gap-1.5"><i class="fa-solid fa-vector-square text-rosa"></i> 100% Vectorial</span>
            </div>
          </div>
          
          <div class="hero-stats flex flex-wrap gap-8 md:justify-end opacity-0 transform translate-y-8">
            <div class="border-l border-yellow-400/30 pl-4">
              <p class="font-display text-4xl text-blanco">Confianza</p>
              <p class="font-mono text-xs text-blanco/40 tracking-widest uppercase">Percepción</p>
            </div>
            <div class="border-l border-yellow-400/30 pl-4">
              <p class="font-display text-4xl text-blanco">Autoridad</p>
              <p class="font-mono text-xs text-blanco/40 tracking-widest uppercase">Posicionamiento</p>
            </div>
            <div class="border-l border-yellow-400/30 pl-4">
              <p class="font-display text-4xl text-blanco">Sistemas</p>
              <p class="font-mono text-xs text-blanco/40 tracking-widest uppercase">Ecosistema Visual</p>
            </div>
          </div>
        </div>
      </div>
      
      
      <div class="scroll-prompt absolute bottom-10 left-16 flex items-center gap-4 opacity-0">
        <div class="w-px h-12 bg-blanco/20 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1/2 bg-yellow-400 animate-[scrollPulse_2s_ease-in-out_infinite]"></div>
        </div>
        <span class="font-mono text-xs tracking-widest uppercase text-blanco/30">Explorar</span>
      </div>
    </section>

    
    <section id="galeria" class="py-32 px-6 md:px-16 bg-[#0a0a0a] border-y border-blanco/5 overflow-hidden">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-20">
          <h2 data-gsap="fade-up" class="font-display text-6xl md:text-8xl text-blanco mb-6 term-title opacity-0 translate-y-10">ANATOMÍA<br/>DE UNA MARCA</h2>
          <p class="font-mono text-sm text-blanco/50 max-w-xl mx-auto term-desc opacity-0 translate-y-10">Un logo no es una marca. Construimos ecosistemas visuales integrales que alinean la percepción de tu público con la calidad real de tus servicios.</p>
        </div>
        
        
        <div data-gsap="fade-up" class="term-mockup opacity-0 translate-y-20 bg-[#111] rounded-2xl hover:rounded-none transition-safe duration-300 shadow-2xl overflow-hidden border border-blanco/10 max-w-5xl mx-auto p-2 transition-colors duration-300">
          
          <div class="border border-blanco/5 h-[500px] flex">
            
            <div class="w-1/3 border-r border-blanco/5 p-8 flex flex-col justify-between">
              <div>
                <h4 class="font-mono text-xs tracking-widest uppercase text-blanco/30 mb-6">Color System</h4>
                <div class="space-y-3">
                  <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-[#0a0a0a] border border-blanco/10"></div>
                    <div>
                      <div class="font-mono text-sm">#0A0A0A</div>
                      <div class="font-mono text-[10px] text-blanco/40">Primary Dark</div>
                    </div>
                  </div>
                  <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-blanco border border-blanco/10"></div>
                    <div>
                      <div class="font-mono text-sm text-blanco">#FFFFFF</div>
                      <div class="font-mono text-[10px] text-blanco/40">Pure White</div>
                    </div>
                  </div>
                  <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-yellow-400 border border-blanco/10"></div>
                    <div>
                      <div class="font-mono text-sm text-yellow-400">#FFD700</div>
                      <div class="font-mono text-[10px] text-blanco/40">Accent Gold</div>
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="pt-8 border-t border-blanco/5">
                <h4 class="font-mono text-xs tracking-widest uppercase text-blanco/30 mb-6">Typography</h4>
                <div class="font-display text-4xl mb-2">BEBAS NEUE</div>
                <div class="font-mono text-xs text-blanco/40 mb-6">Headings / Display</div>
                
                <div class="font-sans text-xl mb-1">Inter Medium</div>
                <div class="font-mono text-xs text-blanco/40">Body / UI Text</div>
              </div>
            </div>
            
            
            <div class="w-2/3 bg-[#050505] relative flex items-center justify-center p-8 overflow-hidden group">
              <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 40px 40px;"></div>
              
              
              <svg viewBox="0 0 400 400" class="w-full h-full max-w-sm absolute opacity-20 group-hover:opacity-100 transition-opacity duration-1000">
                <circle cx="200" cy="200" r="160" fill="none" stroke="#ffd700" stroke-width="1" stroke-dasharray="4 4" />
                <circle cx="200" cy="200" r="100" fill="none" stroke="#ffd700" stroke-width="1" stroke-dasharray="4 4" />
                <circle cx="200" cy="200" r="61.8" fill="none" stroke="#ffd700" stroke-width="1" stroke-dasharray="4 4" />
                <line x1="200" y1="0" x2="200" y2="400" stroke="#ffd700" stroke-width="1" stroke-dasharray="4 4"/>
                <line x1="0" y1="200" x2="400" y2="200" stroke="#ffd700" stroke-width="1" stroke-dasharray="4 4"/>
              </svg>
              
              <div class="relative z-10 font-display text-[120px] tracking-tight leading-none text-blanco">
                VEZNER
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    
    <section id="entregables" class="py-32 px-6 md:px-16 bg-negro">
      <div class="max-w-7xl mx-auto">
        <h2 data-gsap="fade-up" class="font-display text-4xl md:text-6xl text-blanco mb-16 text-center">NUESTRO ENFOQUE</h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {[
            { n: '01', t: 'Investigación & Mercado', d: 'Analizamos a tu competencia, tu público objetivo y tu posicionamiento actual para encontrar el ángulo correcto.' },
            { n: '02', t: 'Estrategia Visual', d: 'Te presentamos diferentes caminos creativos basados en decisiones estratégicas y geométricas, no en simple estética.' },
            { n: '03', t: 'Sistemas de Marca', d: 'Desarrollamos ecosistemas visuales completos: tipografías, colores, reglas de uso y jerarquía visual.' },
            { n: '04', t: 'Brandbook Técnico', d: 'Entrega del manual de marca definitivo y todos los archivos vectoriales necesarios para escalar tu negocio.' },
          ].map((item, i) => (
            <div class="id-step opacity-0 transform-gpu will-change-transform will-change-[opacity] relative pb-12 last:pb-0 rounded-2xl hover:rounded-none transition-colors transition-[border-radius] duration-300 group">
              <div class="absolute -left-[30px] md:-left-[40px] top-4 w-3 h-3 rounded-full bg-blanco/20 group-hover:bg-yellow-400 group-hover:shadow-[0_0_15px_rgba(253,224,71,0.6)] border-4 border-negro transform -translate-x-1/2 transition-all duration-300" />
              <div class="font-display text-6xl text-yellow-400/20 group-hover:text-yellow-400/50 transition-colors duration-300 mb-4">{item.n}</div>
              <h4 class="font-mono text-lg font-bold mb-3 group-hover:text-yellow-400 transition-colors duration-300">{item.t}</h4>
              <p class="font-mono text-xs text-blanco/50 group-hover:text-blanco/80 transition-colors duration-300 leading-relaxed">{item.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="alcance" class="py-32 px-6 md:px-16 bg-[#050505] border-t border-blanco/5">
      <div class="max-w-7xl mx-auto">
        <h2 data-gsap="fade-up" class="font-display text-4xl md:text-6xl text-blanco mb-16 text-center">ALCANCE DEL SERVICIO</h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {[
            { t: 'Refresh de Marca', d: 'Ideal si ya tenés un logo funcional pero necesita una modernización y ajuste a proporciones matemáticas.', i: 'fa-solid fa-arrows-rotate' },
            { t: 'Identidad Core', d: 'Logotipo principal, versiones secundarias, paleta de colores y selección tipográfica.', i: 'fa-solid fa-cube' },
            { t: 'Manual de Marca PDF', d: 'Un documento técnico extenso que dicta todas las reglas de uso (espacios, prohibiciones, contraste).', i: 'fa-solid fa-file-pdf' },
            { t: 'Papelería & Digital', d: 'Diseño de tarjetas de presentación, firmas de email, menús de restaurante o templates para redes.', i: 'fa-solid fa-pen-nib' },
          ].map((item, i) => (
            <div data-gsap="fade-up" class="plan-card opacity-0 transform-gpu will-change-transform will-change-[opacity] border border-blanco/5 p-8 bg-[#111] hover:bg-yellow-400/5 hover:border-yellow-400/30 rounded-2xl hover:rounded-none transition-colors transition-[border-radius] duration-300 group">
              <i class={`${item.i} text-3xl text-yellow-400/50 group-hover:text-yellow-400 group-hover:-translate-y-2 transition-all duration-300 mb-6 block drop-shadow-sm group-hover:drop-shadow-md`}></i>
              <h4 class="font-display text-2xl mb-4 text-blanco group-hover:translate-x-1 transition-transform duration-300">{item.t}</h4>
              <p class="font-mono text-xs text-blanco/50 group-hover:text-blanco/80 transition-colors duration-300 leading-relaxed">{item.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    
    <section id="cta" class="py-32 bg-yellow-400 text-negro text-center relative overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-t from-negro/10 to-transparent"></div>
      </div>
      
      <div class="relative z-10 max-w-3xl mx-auto px-6">
        <h2 data-gsap="fade-up" class="font-display text-6xl md:text-8xl mb-8 cta-title rounded-2xl hover:rounded-none transition-safe duration-300">Destacá entre<br/>el ruido</h2>
        <p class="font-mono text-sm text-negro/80 mb-12 uppercase tracking-widest cta-desc rounded-2xl hover:rounded-none transition-safe duration-300">Construí autoridad en tu industria.</p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 cta-btns rounded-2xl hover:rounded-none transition-safe duration-300 transition-colors duration-300">
          <a href="/contacto" class="btn-primary group relative inline-flex items-center gap-3 bg-negro text-blanco px-10 py-5 font-mono text-xs tracking-widest uppercase overflow-hidden border border-transparent rounded-2xl hover:rounded-none transition-safe duration-300 transition-colors duration-300">
            <span class="relative z-10">Renovar mi marca</span>
            <span class="relative z-10 transition-transform duration-300 group-hover:translate-x-1.5">→</span>
            <span class="absolute inset-0 bg-blanco translate-x-[-101%] group-hover:translate-x-0 transition-transform duration-300 ease-out"></span>
          </a>
          <a href="/#servicios" class="btn-secondary group relative inline-flex items-center gap-3 border border-negro/30 text-negro px-10 py-5 font-mono text-xs tracking-widest uppercase hover:bg-negro/10 transition-safe duration-300 rounded-2xl hover:rounded-none transition-colors duration-300">
            Ver otros servicios
          </a>
        </div>
      </div>
    </section>

  </main>
  
  <Footer />
</Layout>

<style>
  .btn-primary:hover span:first-child,
  .btn-primary:hover span:nth-child(2) {
    color: #0a0a0a;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  document.addEventListener("astro:page-load", () => {
    gsap.registerPlugin(ScrollTrigger);
  

  const tl = gsap.timeline();
  tl.to('.hero-reveal', { opacity: 1, duration: 1, ease: 'power3.out', delay: 0.2 });
  tl.to('.title-line', { y: '0%', duration: 1.2, stagger: 0.15, ease: 'power4.out' }, '-=0.6');
  tl.to('.hero-desc', { opacity: 1, y: 0, duration: 1, ease: 'power3.out' }, '-=0.8');
  tl.to('.hero-stats', { opacity: 1, y: 0, duration: 1, ease: 'power3.out' }, '-=0.8');
  tl.to('.scroll-prompt', { opacity: 1, duration: 1 }, '-=0.5');


  gsap.to('.term-title', {
    scrollTrigger: { trigger: '.term-title', start: 'top 85%', once: true },
    opacity: 1, y: 0, duration: 1, ease: 'power4.out'
  });
  gsap.to('.term-desc', {
    scrollTrigger: { trigger: '.term-title', start: 'top 85%', once: true },
    opacity: 1, y: 0, duration: 1, delay: 0.2, ease: 'power3.out'
  });
  gsap.to('.term-mockup', {
    scrollTrigger: { trigger: '.term-mockup', start: 'top 75%', once: true },
    opacity: 1, y: 0, duration: 1.2, ease: 'power3.out'
  });


  gsap.utils.toArray('.id-step').forEach((step, i) => {
    gsap.to(step as HTMLElement, {
      scrollTrigger: { trigger: (step as HTMLElement).parentElement, start: 'top 85%', once: true },
      opacity: 1, y: 0, duration: 0.8, delay: i * 0.15, ease: 'power3.out'
    });
  });

  gsap.utils.toArray('.plan-card').forEach((card, i) => {
    gsap.fromTo(
      card as HTMLElement,
      { opacity: 0, y: 50 },
      {
        scrollTrigger: { trigger: (card as HTMLElement).parentElement, start: 'top 85%', once: true },
        opacity: 1, y: 0, duration: 0.8, delay: i * 0.15, ease: 'power3.out'
      }
    );
  });
  });
</script>

