            class="hidden font-mono font-medium text-sm text-[#00c851] bg-[#00c851]/10 border border-[#00c851]/30 px-6 py-4 rounded-2xl shadow-lg mt-8 text-center"
          >
            ✓ Mensaje enviado con éxito. En breve será contactado de regreso.
          </div>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";

  document.addEventListener("astro:page-load", () => {
    let geoData: any = {
      ip: "Calculando...",
      country: "Desconocido",
      city: "Desconocida",
      organization: "Desconocido",
    };
    fetch("https://ipv4.geojs.io/v1/ip/geo.json")
      .then((res) => res.json())
      .then((geo) => {
        geoData = geo;
      })
      .catch(() => {});

    const form = document.getElementById(
      "service-contact-form",
    ) as HTMLFormElement;
    const success = document.getElementById("form-success");

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = document.getElementById("submit-btn") as HTMLButtonElement;
      const btnText = btn?.querySelector("span.relative") as HTMLSpanElement;

      if (btn && btnText) {
        btnText.textContent = "Enviando...";
        btn.disabled = true;
      }

      try {
        const formData = new FormData(form);
        formData.append(
          "Origen_Visita",
          document.referrer || "Directo / Desconocido",
        );
        formData.append("IP_Cliente", geoData.ip);
        formData.append("Ubicacion", `${geoData.city}, ${geoData.country}`);
        formData.append(
          "Proveedor_Internet",
          geoData.organization_name || geoData.organization || "Desconocido",
        );
        formData.append("Sistema_Operativo", navigator.platform);

        const response = await fetch("https://formspree.io/f/mdarbbdy", {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          form.reset();
          if (btn && btnText) btnText.textContent = "✓ Enviado";
          success?.classList.remove("hidden");
          gsap.fromTo(
            success,
            { opacity: 0, y: 10 },
            { opacity: 1, y: 0, duration: 0.5 },
          );
        } else {
          throw new Error("Error");
        }
      } catch (error) {
        if (btn && btnText) {
          btnText.textContent = "Enviar consulta";
          btn.disabled = false;
        }
        alert(
          "Hubo un error al enviar tu consulta. Por favor, intentá nuevamente más tarde.",
        );
      }
    });
  });
</script>

