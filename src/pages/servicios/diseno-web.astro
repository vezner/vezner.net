---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import InteractiveMap from "../../components/InteractiveMap.astro";
---

<Layout
  title="Diseño y Desarrollo Web a Medida en Argentina — Landing Pages y Sitios | VEZNER"
  description="Diseño de Landing Pages y Sitios Web de alta gama. Desarrollo con código propio para sitios institucionales y expertos en Tiendanube y Shopify para E-commerce."
  keywords="diseño web a medida, desarrollo web frontend, expertos tiendanube, desarrollo shopify, diseño web córdoba, diseño de paginas web rosario, agencia de diseño web mendoza, tiendas online santa fe, sitios web para empresas caba, desarrollo web premium argentina, landing pages de alta conversión, VEZNER web"
>
  <Header />

  <main class="bg-[#fafafa] text-negro min-h-screen overflow-hidden">
    <section
      id="hero"
      class="relative min-h-screen flex flex-col justify-center px-6 md:px-16 pt-32 pb-20"
    >
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div
          class="absolute top-[-10%] left-[-10%] w-[40vw] h-[40vw] bg-rosa/10 rounded-full blur-[80px] animate-pulse"
        >
        </div>
        <div
          class="absolute bottom-[10%] right-[-10%] w-[50vw] h-[50vw] bg-yellow-400/10 rounded-full blur-[100px] animate-pulse"
          style="animation-delay: 2s;"
        >
        </div>
      </div>
      <div
        class="absolute inset-0 pointer-events-none z-0 opacity-10"
        style="background-image: linear-gradient(#000 1px, transparent 1px), linear-gradient(90deg, #000 1px, transparent 1px); background-size: 50px 50px;"
      >
      </div>

      <div class="relative z-10 w-full max-w-7xl mx-auto">
        <div class="hero-reveal flex items-center gap-4 mb-8 opacity-0">
          <div class="w-12 h-px bg-rosa/50"></div>
          <span class="font-mono text-xs tracking-[0.4em] uppercase text-rosa"
            >Servicios / 01</span
          >
        </div>

        <div class="relative">
          <h1
            class="font-display text-[clamp(60px,12vw,180px)] leading-none text-negro uppercase mb-12"
          >
            <span class="block overflow-hidden pt-12 -mt-12"
              ><span class="title-line block translate-y-[120%]">Diseño</span
              ></span
            >
            <span class="block overflow-hidden pt-12 -mt-12"
              ><span class="title-line block translate-y-[120%] text-rosa"
                >Web</span
              ></span
            >
          </h1>
        </div>

        <div class="grid md:grid-cols-2 gap-12 md:gap-24 items-end">
          <div class="max-w-lg">
            <p
              class="hero-desc font-mono text-base md:text-lg text-negro/70 leading-relaxed opacity-0 transform translate-y-8 mb-8"
            >
              Transformamos visitantes en clientes de alto valor. Desarrollamos <strong
                >Landings y Webs Corporativas a medida con código propio</strong
              >, y somos expertos en <strong>Tiendanube y Shopify</strong> para crear
              e-commerces ultrarrápidos. Pura ingeniería de conversión.
            </p>

            <div
              class="hero-desc opacity-0 transform translate-y-8 flex flex-col sm:flex-row gap-4 mb-6"
            >
              <a
                href="https://wa.me/5493513323272?text=Hola%20VEZNER,%20quiero%20crear%20una%20p%C3%A1gina%20web"
                target="_blank"
                rel="noopener noreferrer"
                class="group relative inline-flex items-center justify-center gap-3 bg-negro text-blanco px-8 py-4 font-mono text-xs tracking-widest uppercase overflow-hidden border-2 border-negro rounded-2xl hover:rounded-none transition-all duration-300 w-full sm:w-auto"
              >
                <span class="relative z-10 flex items-center gap-2"
                  ><i class="fa-brands fa-whatsapp text-base"></i> Cotizar por WhatsApp</span
                >
                <span
                  class="absolute inset-0 bg-rosa translate-x-[-101%] group-hover:translate-x-0 transition-transform duration-300 ease-out z-0"
                ></span>
              </a>
              <a
                href="#soluciones"
                class="inline-flex items-center justify-center px-8 py-4 font-mono text-xs tracking-widest uppercase border-2 border-negro/20 text-negro rounded-2xl hover:rounded-none hover:border-negro transition-all duration-300 w-full sm:w-auto"
              >
                Ver Soluciones
              </a>
            </div>

            <div
              class="hero-desc opacity-0 transform translate-y-8 flex items-center gap-4 text-xs font-mono text-negro/50"
            >
              <span class="flex items-center gap-1.5"
                ><i class="fa-solid fa-code text-verde"></i> Código Propio</span
              >
              <span class="flex items-center gap-1.5"
                ><i class="fa-brands fa-shopify text-yellow-500"></i> Shopify / Tiendanube
              </span>
            </div>
          </div>

          <div class="relative w-full">
            <div
              class="absolute bottom-full right-[20%] lg:right-[30%] pb-4 hidden md:block z-10 pointer-events-auto"
            >
              <InteractiveMap
                servicioId="diseno-web"
                fillColor="rgba(0,0,0,0.03)"
                strokeColor="rgba(0,0,0,0.15)"
                hoverColor="#ff005c"
              />
            </div>
            <div
              class="hero-stats flex flex-wrap gap-8 md:justify-end opacity-0 transform translate-y-8"
            >
              <div
                class="border-l-2 border-rosa pl-5 group hover:border-negro transition-colors duration-300"
              >
                <p
                  class="font-display text-5xl text-negro group-hover:text-rosa transition-colors duration-300"
                >
                  UI/UX
                </p>
                <p
                  class="font-mono text-[10px] text-negro/50 tracking-[0.2em] uppercase mt-1"
                >
                  Calidad Premium
                </p>
              </div>
              <div
                class="border-l-2 border-rosa pl-5 group hover:border-negro transition-colors duration-300"
              >
                <p
                  class="font-display text-5xl text-negro group-hover:text-rosa transition-colors duration-300"
                >
                  MAX
                </p>
                <p
                  class="font-mono text-[10px] text-negro/50 tracking-[0.2em] uppercase mt-1"
                >
                  Ingeniería de Conversión
                </p>
              </div>
              <div
                class="border-l-2 border-rosa pl-5 group hover:border-negro transition-colors duration-300"
              >
                <p
                  class="font-display text-5xl text-negro group-hover:text-rosa transition-colors duration-300"
                >
                  0%
                </p>
                <p
                  class="font-mono text-[10px] text-negro/50 tracking-[0.2em] uppercase mt-1"
                >
                  Plantillas Genéricas
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div
        class="scroll-prompt absolute bottom-10 left-6 md:left-16 flex items-center gap-4 opacity-0"
      >
        <div class="w-px h-12 bg-negro/20 relative overflow-hidden">
          <div
            class="absolute top-0 left-0 w-full h-1/2 bg-rosa animate-[scrollPulse_2s_ease-in-out_infinite]"
          >
          </div>
        </div>
        <span
          class="font-mono text-[10px] tracking-[0.3em] uppercase text-negro/40"
          >Scroll</span
        >
      </div>
    </section>

    <section
      id="soluciones"
      class="py-32 bg-[#050505] relative overflow-hidden text-blanco"
    >
      <div class="container mx-auto px-6 md:px-16 max-w-7xl">
        <h2
          data-gsap="fade-up"
          class="font-display text-6xl md:text-8xl text-blanco mb-20 section-title opacity-0 border-l-4 border-rosa pl-8"
        >
          ¿QUÉ PODEMOS<br />CONSTRUIR?
        </h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
          {
            [
              {
                t: "Landing Pages",
                d: "Sitios de una sola página ultra optimizados, desarrollados con código propio a medida para captar leads y ventas directas.",
                c: "bg-[#111] hover:bg-rosa/10 hover:border-rosa/30",
              },
              {
                t: "E-Commerce",
                d: "Somos expertos en Tiendanube y Shopify. Diseñamos tu tienda de alta conversión sobre la plataforma que prefieras.",
                c: "bg-[#111] hover:bg-yellow-400/10 hover:border-yellow-400/30",
              },
              {
                t: "Web Corporativa",
                d: "Sitios institucionales multipágina construidos con código puro para garantizar una arquitectura y velocidad impecables.",
                c: "bg-[#111] hover:bg-verde/10 hover:border-verde/30",
              },
              {
                t: "Suscripción Total",
                d: "Nos encargamos de todo. Hosting de alto rendimiento, dominio y mantenimiento continuo cubiertos por un fee mensual.",
                c: "bg-[#111] hover:bg-azul/10 hover:border-azul/30",
              },
            ].map((item, i) => (
              <div
                class={`use-case opacity-0 transform-gpu will-change-transform will-change-[opacity] border border-blanco/5 bg-blanco/[0.03] backdrop-blur-2xl p-8 transition-[background-color,border-color,border-radius,color,box-shadow] rounded-2xl hover:rounded-none ${item.c} group`}
              >
                {" "}
                <div class="font-mono text-xs text-blanco/30 mb-6 group-hover:text-blanco transition-colors ">
                  {" "}
                  0{i + 1}{" "}
                </div>{" "}
                <h3
                  data-gsap="fade-up"
                  class="font-display text-3xl mb-4 text-blanco group-hover:translate-x-2 transition-transform "
                >
                  {" "}
                  {item.t}{" "}
                </h3>{" "}
                <p class="font-mono text-xs text-blanco/50 leading-relaxed">
                  {" "}
                  {item.d}{" "}
                </p>{" "}
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <section
      id="estandar"
      class="py-32 bg-negro text-blanco relative overflow-hidden"
    >
      <div class="container mx-auto px-6 md:px-16 max-w-7xl relative z-10">
        <div class="grid md:grid-cols-2 gap-20">
          <div
            data-gsap="fade-up"
            class="vs-card opacity-0 transform-gpu will-change-transform will-change-[opacity] border border-blanco/10 bg-blanco/[0.03] backdrop-blur-2xl p-10 md:p-16 hover:bg-blanco/5 rounded-2xl hover:rounded-none"
          >
            <span
              class="font-mono text-xs tracking-widest uppercase text-blanco/30 mb-8 block"
              >El estándar mediocre</span
            >
            <h3
              data-gsap="fade-up"
              class="font-display text-5xl mb-6 text-blanco/50"
            >
              Plantillas & <br />Desarrollo Genérico
            </h3>
            <ul class="space-y-4 font-mono text-sm text-blanco/40">
              <li class="flex gap-4">
                <span>×</span> Diseños de WordPress genéricos que no transmiten autoridad.
              </li>
              <li class="flex gap-4">
                <span>×</span> E-commerces lentos donde los clientes abandonan el
                carrito.
              </li>
              <li class="flex gap-4">
                <span>×</span> Cero enfoque en jerarquía de información.
              </li>
              <li class="flex gap-4">
                <span>×</span> Interfaces (UI) rotas en dispositivos móviles.
              </li>
            </ul>
          </div>
          <div
            data-gsap="fade-up"
            class="vs-card opacity-0 transform-gpu will-change-transform will-change-[opacity] border border-blanco/30 bg-blanco/[0.03] backdrop-blur-2xl p-10 md:p-16 relative rounded-2xl hover:rounded-none"
          >
            <div
              class="absolute top-0 right-0 w-24 h-24 bg-blanco/20 blur-[50px]"
            >
            </div>
            <span
              class="font-mono text-xs tracking-widest uppercase text-blanco mb-8 block"
              >El estándar VEZNER</span
            >
            <h3
              data-gsap="fade-up"
              class="font-display text-5xl mb-6 text-blanco"
            >
              Ventas &<br />Autoridad
            </h3>
            <ul class="space-y-4 font-mono text-sm text-blanco/70">
              <li class="flex gap-4">
                <span class="text-blanco">✓</span> Código Propio (Astro/React) para
                Landings y Sitios Corporativos.
              </li>
              <li class="flex gap-4">
                <span class="text-blanco">✓</span> Expertos en desarrollo sobre Shopify
                y Tiendanube para Tiendas.
              </li>
              <li class="flex gap-4">
                <span class="text-blanco">✓</span> Diseño de alta gama, estético y
                estratégico en ambas soluciones.
              </li>
              <li class="flex gap-4">
                <span class="text-blanco">✓</span> Integración nativa de pasarelas
                (Mercado Pago, Stripe, MODO).
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
    <section
      id="proceso"
      class="py-32 px-6 md:px-16 bg-[#050505] text-blanco border-t border-blanco/10"
    >
      <div class="max-w-7xl mx-auto">
        <h2
          data-gsap="fade-up"
          class="font-display text-5xl md:text-7xl text-blanco mb-20 text-center section-title opacity-0"
        >
          PROCESO DE CREACIÓN
        </h2>
        <div
          class="space-y-0 relative border-l border-blanco/10 ml-4 md:ml-8 pl-8 md:pl-16 py-8"
        >
          {
            [
              {
                n: "01",
                t: "Investigación & Plataforma",
                d: "Analizamos tu negocio para definir la mejor arquitectura: código propio para institucionales/landings, o Shopify/Tiendanube para tu e-commerce.",
              },
              {
                n: "02",
                t: "Diseño UX/UI",
                d: "Creamos interfaces estéticas, funcionales y alineadas a tu identidad de marca, priorizando la experiencia del usuario y la conversión.",
              },
              {
                n: "03",
                t: "Desarrollo & Configuración",
                d: "Programamos desde cero tu web corporativa o implementamos el diseño a medida sobre el panel de control de tu nueva tienda online.",
              },
              {
                n: "04",
                t: "Pruebas & Lanzamiento",
                d: "Auditamos la web en diferentes dispositivos, verificamos tiempos de carga, logística, pagos y desplegamos el proyecto en producción.",
              },
            ].map((paso, i) => (
              <div class="proceso-card opacity-0 transform-gpu will-change-transform will-change-[opacity] relative pb-16 last:pb-0 rounded-2xl hover:rounded-none transition-[background-color,border-color,border-radius,color,box-shadow] group">
                {" "}
                <div class="absolute -left-8 md:-left-16 top-0 w-3 h-3 rounded-full bg-blanco/20 group-hover:bg-rosa group-hover:shadow-[0_0_15px_rgba(225,29,72,1)] transform -translate-x-1/2 " />{" "}
                <span class="font-display text-4xl text-blanco/10 group-hover:text-rosa/40 transition-colors absolute -left-12 top-0 -translate-x-full md:-translate-x-0 md:relative md:left-0 md:-top-4">
                  {" "}
                  {paso.n}{" "}
                </span>{" "}
                <h3
                  data-gsap="fade-up"
                  class="font-display text-3xl md:text-4xl text-blanco mb-4 mt-2 md:mt-0 group-hover:text-rosa transition-colors "
                >
                  {" "}
                  {paso.t}{" "}
                </h3>{" "}
                <p class="font-mono text-sm text-blanco/50 group-hover:text-blanco/80 transition-colors leading-relaxed max-w-2xl">
                  {" "}
                  {paso.d}{" "}
                </p>{" "}
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <section id="enfoque" class="py-32 px-6 md:px-16 bg-blanco">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-20">
          <h2
            data-gsap="fade-up"
            class="font-display text-6xl md:text-8xl text-negro mb-6 section-title opacity-0"
          >
            INGENIERÍA<br />DE CONVERSIÓN
          </h2>
        </div>
        <div class="grid md:grid-cols-3 gap-x-12 gap-y-20">
          {
            [
              {
                t: "El Stack Correcto",
                d: "Usamos Astro, React y HTML puro para Landings ultrarrápidas. Para E-commerce, dominamos los ecosistemas de Tiendanube y Shopify.",
                i: "fa-solid fa-code",
              },
              {
                t: "UI Dinámica",
                d: "Implementamos animaciones fluidas, scroll interactivo y diseños estéticos de máxima calidad visual, sin importar la plataforma.",
                i: "fa-solid fa-wand-magic-sparkles",
              },
              {
                t: "Arquitectura",
                d: "Estructura semántica impecable en nuestros desarrollos propios e integraciones nativas avanzadas en plataformas de e-commerce.",
                i: "fa-solid fa-magnifying-glass",
              },
              {
                t: "Alta Conversión",
                d: "Integramos pasarelas de pago directas o configuramos los potentes flujos de checkout nativos de Tiendanube y Shopify para maximizar ventas.",
                i: "fa-solid fa-arrow-trend-up",
              },
              {
                t: "Responsive Puro",
                d: "Cero problemas en móvil. Diseñamos con un enfoque mobile-first absoluto, para que se vea avanzado en cualquier pantalla.",
                i: "fa-solid fa-mobile-screen-button",
              },
              {
                t: "Hosting & Soporte",
                d: "Nos encargamos de todo. Mantenimiento mensual, despliegue global automático y máxima seguridad para que vos te enfoques en tu negocio.",
                i: "fa-solid fa-server",
              },
            ].map((f, i) => (
              <div class="feat-card opacity-0 transform-gpu will-change-transform will-change-[opacity] border-t-2 border-negro/10 bg-negro/[0.03] backdrop-blur-2xl pt-8 transition-[background-color,border-color,border-radius,color,box-shadow] rounded-2xl hover:rounded-none hover:border-rosa group hover:bg-negro/[0.02] px-4 -mx-4 pb-4">
                {" "}
                <i
                  class={`${f.i} text-3xl text-negro/20 group-hover:text-rosa group-hover:-translate-y-2 transition-all duration-300 mb-6 block drop-shadow-sm group-hover:drop-shadow-md`}
                />
                <h4 class="font-display text-3xl text-negro mb-4 group-hover:translate-x-1 transition-transform duration-300">
                  {f.t}
                </h4>
                <p class="font-mono text-xs text-negro/60 leading-relaxed">
                  {f.d}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="dominios"
      class="py-32 px-6 md:px-16 bg-negro text-blanco relative overflow-hidden"
    >
      <div
        class="absolute inset-0 pointer-events-none opacity-[0.03]"
        style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 32px 32px;"
      >
      </div>

      <div class="max-w-7xl mx-auto relative z-10">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-8 h-px bg-rosa/50"></div>
          <span class="font-mono text-xs tracking-[0.4em] uppercase text-rosa"
            >Servicio incluido</span
          >
        </div>

        <div class="grid md:grid-cols-2 gap-16 items-start mb-16">
          <div>
            <h2
              class="font-display text-5xl md:text-7xl text-blanco mb-6 leading-none"
            >
              DOMINIO<br /><span class="text-rosa">&amp; HOSTING</span>
            </h2>
            <p class="font-mono text-sm text-blanco/60 leading-relaxed mb-6">
              Nos encargamos de todo. Registramos el dominio, configuramos el
              hosting de alto rendimiento y gestionamos las renovaciones. Vos te
              enfocás en tu negocio.
            </p>
            <div class="flex flex-col gap-3">
              <div
                class="flex items-center gap-3 font-mono text-xs text-blanco/70"
              >
                <span class="text-verde">✓</span> Registro y renovación de dominio
                incluida
              </div>
              <div
                class="flex items-center gap-3 font-mono text-xs text-blanco/70"
              >
                <span class="text-verde">✓</span> Hosting global de alto rendimiento
              </div>
              <div
                class="flex items-center gap-3 font-mono text-xs text-blanco/70"
              >
                <span class="text-verde">✓</span> SSL, caché y CDN automáticos
              </div>
              <div
                class="flex items-center gap-3 font-mono text-xs text-blanco/70"
              >
                <span class="text-verde">✓</span>
                <span
                  >Dominios gestionados vía <strong class="text-blanco"
                    >Cloudflare</strong
                  > — el estándar global de infraestructura web</span
                >
              </div>
            </div>

            <div
              class="mt-8 inline-flex items-center gap-3 border border-blanco/10 rounded-xl px-5 py-3"
            >
              <i class="fa-brands fa-cloudflare"></i>
              <span class="font-mono text-xs text-blanco/60"
                >Powered by <span class="text-blanco font-medium"
                  >Cloudflare</span
                ></span
              >
            </div>
          </div>

          <div class="bg-blanco/[0.04] border border-blanco/10 rounded-2xl p-8">
            <p
              class="font-mono text-xs tracking-widest uppercase text-blanco/40 mb-6"
            >
              Verificá la disponibilidad de tu dominio
            </p>

            <div class="flex gap-3 mb-4" id="domain-checker-form">
              <input
                type="text"
                id="domain-input"
                placeholder="minegocio"
                class="flex-1 bg-negro border border-blanco/20 rounded-xl px-4 py-3 font-mono text-sm text-blanco placeholder:text-blanco/20 focus:outline-none focus:border-rosa transition-colors"
              />
              <div
                class="relative custom-dropdown-container z-50 flex-none w-[130px]"
              >
                <input
                  type="hidden"
                  id="tld-select"
                  value=".com"
                  data-ar="false"
                />
                <button
                  type="button"
                  class="dropdown-btn w-full flex items-center justify-between bg-negro border border-blanco/20 rounded-xl px-4 py-3 font-mono text-sm text-blanco focus:outline-none focus:border-rosa transition-colors appearance-none cursor-pointer h-full"
                >
                  <span class="dropdown-text">.com</span>
                  <span
                    class="dropdown-icon text-xs transition-transform duration-300"
                    >▼</span
                  >
                </button>
                <div
                  class="dropdown-options absolute top-full right-0 w-48 bg-[#111] border border-blanco/10 shadow-[0_10px_40px_rgba(0,0,0,0.5)] mt-2 opacity-0 invisible translate-y-2 transition-all duration-300 rounded-xl overflow-hidden max-h-64 overflow-y-auto custom-scroll z-[60]"
                  data-lenis-prevent
                >
                  <div class="flex flex-col py-1 font-mono text-sm">
                    {
                      [
                        ".com",
                        ".net",
                        ".org",
                        ".io",
                        ".ai",
                        ".app",
                        ".dev",
                        ".co",
                        ".us",
                        ".me",
                        ".tv",
                        ".biz",
                        ".info",
                        ".online",
                        ".store",
                        ".site",
                        ".tech",
                        ".design",
                        ".digital",
                        ".agency",
                        ".studio",
                        ".shop",
                        ".services",
                        ".solutions",
                        ".company",
                        ".business",
                        ".marketing",
                        ".consulting",
                        ".management",
                        ".software",
                        ".systems",
                        ".cloud",
                        ".media",
                        ".photography",
                        ".gallery",
                        ".art",
                        ".blog",
                        ".news",
                        ".press",
                        ".restaurant",
                        ".cafe",
                        ".bar",
                        ".fitness",
                        ".health",
                        ".dental",
                        ".doctor",
                        ".lawyer",
                        ".legal",
