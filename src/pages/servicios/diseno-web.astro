<script>
  document.addEventListener("astro:page-load", () => {
    const input = document.getElementById("domain-input") as HTMLInputElement;
    const hiddenInput = document.getElementById(
      "tld-select",
    ) as HTMLInputElement;
    const btn = document.getElementById(
      "check-domain-btn",
    ) as HTMLButtonElement;
    const btnText = document.getElementById(
      "check-btn-text",
    ) as HTMLSpanElement;
    const btnSpinner = document.getElementById(
      "check-btn-spinner",
    ) as HTMLSpanElement;
    const result = document.getElementById("domain-result") as HTMLDivElement;
    const arWarning = document.getElementById("ar-warning") as HTMLDivElement;
    const toggleBtn = document.getElementById(
      "toggle-all-tlds",
    ) as HTMLButtonElement;
    const tldPanel = document.getElementById(
      "all-tlds-panel",
    ) as HTMLDivElement;
    const toggleIcon = document.getElementById(
      "tld-toggle-icon",
    ) as HTMLSpanElement;

    if (!input || !hiddenInput || !btn) return;

    // Custom dropdown logic
    const container = document.querySelector(".custom-dropdown-container");
    if (container) {
      const btnDropdown = container.querySelector(
        ".dropdown-btn",
      ) as HTMLButtonElement;
      const optionsDiv = container.querySelector(
        ".dropdown-options",
      ) as HTMLDivElement;
      const textSpan = container.querySelector(
        ".dropdown-text",
      ) as HTMLSpanElement;
      const iconSpan = container.querySelector(
        ".dropdown-icon",
      ) as HTMLSpanElement;
      const optionBtns = container.querySelectorAll(".dropdown-option");

      const closeDropdown = () => {
        optionsDiv.classList.add("invisible", "opacity-0", "translate-y-2");
        optionsDiv.classList.remove("opacity-100", "translate-y-0");
        btnDropdown.classList.remove("border-rosa");
        iconSpan.style.transform = "rotate(0deg)";
      };

      btnDropdown.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = !optionsDiv.classList.contains("invisible");
        if (!isOpen) {
          optionsDiv.classList.remove(
            "invisible",
            "opacity-0",
            "translate-y-2",
          );
          optionsDiv.classList.add("opacity-100", "translate-y-0");
          btnDropdown.classList.add("border-rosa");
          iconSpan.style.transform = "rotate(180deg)";
        } else {
          closeDropdown();
        }
      });

      optionBtns.forEach((opt) => {
        opt.addEventListener("click", () => {
          const val = opt.getAttribute("data-value") || ".com";
          const isAr = opt.getAttribute("data-ar") === "true";
          hiddenInput.value = val;
          hiddenInput.setAttribute("data-ar", isAr ? "true" : "false");
          textSpan.textContent = val;
          closeDropdown();

          const wrapperWarning = document.getElementById("ar-warning-wrapper");
          const wrapperResult = document.getElementById("domain-result-wrapper");
          if (isAr) {
            btn.disabled = true;
            btn.classList.add("opacity-50", "cursor-not-allowed");
            if (wrapperWarning) wrapperWarning.style.gridTemplateRows = "1fr";
          } else {
            btn.disabled = false;
            btn.classList.remove("opacity-50", "cursor-not-allowed");
            if (wrapperWarning) wrapperWarning.style.gridTemplateRows = "0fr";
          }
          if (wrapperResult) wrapperResult.style.gridTemplateRows = "0fr";
        });
      });

      document.addEventListener("click", (e) => {
        if (!container.contains(e.target as Node)) closeDropdown();
      });
    }

    toggleBtn?.addEventListener("click", () => {
      const wrapper = document.getElementById("all-tlds-wrapper");
      if (!wrapper || !tldPanel) return;
      const isOpen = wrapper.style.gridTemplateRows === "1fr";

      wrapper.style.gridTemplateRows = isOpen ? "0fr" : "1fr";
      if (isOpen) {
        tldPanel.classList.remove("opacity-100");
        tldPanel.classList.add("opacity-0");
      } else {
        tldPanel.classList.remove("opacity-0");
        tldPanel.classList.add("opacity-100");
      }
      toggleIcon.textContent = isOpen ? "+" : "−";
    });

    const checkDomain = async () => {
      const name = input.value.trim().replace(/\s+/g, "").toLowerCase();
      const tld = hiddenInput.value;

      if (!name) {
        input.focus();
        input.classList.add("border-rosa");
        setTimeout(() => input.classList.remove("border-rosa"), 1500);
        return;
      }

      const domain = `${name}${tld}`;
      const wrapperResult = document.getElementById("domain-result-wrapper");

      btnText.textContent = "Verificando";
      btnSpinner.classList.remove("hidden");
      btn.disabled = true;
      if (wrapperResult) wrapperResult.style.gridTemplateRows = "0fr";

      try {
        const res = await fetch(
          `/.netlify/functions/check-domain?domain=${encodeURIComponent(domain)}`,
        );
        const data = await res.json();

        if (data.available === true) {
          result.className =
            "rounded-xl p-4 font-mono text-sm bg-verde/10 border border-verde/30 text-verde";
          result.innerHTML = `✓ <strong>${domain}</strong> está disponible. <a href="https://wa.me/5493513323272?text=Hola%20VEZNER%2C%20quiero%20registrar%20el%20dominio%20${encodeURIComponent(domain)}" target="_blank" class="underline hover:text-blanco transition-colors ml-2">→ Registrarlo con VEZNER</a>`;
        } else if (data.available === false) {
          let extra = "";
          if (data.expiration) {
            const exp = new Date(data.expiration).toLocaleDateString("es-AR");
            extra = `<br><span class="text-blanco/40 text-xs">Vence: ${exp}</span>`;
          }
          result.className =
            "rounded-xl p-4 font-mono text-sm bg-rosa/10 border border-rosa/30 text-rosa";
          result.innerHTML = `✗ <strong>${domain}</strong> ya está registrado.${extra}`;
        } else {
          result.className =
            "rounded-xl p-4 font-mono text-sm bg-blanco/5 border border-blanco/10 text-blanco/50";
          result.innerHTML = `⚠ No se pudo verificar <strong>${domain}</strong>. Puede que este TLD no soporte consultas automáticas.`;
        }
        if (wrapperResult) wrapperResult.style.gridTemplateRows = "1fr";
      } catch {
        result.className =
          "rounded-xl p-4 font-mono text-sm bg-blanco/5 border border-blanco/10 text-blanco/50";
        result.innerHTML = "Error de conexión. Intentá nuevamente.";
        if (wrapperResult) wrapperResult.style.gridTemplateRows = "1fr";
      } finally {
        btnText.textContent = "Verificar";
        btnSpinner.classList.add("hidden");
        btn.disabled = false;
      }
    };

    btn.addEventListener("click", checkDomain);
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") checkDomain();
    });
  });
</script>

