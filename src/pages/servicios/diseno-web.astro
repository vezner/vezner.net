---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Diseño Web — VEZNER"
  description="Diseño de Landing Pages de alta gama para negocios. Optimizadas para conversión, ultrarrápidas y construidas a medida. VEZNER, Córdoba."
>
  <Header />
  
  <main class="bg-blanco min-h-screen overflow-hidden">
    
    
    <section id="hero" class="relative min-h-screen flex flex-col justify-center px-6 md:px-16 pt-32 pb-20">
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute top-[-10%] left-[-10%] w-[40vw] h-[40vw] bg-negro/5 rounded-full blur-[80px] animate-pulse"></div>
        <div class="absolute bottom-[10%] right-[-10%] w-[50vw] h-[50vw] bg-negro/5 rounded-full blur-[100px] animate-pulse" style="animation-delay: 2s;"></div>
      </div>
      <div class="absolute inset-0 pointer-events-none z-0 opacity-10"
           style="background-image: linear-gradient(#000 1px, transparent 1px), linear-gradient(90deg, #000 1px, transparent 1px); background-size: 50px 50px;">
      </div>

      <div class="relative z-10 w-full max-w-7xl mx-auto">
        <div class="hero-reveal flex items-center gap-4 mb-8 opacity-0">
          <div class="w-12 h-px bg-negro/40"></div>
          <span class="font-mono text-xs tracking-[0.4em] uppercase text-negro/50">Servicios / 01</span>
        </div>
        
        <h1 class="font-display text-[clamp(60px,12vw,180px)] leading-none text-negro uppercase mb-12">
          <span class="block overflow-hidden pt-12 -mt-12"><span class="title-line block translate-y-[120%]">Diseño</span></span>
          <span class="block overflow-hidden pt-12 -mt-12"><span class="title-line block translate-y-[120%]">Web</span></span>
        </h1>
        
        <div class="grid md:grid-cols-2 gap-12 md:gap-24 items-end">
          <p class="hero-desc font-mono text-base md:text-lg text-negro/60 leading-relaxed opacity-0 transform translate-y-8 max-w-lg">
            Landing pages estructuradas para vender. Desarrollamos sitios web ultra rápidos y visualmente impactantes, diseñados específicamente para escalar tu negocio y aumentar la conversión. Sin plantillas, puro rendimiento.
          </p>
          
          <div class="hero-stats flex flex-wrap gap-8 md:justify-end opacity-0 transform translate-y-8">
            <div class="border-l border-negro/20 pl-4">
              <p class="font-display text-4xl text-negro">99</p>
              <p class="font-mono text-xs text-negro/40 tracking-widest uppercase">PageSpeed</p>
            </div>
            <div class="border-l border-negro/20 pl-4">
              <p class="font-display text-4xl text-negro">MAX</p>
              <p class="font-mono text-xs text-negro/40 tracking-widest uppercase">Conversión</p>
            </div>
            <div class="border-l border-negro/20 pl-4">
              <p class="font-display text-4xl text-negro">0</p>
              <p class="font-mono text-xs text-negro/40 tracking-widest uppercase">Plantillas</p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="scroll-prompt absolute bottom-10 left-16 flex items-center gap-4 opacity-0">
        <div class="w-px h-12 bg-negro/20 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1/2 bg-negro animate-[scrollPulse_2s_ease-in-out_infinite]"></div>
        </div>
        <span class="font-mono text-xs tracking-widest uppercase text-negro/30">Explorar</span>
      </div>
    </section>

    
    <section id="estandar" class="py-32 bg-negro text-blanco relative overflow-hidden">
      <div class="container mx-auto px-6 md:px-16 max-w-7xl relative z-10">
        
        <div class="grid md:grid-cols-2 gap-20">
          <div class="vs-card opacity-0 translate-y-12 border border-blanco/10 p-10 md:p-16 hover:bg-blanco/5 transition-colors duration-500">
            <span class="font-mono text-xs tracking-widest uppercase text-blanco/30 mb-8 block">El estándar mediocre</span>
            <h3 class="font-display text-5xl mb-6 text-blanco/50">Plantillas & <br/>Código Basura</h3>
            <ul class="space-y-4 font-mono text-sm text-blanco/40">
              <li class="flex gap-4"><span>×</span> Diseños genéricos que no transmiten autoridad.</li>
              <li class="flex gap-4"><span>×</span> Carga extremadamente lenta que mata las ventas.</li>
              <li class="flex gap-4"><span>×</span> Cero enfoque en jerarquía de información.</li>
              <li class="flex gap-4"><span>×</span> UI rota en dispositivos móviles.</li>
            </ul>
          </div>
          
          <div class="vs-card opacity-0 translate-y-12 border border-blanco/30 bg-blanco/5 p-10 md:p-16 relative">
            <div class="absolute top-0 right-0 w-24 h-24 bg-blanco/20 blur-[50px]"></div>
            <span class="font-mono text-xs tracking-widest uppercase text-blanco mb-8 block">El estándar VEZNER</span>
            <h3 class="font-display text-5xl mb-6 text-blanco">Ventas &<br/>Autoridad</h3>
            <ul class="space-y-4 font-mono text-sm text-blanco/70">
              <li class="flex gap-4"><span class="text-blanco">✓</span> Diseño brutalista, interactivo y premium.</li>
              <li class="flex gap-4"><span class="text-blanco">✓</span> Ingeniería Jamstack: carga instantánea.</li>
              <li class="flex gap-4"><span class="text-blanco">✓</span> Copywriting visual: enfocado 100% en conversión.</li>
              <li class="flex gap-4"><span class="text-blanco">✓</span> Animaciones fluidas para retener al usuario.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    
    <section id="enfoque" class="py-32 px-6 md:px-16 bg-blanco">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-20">
          <h2 class="font-display text-6xl md:text-8xl text-negro mb-6 section-title opacity-0 translate-y-10">INGENIERÍA<br/>DE CONVERSIÓN</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-x-12 gap-y-20">
          {[
            { t: 'Stack Moderno', d: 'Construimos sobre Astro y React para garantizar que la web cargue instantáneamente y deslumbre al instante.', i: 'fa-solid fa-bolt' },
            { t: 'UI Dinámica', d: 'Implementamos animaciones fluidas, scroll asíncrono e interacciones precisas mediante GSAP y WebGL.', i: 'fa-solid fa-wand-magic-sparkles' },
            { t: 'SEO Técnico', d: 'Estructura semántica, Schema.org avanzado, optimización de imágenes WebP/AVIF y canonicals perfectos.', i: 'fa-solid fa-magnifying-glass' },
            { t: 'Alta Conversión', d: 'Botones estratégicos (CTAs), jerarquía visual para guiar el ojo y formularios que invitan a la acción.', i: 'fa-solid fa-arrow-trend-up' },
            { t: 'Responsive Puro', d: 'Cero problemas en móvil. Diseñamos con un enfoque mobile-first absoluto, para que se vea premium en cualquier pantalla.', i: 'fa-solid fa-mobile-screen-button' },
            { t: 'Hosting de Borde', d: 'Tu web distribuida en redes globales como Netlify o Vercel. Despliegue automático, CDN global y máxima seguridad.', i: 'fa-solid fa-server' }
          ].map((f, i) => (
            <div class="feat-card opacity-0 border-t border-negro/10 pt-8 transition-colors duration-300">
              <i class={`${f.i} text-3xl text-negro/20 mb-6 block`}></i>
              <h4 class="font-display text-3xl text-negro mb-4">{f.t}</h4>
              <p class="font-mono text-xs text-negro/60 leading-relaxed">{f.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    
    <section id="cta" class="py-32 bg-negro text-blanco text-center relative overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-b from-negro to-[#111]"></div>
      </div>
      
      <div class="relative z-10 max-w-3xl mx-auto px-6">
        <h2 class="font-display text-6xl md:text-8xl mb-8 cta-title">Llevá tu negocio<br/>al siguiente nivel</h2>
        <p class="font-mono text-sm text-blanco/50 mb-12 uppercase tracking-widest cta-desc">Desarrollos desde USD 800</p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 cta-btns">
          <a href="/contacto" class="btn-primary group relative inline-flex items-center gap-3 bg-blanco text-negro px-10 py-5 font-mono text-xs tracking-widest uppercase overflow-hidden border border-transparent">
            <span class="relative z-10">Solicitar Cotización</span>
            <span class="relative z-10 transition-transform duration-300 group-hover:translate-x-1.5">→</span>
            <span class="absolute inset-0 bg-blanco/70 translate-x-[-101%] group-hover:translate-x-0 transition-transform duration-400 ease-out"></span>
          </a>
          <a href="/#servicios" class="btn-secondary group relative inline-flex items-center gap-3 border border-blanco/30 text-blanco px-10 py-5 font-mono text-xs tracking-widest uppercase hover:bg-blanco/10 transition-colors duration-300">
            Ver otros servicios
          </a>
        </div>
      </div>
    </section>

  </main>
  
  <Footer />
</Layout>

<style>
  .btn-primary:hover span:first-child,
  .btn-primary:hover span:nth-child(2) {
    color: #0a0a0a;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  document.addEventListener("astro:page-load", () => {
    gsap.registerPlugin(ScrollTrigger);
  

  const tl = gsap.timeline();
  tl.to('.hero-reveal', { opacity: 1, duration: 1, ease: 'power3.out', delay: 0.2 });
  tl.to('.title-line', { y: '0%', duration: 1.2, stagger: 0.15, ease: 'power4.out' }, '-=0.6');
  tl.to('.hero-desc', { opacity: 1, y: 0, duration: 1, ease: 'power3.out' }, '-=0.8');
  tl.to('.hero-stats', { opacity: 1, y: 0, duration: 1, ease: 'power3.out' }, '-=0.8');
  tl.to('.scroll-prompt', { opacity: 1, duration: 1 }, '-=0.5');


  gsap.utils.toArray('.vs-card').forEach((card, i) => {
    gsap.to(card as HTMLElement, {
      scrollTrigger: { trigger: card as HTMLElement, start: 'top 85%', once: true },
      opacity: 1, y: 0, duration: 1, delay: i * 0.2, ease: 'power3.out'
    });
  });


  gsap.to('.section-title', {
    scrollTrigger: { trigger: '.section-title', start: 'top 85%', once: true },
    opacity: 1, y: 0, duration: 1, ease: 'power4.out'
  });


  gsap.utils.toArray('.feat-card').forEach((feat, i) => {

    gsap.fromTo(feat as HTMLElement, 
      { opacity: 0, y: 50 },
      {
        scrollTrigger: { trigger: feat as HTMLElement, start: 'top 90%', once: true },
        opacity: 1, y: 0, duration: 0.8, delay: (i % 3) * 0.15, ease: 'power3.out'
      }
    );
  });
  });
</script>
