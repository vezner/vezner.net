---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="Software Python — VEZNER"
  description="Automatizaciones, APIs, bots y procesamiento de datos con Python. Código eficiente y escalable para empresas. VEZNER, Córdoba."
>
  <Header theme="dark" />

  <main class="bg-[#0a0a0a] text-blanco min-h-screen overflow-hidden">
    <section
      id="hero"
      class="relative min-h-screen flex flex-col justify-center px-6 md:px-16 pt-32 pb-20"
    >
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div
          class="absolute top-[-10%] right-[-5%] w-[40vw] h-[40vw] bg-verde/10 rounded-full blur-[80px] animate-pulse"
        >
        </div>
        <div
          class="absolute bottom-[10%] left-[-10%] w-[50vw] h-[50vw] bg-azul/10 rounded-full blur-[100px] animate-pulse"
          style="animation-delay: 2s;"
        >
        </div>
      </div>
      <div
        class="absolute inset-0 pointer-events-none z-0 opacity-[0.03]"
        style="background-image: repeating-linear-gradient(0deg, transparent, transparent 2px, #00c851 2px, #00c851 4px); background-size: 100% 4px;"
      >
      </div>

      <div class="relative z-10 w-full max-w-7xl mx-auto">
        <div class="hero-reveal flex items-center gap-4 mb-8 opacity-0">
          <div class="w-12 h-px bg-verde/40"></div>
          <span
            class="font-mono text-xs tracking-[0.4em] uppercase text-verde/50"
            >Servicios / 02</span
          >
        </div>

        <h1
          class="font-display text-[clamp(60px,12vw,180px)] leading-[0.85] text-blanco uppercase overflow-hidden mb-12"
        >
          <span class="block overflow-hidden"
            ><span class="title-line block translate-y-full">Software</span
            ></span
          >
          <span class="block overflow-hidden"
            ><span class="title-line block translate-y-full text-verde"
              >Python</span
            ></span
          >
        </h1>

        <div class="grid md:grid-cols-2 gap-12 md:gap-24 items-end">
          <div class="max-w-lg">
            <p
              class="hero-desc font-mono text-base md:text-lg text-blanco/60 leading-relaxed opacity-0 transform translate-y-8 mb-8"
            >
              Automatizamos tus procesos más tediosos, reducimos el margen de
              error humano y eliminamos cientos de horas operativas mensuales.
              Construimos sistemas a medida para que tu equipo deje de hacer
              tareas repetitivas y se enfoque en generar ingresos reales.
            </p>
            
            <div class="hero-desc opacity-0 transform translate-y-8 flex flex-col sm:flex-row gap-4 mb-6">
              <a href="https://wa.me/5493513323272?text=Hola%20VEZNER,%20necesito%20automatizar%20procesos%20con%20Python" target="_blank" rel="noopener noreferrer" class="group relative inline-flex items-center justify-center gap-3 bg-verde text-negro px-8 py-4 font-mono text-xs tracking-widest uppercase overflow-hidden border-2 border-verde rounded-2xl hover:rounded-none transition-all duration-300 w-full sm:w-auto">
                <span class="relative z-10 flex items-center gap-2"><i class="fa-brands fa-whatsapp text-base"></i> Cotizar por WhatsApp</span>
                <span class="absolute inset-0 bg-blanco translate-x-[-101%] group-hover:translate-x-0 transition-transform duration-300 ease-out z-0"></span>
              </a>
              <a href="#soluciones" class="inline-flex items-center justify-center px-8 py-4 font-mono text-xs tracking-widest uppercase border-2 border-blanco/20 text-blanco rounded-2xl hover:rounded-none hover:border-blanco transition-all duration-300 w-full sm:w-auto">
                Ver Soluciones
              </a>
            </div>
            
            <div class="hero-desc opacity-0 transform translate-y-8 flex items-center gap-4 text-xs font-mono text-blanco/50">
              <span class="flex items-center gap-1.5"><i class="fa-solid fa-check text-verde"></i> Código 100% a medida</span>
              <span class="flex items-center gap-1.5"><i class="fa-solid fa-bolt text-yellow-500"></i> Máximo rendimiento</span>
            </div>
          </div>

          <div
            class="hero-stats flex flex-wrap gap-8 md:justify-end opacity-0 transform translate-y-8"
          >
            <div class="border-l border-verde/20 pl-4">
              <p class="font-display text-4xl text-blanco">Tiempo</p>
              <p
                class="font-mono text-xs text-verde/60 tracking-widest uppercase"
              >
                Ahorro Operativo
              </p>
            </div>
            <div class="border-l border-verde/20 pl-4">
              <p class="font-display text-4xl text-blanco">Datos</p>
              <p
                class="font-mono text-xs text-verde/60 tracking-widest uppercase"
              >
                100% Sincronizados
              </p>
            </div>
            <div class="border-l border-verde/20 pl-4">
              <p class="font-display text-4xl text-blanco">Control</p>
              <p
                class="font-mono text-xs text-verde/60 tracking-widest uppercase"
              >
                Cero Errores
              </p>
            </div>
          </div>
        </div>
      </div>

      <div
        class="scroll-prompt absolute bottom-10 left-16 flex items-center gap-4 opacity-0"
      >
        <div class="w-px h-12 bg-blanco/20 relative overflow-hidden">
          <div
            class="absolute top-0 left-0 w-full h-1/2 bg-verde animate-[scrollPulse_2s_ease-in-out_infinite]"
          >
          </div>
        </div>
        <span class="font-mono text-xs tracking-widest uppercase text-blanco/30"
          >Explorar</span
        >
      </div>
    </section>

    <section
      id="soluciones"
      class="py-32 bg-[#050505] relative overflow-hidden"
    >
      <div class="container mx-auto px-6 md:px-16 max-w-7xl">
        <h2 data-gsap="fade-up"
          class="font-display text-5xl md:text-7xl text-blanco mb-20 section-title opacity-0 translate-y-10 border-l-4 border-verde pl-8"
        >
          SISTEMAS PARA<br />NEGOCIOS REALES
        </h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
          {
            [
              {
                t: "Sistemas de Stock",
                d: "Control de inventario en tiempo real, gestión de proveedores y facturación rápida para distribuidoras y mayoristas.",
                c: "bg-[#111] hover:bg-verde/10 hover:border-verde/30",
              },
              {
                t: "Procesamiento Masivo",
                d: "Automatización de excels, conciliaciones bancarias y reportes pesados para estudios contables y administrativos.",
                c: "bg-[#111] hover:bg-azul/10 hover:border-azul/30",
              },
              {
                t: "Integración WhatsApp",
                d: "Bots que responden consultas frecuentes, confirman turnos y toman pedidos 24/7 sin intervención humana.",
                c: "bg-[#111] hover:bg-rosa/10 hover:border-rosa/30",
              },
              {
                t: "Gestión de Producción",
                d: "Seguimiento de órdenes de trabajo, control de calidad y logística interna adaptada a los flujos de fábricas y talleres.",
                c: "bg-[#111] hover:bg-yellow-400/10 hover:border-yellow-400/30",
              },
            ].map((item, i) => (
              <div
                class={`use-case opacity-0 transform-gpu will-change-transform will-change-[opacity] border border-blanco/5 bg-blanco/[0.03] backdrop-blur-2xl p-8 transition-[background-color,border-color,border-radius,color,box-shadow] duration-300 rounded-2xl hover:rounded-none ${item.c} group`}
              >
                <div class="font-mono text-xs text-blanco/30 mb-6 group-hover:text-blanco transition-colors duration-300">
                  0{i + 1}
                </div>
                <h3 data-gsap="fade-up" class="font-display text-3xl mb-4 text-blanco group-hover:translate-x-2 transition-transform duration-300">{item.t}</h3>
                <p class="font-mono text-xs text-blanco/50 leading-relaxed">
                  {item.d}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="calidad"
      class="py-32 px-6 md:px-16 bg-[#0a0a0a] border-y border-blanco/5 overflow-hidden"
    >
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-20">
          <h2 data-gsap="fade-up"
            class="font-display text-5xl md:text-7xl text-blanco mb-6 term-title opacity-0 translate-y-10 uppercase"
          >
            La ingeniería detrás<br />del sistema
          </h2>
          <p
            class="font-mono text-sm text-blanco/50 max-w-xl mx-auto term-desc opacity-0 translate-y-10"
          >
            Usamos Python, PySide6 y MySQL para construir arquitecturas robustas de bases de datos centralizadas, interfaces de escritorio de carga instantánea y despliegues con Docker.
          </p>
        </div>

        <div
          data-gsap="fade-up" class="term-mockup opacity-0 translate-y-20 bg-[#0d1117] rounded-2xl hover:rounded-none transition-safe duration-300 shadow-2xl overflow-hidden border border-verde/20 transition-colors duration-300"
        >
          <div
            class="flex items-center gap-3 px-6 py-4 bg-[#161b22] border-b border-verde/20"
          >
            <span class="w-3 h-3 rounded-full bg-rosa"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
            <span class="w-3 h-3 rounded-full bg-verde"></span>
            <span class="ml-4 font-mono text-xs text-blanco/40"
              >user@vezner-server: ~/projects/etl_pipeline</span
            >
            <span
              class="ml-auto font-mono text-xs text-verde px-2 py-1 bg-verde/10 rounded"
              >PYTHON 3.13</span
            >
          </div>
          <div
            class="p-6 font-mono text-sm leading-relaxed relative min-h-[400px]"
          >
            <div
              class="absolute inset-0 bg-gradient-to-b from-transparent to-[#0d1117] pointer-events-none z-10 top-1/2"
            >
            </div>
            <div class="code-lines space-y-1 text-blanco/70 relative z-0">
              <div class="text-verde">
                C:\Projects\software_gestion> python main.py
              </div>
              {
                [
                  {
                    t: "[INFO] Initializing PySide6 Application...",
                    c: "text-blanco/40",
                    d: 0.5,
                  },
                  {
                    t: "[OK] UI Assets loaded successfully (42ms).",
                    c: "text-verde",
                    d: 1.2,
                  },
                  {
                    t: "[INFO] Searching for local MySQL node at 192.168.1.10...",
                    c: "text-yellow-400",
                    d: 1.5,
                  },
                  {
                    t: "[OK] Connection to MySQL established. Ping: 2ms.",
                    c: "text-verde",
                    d: 2.5,
                  },
                  {
                    t: "[INFO] Authenticating user from Active Directory...",
                    c: "text-azul",
                    d: 3.0,
                  },
                  {
                    t: "██████████████████████░░░░ 85% Syncing local state",
                    c: "text-blanco/20 animate-pulse",
                    d: 4.5,
                  },
                  {
                    t: "[OK] State synchronized. 1,429 records updated.",
                    c: "text-verde",
                    d: 6.0,
                  },
                  {
                    t: "[INFO] Starting async background workers...",
                    c: "text-blanco/40",
                    d: 7.0,
                  },
                  {
                    t: "[OK] Software ready and running. MainWindow displayed.",
                    c: "text-verde",
                    d: 8.5,
                  },
                  {
                    t: "---------------------------------------------------",
                    c: "text-blanco/20",
                    d: 9.0,
                  },
                  {
                    t: "PIPELINE FINISHED IN 4.28s. ERRORS: 0",
                    c: "text-verde font-bold",
                    d: 9.5,
                  },
                ].map((line) => (
                  <div
                    class={`opacity-0 animate-[fadeIn_0s_forwards] ${line.c}`}
                    style={`animation-delay: ${line.d}s;`}
                  >
                    {line.t}
                  </div>
                ))
              }
              <div class="animate-pulse text-verde mt-2">_</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="proceso" class="py-32 px-6 md:px-16 bg-[#050505]">
      <div class="max-w-7xl mx-auto">
        <h2 data-gsap="fade-up" class="font-display text-4xl md:text-6xl text-blanco mb-16 text-center">NUESTRA METODOLOGÍA</h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {[
            { n: '01', t: 'Auditoría Inicial', d: 'Analizamos tus flujos de trabajo actuales e identificamos los cuellos de botella exactos a sistematizar.' },
            { n: '02', t: 'Prototipado UI', d: 'Diseñamos la interfaz gráfica en PySide6 para que veas cómo lucirá el sistema antes de escribir la lógica.' },
            { n: '03', t: 'Desarrollo Core', d: 'Conectamos bases de datos, APIs y escribimos todo el código asíncrono y optimizado.' },
            { n: '04', t: 'Despliegue & Capacitación', d: 'Instalamos el sistema en tu red local (LAN) y capacitamos a tu equipo para usarlo.' },
          ].map((item, i) => (
            <div class="process-step opacity-0 translate-y-12">
              <div class="font-display text-6xl text-verde/20 mb-4">{item.n}</div>
              <h4 class="font-mono text-lg font-bold mb-3">{item.t}</h4>
              <p class="font-mono text-xs text-blanco/50 leading-relaxed">{item.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="stack" class="py-32 px-6 md:px-16 bg-[#0a0a0a]">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-20">
          <h2 data-gsap="fade-up" class="font-display text-5xl md:text-7xl text-blanco mb-6 stack-title opacity-0">
            EL STACK TECNOLÓGICO
          </h2>
        </div>
        <div class="grid md:grid-cols-3 gap-x-12 gap-y-12">
          {
            [
              {
                t: "Tipado Estricto",
                d: "Mypy y TypeHints en el 100% del código. Prevenimos bugs en tiempo de escritura antes de que lleguen a producción.",
                i: "fa-solid fa-shield-halved",
              },
              {
                t: "Arquitectura Limpia",
                d: "Principios SOLID, inyección de dependencias y patrones de diseño (Repository, Factory) para mantener el código sano.",
                i: "fa-solid fa-sitemap",
              },
              {
                t: "Rendimiento Extremo",
                d: "Uso de asyncio, uvloop y multiprocesamiento cuando un solo hilo no es suficiente para la carga.",
                i: "fa-solid fa-gauge-high",
              },
              {
                t: "Dockerización",
                d: "Entornos reproducibles. Si corre en nuestra máquina, va a correr igual en tu servidor VPS o en AWS.",
                i: "fa-brands fa-docker",
              },
              {
                t: "CI / CD Pipeline",
                d: "Testing automático con Pytest y despliegue sin downtime a través de GitHub Actions.",
                i: "fa-solid fa-rotate",
              },
              {
                t: "Monitoreo 24/7",
                d: "Integración con Sentry y Prometheus para capturar cualquier excepción milisegundos después de que ocurra.",
                i: "fa-solid fa-heart-pulse",
              },
            ].map((f, i) => (
              <div class="feat-card opacity-0 transform-gpu will-change-transform will-change-[opacity] border-t-2 border-blanco/10 bg-blanco/[0.03] backdrop-blur-2xl pt-8 transition-[background-color,border-color,border-radius,color,box-shadow] duration-300 rounded-2xl hover:rounded-none hover:border-verde group hover:bg-blanco/[0.02] px-4 -mx-4 pb-4">
                <i class={`${f.i} text-3xl text-verde/50 group-hover:text-verde group-hover:-translate-y-2 transition-all duration-300 mb-6 block drop-shadow-sm group-hover:drop-shadow-md`} />
                <h4 class="font-display text-3xl text-blanco mb-4 group-hover:translate-x-1 transition-transform duration-300">{f.t}</h4>
                <p class="font-mono text-xs text-blanco/60 leading-relaxed">
                  {f.d}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="cta"
      class="py-32 bg-verde text-negro text-center relative overflow-hidden"
    >
      <div
        class="absolute inset-0 z-0 opacity-20"
        style="background-image: repeating-linear-gradient(45deg, #000 0, #000 1px, transparent 0, transparent 50%); background-size: 10px 10px;"
      >
      </div>

      <div class="relative z-10 max-w-3xl mx-auto px-6">
        <h2 data-gsap="fade-up" class="font-display text-6xl md:text-8xl mb-8 cta-title rounded-2xl hover:rounded-none transition-safe duration-300">
          Automatizá lo<br />aburrido
        </h2>
        <p
          class="font-mono text-sm text-negro/70 mb-12 uppercase tracking-widest cta-desc rounded-2xl hover:rounded-none transition-safe duration-300"
        >
          Consultoría y desarrollo a medida
        </p>

        <div
          class="flex flex-col sm:flex-row items-center justify-center gap-6 cta-btns rounded-2xl hover:rounded-none transition-safe duration-300 transition-colors duration-300"
        >
          <a
            href="#contacto-servicio"
            class="btn-primary group relative inline-flex items-center gap-3 bg-negro text-blanco px-10 py-5 font-mono text-xs tracking-widest uppercase overflow-hidden border border-transparent rounded-2xl hover:rounded-none transition-safe duration-300 transition-colors duration-300"
          >
            <span class="relative z-10">Iniciar Proyecto</span>
            <span
              class="relative z-10 transition-transform duration-300 group-hover:translate-x-1.5"
              >→</span
            >
            <span
              class="absolute inset-0 bg-blanco translate-x-[-101%] group-hover:translate-x-0 transition-transform duration-300 ease-out"
            ></span>
          </a>
          <a
            class="btn-secondary group relative inline-flex items-center gap-3 border border-negro/30 text-negro px-10 py-5 font-mono text-xs tracking-widest uppercase hover:bg-negro/10 transition-safe duration-300 rounded-2xl hover:rounded-none transition-colors duration-300"
          >
            Ver otros servicios
          </a>
          </div>
        </div>
      </section>

      
      <section id="contacto-servicio" class="py-32 px-6 md:px-16 bg-[#0a0a0a] border-t border-blanco/5 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="mb-16">
            <div class="flex items-center gap-4 mb-8">
              <div class="w-8 h-px bg-verde/30"></div>
              <span class="font-mono font-medium text-xs tracking-[0.35em] uppercase text-blanco/60">§ Comenzar</span>
            </div>
            <h2 class="font-display text-5xl md:text-7xl text-blanco mb-6 uppercase">Tu proyecto.</h2>
            <p class="font-mono text-sm text-blanco/50 max-w-lg">Completá los datos y te enviamos una propuesta formal en menos de 24 horas hábiles.</p>
          </div>

          <form id="service-contact-form" class="space-y-12" autocomplete="off">
            <input type="hidden" name="servicio" value="Software Python" />
            
            
            <div class="space-y-6">
              <h3 class="font-mono font-medium text-xs tracking-widest uppercase text-verde mb-8 border-b border-blanco/10 pb-4">1. Sobre el Proyecto</h3>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="form-group">
                  <label class="font-mono font-medium text-xs tracking-widest uppercase text-blanco/60 block mb-2">Área a sistematizar</label>
                  <input type="text" name="py_area" required placeholder="Ej: Facturación, Ventas, Red Local..." class="w-full bg-transparent border-b border-blanco/20 py-3 font-mono text-sm text-blanco placeholder:text-blanco/20 focus:outline-none focus:border-verde transition-colors" />
                </div>
                <div class="form-group">
                  <label class="font-mono font-medium text-xs tracking-widest uppercase text-blanco/60 block mb-2">Cantidad de Usuarios/PCs</label>
                  <input type="number" name="py_usuarios" required placeholder="Ej: 5 PCs conectadas en red" class="w-full bg-transparent border-b border-blanco/20 py-3 font-mono text-sm text-blanco placeholder:text-blanco/20 focus:outline-none focus:border-verde transition-colors" />
                </div>
              </div>
              
              <div class="form-group">
                <label class="font-mono font-medium text-xs tracking-widest uppercase text-blanco/60 block mb-2">¿Con qué sistemas debe integrarse?</label>
                <input type="text" name="py_integracion" required placeholder="Ej: API de Mercadopago, Excel, Lector de código de barras..." class="w-full bg-transparent border-b border-blanco/20 py-3 font-mono text-sm text-blanco placeholder:text-blanco/20 focus:outline-none focus:border-verde transition-colors" />
              </div>
              
              <div class="form-group">
                <label class="font-mono font-medium text-xs tracking-widest uppercase text-blanco/60 block mb-2">Describí el flujo exacto que buscás resolver</label>
                <textarea name="py_problema" rows="3" required placeholder="Paso 1: Entra un pedido, Paso 2: El sistema imprime ticket..." class="w-full bg-transparent border-b border-blanco/20 py-3 font-mono text-sm text-blanco placeholder:text-blanco/20 focus:outline-none focus:border-verde transition-colors resize-none"></textarea>
              </div>
            </div>

            
            <div class="space-y-6 pt-8">
              <h3 class="font-mono font-medium text-xs tracking-widest uppercase text-verde mb-8 border-b border-blanco/10 pb-4">2. Tus Datos</h3>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="form-group">
                  <label class="font-mono font-medium text-xs tracking-widest uppercase text-blanco/60 block mb-2">Nombre</label>
                  <input type="text" name="nombre" required placeholder="Tu nombre completo" class="w-full bg-transparent border-b border-blanco/20 py-3 font-mono text-sm text-blanco placeholder:text-blanco/20 focus:outline-none focus:border-verde transition-colors" />
                </div>
                <div class="form-group">
                  <label class="font-mono font-medium text-xs tracking-widest uppercase text-blanco/60 block mb-2">Empresa / Marca</label>
                  <input type="text" name="empresa" placeholder="Opcional" class="w-full bg-transparent border-b border-blanco/20 py-3 font-mono text-sm text-blanco placeholder:text-blanco/20 focus:outline-none focus:border-verde transition-colors" />
                </div>
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="form-group">
                  <label class="font-mono font-medium text-xs tracking-widest uppercase text-blanco/60 block mb-2">Email</label>
                  <input type="email" name="email" required placeholder="tu@empresa.com" class="w-full bg-transparent border-b border-blanco/20 py-3 font-mono text-sm text-blanco placeholder:text-blanco/20 focus:outline-none focus:border-verde transition-colors" />
                </div>
                <div class="form-group">
                  <label class="font-mono font-medium text-xs tracking-widest uppercase text-blanco/60 block mb-2">Teléfono / WhatsApp</label>
                  <input type="tel" name="telefono" placeholder="Opcional" class="w-full bg-transparent border-b border-blanco/20 py-3 font-mono text-sm text-blanco placeholder:text-blanco/20 focus:outline-none focus:border-verde transition-colors" />
                </div>
              </div>
              
              <div class="mt-8 mb-6">
                <label class="group flex items-center gap-4 cursor-pointer relative">
                  <input type="checkbox" name="acepta_legales" required class="peer sr-only" />
                  <div class="w-5 h-5 rounded border border-blanco/30 bg-transparent flex items-center justify-center transition-colors peer-checked:border-verde group-hover:border-verde shrink-0 relative overflow-hidden peer-checked:[&>div]:scale-100 peer-checked:[&>div]:opacity-100 peer-checked:[&>svg]:scale-100 peer-checked:[&>svg]:opacity-100">
                    <div class="absolute inset-0 bg-verde scale-0 opacity-0 transition-transform duration-300 ease-out rounded-sm"></div>
                    <svg class="relative z-10 w-3 h-3 text-negro opacity-0 scale-50 transition-all duration-300 delay-75" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4"><path stroke-linecap="square" stroke-linejoin="miter" d="M4 12l4 4L19 6"></path></svg>
                  </div>
                  <span class="font-mono text-sm text-blanco/50 leading-snug select-none">
                    He leído y acepto los <a href="/legal/terminos-y-condiciones" target="_blank" class="text-blanco underline decoration-blanco/30 underline-offset-4 hover:decoration-blanco transition-colors">Términos y Condiciones</a> y la <a href="/legal/politica-de-privacidad" target="_blank" class="text-blanco underline decoration-blanco/30 underline-offset-4 hover:decoration-blanco transition-colors">Política de Privacidad</a>.
                  </span>
                </label>
              </div>
            </div>

            <div class="pt-8">
              <button type="submit" id="submit-btn" class="group inline-flex items-center justify-center gap-3 bg-verde text-negro px-10 py-4 font-mono font-medium text-xs tracking-widest uppercase relative overflow-hidden border border-transparent rounded-2xl hover:rounded-none transition-all duration-300">
                <span class="relative z-10 group-hover:text-blanco transition-colors duration-300">Enviar consulta</span>
                <span class="relative z-10 group-hover:translate-x-1 group-hover:text-blanco transition-transform duration-300">→</span>
                <div class="absolute inset-0 bg-negro border border-verde translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></div>
              </button>
            </div>

            <div id="form-success" class="hidden font-mono font-medium text-sm text-[#00c851] bg-[#00c851]/10 border border-[#00c851]/30 px-6 py-4 rounded-2xl shadow-lg mt-8 text-center">
              ✓ Mensaje enviado con éxito. En breve será contactado de regreso.
            </div>
          </form>
        </div>
      </section>

    </main>

  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";

  document.addEventListener("astro:page-load", () => {
    let geoData: any = { ip: "Calculando...", country: "Desconocido", city: "Desconocida", organization: "Desconocido" };
    fetch("https://ipv4.geojs.io/v1/ip/geo.json").then((res) => res.json()).then((geo) => { geoData = geo; }).catch(() => {});

    const form = document.getElementById("service-contact-form") as HTMLFormElement;
    const success = document.getElementById("form-success");

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = document.getElementById("submit-btn") as HTMLButtonElement;
      const btnText = btn?.querySelector("span.relative") as HTMLSpanElement;

      if (btn && btnText) {
        btnText.textContent = "Enviando...";
        btn.disabled = true;
      }

      try {
        const formData = new FormData(form);
        formData.append("Origen_Visita", document.referrer || "Directo / Desconocido");
        formData.append("IP_Cliente", geoData.ip);
        formData.append("Ubicacion", `${geoData.city}, ${geoData.country}`);
        formData.append("Proveedor_Internet", geoData.organization_name || geoData.organization || "Desconocido");
        formData.append("Sistema_Operativo", navigator.platform);

        const response = await fetch("https://formspree.io/f/mdarbbdy", {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          form.reset();
          if (btn && btnText) btnText.textContent = "✓ Enviado";
          success?.classList.remove("hidden");
          gsap.fromTo(success, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.5 });
        } else {
          throw new Error("Error");
        }
      } catch (error) {
        if (btn && btnText) {
          btnText.textContent = "Enviar consulta";
          btn.disabled = false;
        }
        alert("Hubo un error al enviar tu consulta. Por favor, intentá nuevamente más tarde.");
      }
    });
  });
</script>

<style>
  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  .btn-primary:hover span:first-child,
  .btn-primary:hover span:nth-child(2) {
    color: #0a0a0a;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  document.addEventListener("astro:page-load", () => {
    gsap.registerPlugin(ScrollTrigger);

    const tl = gsap.timeline();
    tl.to(".hero-reveal", {
      opacity: 1,
      duration: 1,
      ease: "power3.out",
      delay: 0.2,
    });
    tl.to(
      ".title-line",
      { y: "0%", duration: 1.2, stagger: 0.15, ease: "power4.out" },
      "-=0.6",
    );
    tl.to(
      ".hero-desc",
      { opacity: 1, y: 0, duration: 1, ease: "power3.out" },
      "-=0.8",
    );
    tl.to(
      ".hero-stats",
      { opacity: 1, y: 0, duration: 1, ease: "power3.out" },
      "-=0.8",
    );
    tl.to(".scroll-prompt", { opacity: 1, duration: 1 }, "-=0.5");

    gsap.to(".section-title", {
      scrollTrigger: {
        trigger: ".section-title",
        start: "top 85%",
        once: true,
      },
      opacity: 1,
      y: 0,
      duration: 1,
      ease: "power4.out",
    });
    gsap.utils.toArray(".use-case").forEach((card, i) => {
      gsap.fromTo(
        card as HTMLElement,
        { opacity: 0, y: 50 },
        {
          scrollTrigger: {
            trigger: card as HTMLElement,
            start: "top 85%",
            once: true,
          },
          opacity: 1,
          y: 0,
          duration: 0.8,
          delay: i * 0.15,
          ease: "power3.out",
        },
      );
    });

    gsap.utils.toArray('.process-step').forEach((step, i) => {
      gsap.to(step as HTMLElement, {
        scrollTrigger: { trigger: (step as HTMLElement).parentElement, start: 'top 85%', once: true },
        opacity: 1, y: 0, duration: 0.8, delay: i * 0.15, ease: 'power3.out'
      });
    });

    gsap.to(".term-title", {
      scrollTrigger: { trigger: ".term-title", start: "top 85%", once: true },
      opacity: 1,
      y: 0,
      duration: 1,
      ease: "power4.out",
    });
    gsap.to(".term-desc", {
      scrollTrigger: { trigger: ".term-title", start: "top 85%", once: true },
      opacity: 1,
      y: 0,
      duration: 1,
      delay: 0.2,
      ease: "power3.out",
    });

    gsap.to(".stack-title", {
      scrollTrigger: { trigger: ".stack-title", start: "top 85%", once: true },
      opacity: 1,
      y: 0,
      duration: 1,
      ease: "power4.out",
    });

    ScrollTrigger.create({
      trigger: ".term-mockup",
      start: "top 70%",
      once: true,
      onEnter: () => {
        gsap.to(".term-mockup", {
          opacity: 1,
          y: 0,
          duration: 1.2,
          ease: "power3.out",
        });
      },
    });

    gsap.utils.toArray(".feat-card").forEach((feat, i) => {
      gsap.fromTo(
        feat as HTMLElement,
        { opacity: 0, y: 50 },
        {
          scrollTrigger: {
            trigger: feat as HTMLElement,
            start: "top 90%",
            once: true,
          },
          opacity: 1,
          y: 0,
          duration: 0.8,
          delay: (i % 3) * 0.15,
          ease: "power3.out",
        },
      );
    });
  });
</script>


